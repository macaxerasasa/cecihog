	{ id = "premium", name = "Copão premium", icon = "🏆", price = 45, prep = 4.5, station = "estacao_premium", level = 14, visual = "copao", color = Color3.fromRGB(200, 60, 255) },
}

-- Equipe
Config.Staff = {
	{
		id = "garcom",
		name = "Garçom",
