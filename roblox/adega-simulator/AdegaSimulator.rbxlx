	<Item class="ReplicatedStorage" referent="RBX00000007">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX00000006">
			<Properties>
				<string name="Name">AdegaShared</string>
