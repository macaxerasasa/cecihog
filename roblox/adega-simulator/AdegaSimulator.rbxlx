	{ id = "azul", name = "Azul petróleo", price = 300, color = Color3.fromRGB(24, 74, 96) },
	{ id = "preto", name = "Preto fosco", price = 600, color = Color3.fromRGB(28, 28, 32) },
	{ id = "rosa", name = "Rosa neon", price = 900, color = Color3.fromRGB(230, 60, 150) },
	{ id = "roxo", name = "Roxo noturno", price = 900, color = Color3.fromRGB(80, 40, 140) },
}

-- Missões: aparecem uma de cada vez, em ordem, e pagam uma recompensa.
-- "event" é o que o servidor conta; "target" é quantas vezes.
Config.Quests = {
	{ id = "q1", text = "Anote o pedido de uma mesa", event = "takeOrder", target = 1, reward = 50 },
	{ id = "q2", text = "Prepare uma bebida na geladeira", event = "prepare", target = 1, reward = 50 },
	{ id = "q3", text = "Entregue um pedido na mesa", event = "deliver", target = 1, reward = 80 },
	{ id = "q4", text = "Pegue o dinheiro deixado na mesa", event = "collect", target = 1, reward = 80 },
	{ id = "q5", text = "Limpe uma mesa suja", event = "clean", target = 1, reward = 80 },
	{ id = "q6", text = "Coloque uma mesa nova com cadeiras viradas para ela", event = "placeSeating", target = 1, reward = 150 },
	{ id = "q7", text = "Contrate um garçom", event = "hire_garcom", target = 1, reward = 250 },
	{ id = "q8", text = "Coloque uma Prateleira de destilados", event = "place_prateleira_destilados", target = 1, reward = 300 },
	{ id = "q9", text = "Atenda 25 clientes", event = "served", target = 25, reward = 450 },
	{ id = "q10", text = "Contrate um bartender", event = "hire_bartender", target = 1, reward = 600 },
	{ id = "q11", text = "Personalize o visual de um funcionário", event = "customize", target = 1, reward = 300 },
	{ id = "q11b", text = "Mude o piso ou a cor das paredes", event = "style", target = 1, reward = 400 },
	{ id = "q12", text = "Coloque uma Estação do copão", event = "place_estacao_copao", target = 1, reward = 1000 },
	{ id = "q13", text = "Chegue a 4 estrelas de avaliação", event = "rating4", target = 1, reward = 1200 },
	{ id = "q14", text = "Expanda o terreno da adega", event = "expand", target = 1, reward = 2500 },
	{ id = "q15", text = "Atenda 250 clientes", event = "served", target = 250, reward = 4000 },
	{ id = "q16", text = "Tenha 8 funcionários", event = "staffCount8", target = 1, reward = 6000 },
	{ id = "q17", text = "Chegue ao nível 15", event = "level15", target = 1, reward = 10000 },
	{ id = "q18", text = "Atenda 1.000 clientes", event = "served", target = 1000, reward = 25000 },
}

-- Comentários das avaliações, por número de estrelas.
Config.Reviews = {
	[5] = {
		"Melhor adega da quebrada!",
		"Copão no capricho e atendimento nota 10.",
		"Ambiente top, volto toda sexta!",
		"Cerveja trincando de gelada. Perfeito.",
		"Atendimento rápido demais, amei.",
		"Que lugar lindo à noite! Recomendo.",
	},
	[4] = {
		"Muito bom, só demorou um pouquinho.",
		"Gostei bastante, preço justo.",
		"Lugar animado, voltarei.",
		"Bebida boa, atendimento ok.",
	},
	[3] = {
		"Normal. Dava pra ser mais rápido.",
		"Ok, mas o ambiente podia ser melhor.",
		"Nada demais, mas também nada de errado.",
	},
	[2] = {
		"Esperei muito pra ser atendido.",
		"A bebida chegou quente…",
		"Mesa suja e demora. Hmm.",
	},
	[1] = {
		"Ninguém veio anotar meu pedido!",
		"Fui embora sem beber nada.",
		"Pior atendimento que já vi.",
	},
}

function Config.productById(id)
	for _, product in Config.Products do
		if product.id == id then
			return product
		end
	end
	return nil
end

function Config.staffById(id)
	for _, role in Config.Staff do
		if role.id == id then
			return role
		end
	end
	return nil
end

function Config.findById(list, id)
	for _, entry in list do
		if entry.id == id then
			return entry
		end
	end
	return nil
end

return Config
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000003">
				<Properties>
					<string name="Name">Looks</string>
					<ProtectedString name="Source"><![CDATA[-- Looks: aparência dos bonecos (clientes e funcionários).
-- Uma aparência é guardada só com números e nomes, para caber no salvamento:
-- { skin = 1..#Skins, shirt = 1..#Colors, pants = 1..#Colors, shoes = 1..#Colors, hair = id do estilo, hairColor = 1..#HairColors }
-- O mesmo código pinta o boneco no servidor e na prévia da tela de personalização.

local Looks = {}

local rgb = Color3.fromRGB

Looks.Skins = {
	rgb(255, 224, 196), rgb(242, 200, 160), rgb(224, 172, 128), rgb(198, 140, 92),
	rgb(160, 104, 64), rgb(124, 78, 48), rgb(92, 58, 36), rgb(66, 42, 28),
}

Looks.Colors = {
	rgb(245, 245, 245), rgb(30, 30, 34), rgb(120, 120, 128), rgb(214, 48, 49),
	rgb(255, 127, 80), rgb(253, 203, 110), rgb(0, 148, 50), rgb(85, 239, 196),
	rgb(9, 132, 227), rgb(29, 53, 87), rgb(108, 92, 231), rgb(232, 67, 147),
	rgb(116, 76, 46), rgb(196, 160, 112), rgb(112, 26, 44), rgb(0, 98, 102),
}

Looks.HairColors = {
	rgb(24, 18, 14), rgb(66, 40, 22), rgb(120, 72, 36), rgb(196, 150, 84),
	rgb(236, 206, 150), rgb(160, 50, 30), rgb(150, 150, 156), rgb(240, 240, 240),
	rgb(214, 48, 49), rgb(9, 132, 227), rgb(232, 67, 147), rgb(253, 203, 110),
}

Looks.Hairs = {
	{ id = "careca", name = "Careca" },
	{ id = "curto", name = "Curto" },
	{ id = "longo", name = "Longo" },
	{ id = "coque", name = "Coque" },
	{ id = "afro", name = "Black power" },
	{ id = "trancas", name = "Tranças" },
	{ id = "bone", name = "Boné" },
	{ id = "bone_tras", name = "Boné pra trás" },
	{ id = "gorro", name = "Gorro" },
	{ id = "chef", name = "Touca de chef" },
	{ id = "fone", name = "Fone de DJ" },
}

local HAIR_BY_ID = {}
for index, hair in Looks.Hairs do
	HAIR_BY_ID[hair.id] = index
end

-- Partes do avatar R15 por grupo de cor.
local SHIRT = { UpperTorso = true, LeftUpperArm = true, RightUpperArm = true, Manga = true }
local PANTS = { LowerTorso = true, LeftUpperLeg = true, LeftLowerLeg = true, RightUpperLeg = true, RightLowerLeg = true, LeftLeg = true, RightLeg = true }
local SHOES = { LeftFoot = true, RightFoot = true }
local SKIN = { Head = true, LeftLowerArm = true, RightLowerArm = true, LeftHand = true, RightHand = true, LeftArm = true, RightArm = true }

local function clampIndex(value, list, default)
	if type(value) ~= "number" then
		return default
	end
	return math.clamp(math.floor(value), 1, #list)
end

-- Garante que uma aparência vinda de fora (salvamento, cliente) é válida.
function Looks.sanitize(look, defaults)
	look = if type(look) == "table" then look else {}
	defaults = defaults or {}
	return {
		skin = clampIndex(look.skin, Looks.Skins, defaults.skin or 2),
		shirt = clampIndex(look.shirt, Looks.Colors, defaults.shirt or 1),
		pants = clampIndex(look.pants, Looks.Colors, defaults.pants or 2),
		shoes = clampIndex(look.shoes, Looks.Colors, defaults.shoes or 2),
		hair = if type(look.hair) == "string" and HAIR_BY_ID[look.hair] then look.hair else (defaults.hair or "curto"),
		hairColor = clampIndex(look.hairColor, Looks.HairColors, defaults.hairColor or 1),
	}
end

function Looks.random(random)
	random = random or Random.new()
	local hairs = { "curto", "curto", "longo", "longo", "coque", "afro", "trancas", "bone", "bone_tras", "gorro", "careca" }
	return {
		skin = random:NextInteger(1, #Looks.Skins),
		shirt = random:NextInteger(1, #Looks.Colors),
		pants = ({ 2, 3, 10, 13, 14, 1, 9 })[random:NextInteger(1, 7)],
		shoes = ({ 1, 2, 3, 13 })[random:NextInteger(1, 4)],
		hair = hairs[random:NextInteger(1, #hairs)],
		hairColor = random:NextInteger(1, 6),
	}
end

-- Tamanho visível da cabeça (a cabeça clássica é uma peça 2x1x1 com malha).
local function headSize(head)
	if head:IsA("MeshPart") then
		return head.Size
	end
	local mesh = head:FindFirstChildOfClass("SpecialMesh")
	if mesh and mesh.MeshType == Enum.MeshType.Head then
		local s = mesh.Scale.X / 1.25
		return Vector3.new(1.2 * s, 1.2 * s, 1.2 * s)
	end
	return Vector3.new(math.min(head.Size.X, head.Size.Z), head.Size.Y, math.min(head.Size.X, head.Size.Z))
end

local function accessory(folder, head, name, size, offset, color, shape, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if shape == "ellipsoid" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	elseif shape == "cylinder" then
		part.Shape = Enum.PartType.Cylinder
	end
	part.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function buildHair(folder, head, style, color, shirtColor)
	local s = headSize(head)
	local w, h = s.X, s.Y
	local up = CFrame.Angles(0, 0, math.rad(90))
	if style == "curto" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.1, h * 0.72, w * 1.14), CFrame.new(0, h * 0.22, w * 0.05), color, "ellipsoid")
	elseif style == "longo" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.12, h * 0.74, w * 1.16), CFrame.new(0, h * 0.22, w * 0.05), color, "ellipsoid")
		accessory(folder, head, "CabeloTras", Vector3.new(w * 1.02, h * 1.45, w * 0.5), CFrame.new(0, -h * 0.28, w * 0.36), color, "ellipsoid")
	elseif style == "coque" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.1, h * 0.7, w * 1.14), CFrame.new(0, h * 0.22, w * 0.05), color, "ellipsoid")
		accessory(folder, head, "Coque", Vector3.new(w * 0.5, w * 0.5, w * 0.5), CFrame.new(0, h * 0.6, w * 0.3), color, "ellipsoid")
	elseif style == "afro" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.6, h * 1.25, w * 1.55), CFrame.new(0, h * 0.32, w * 0.12), color, "ellipsoid", Enum.Material.Fabric)
	elseif style == "trancas" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.08, h * 0.66, w * 1.1), CFrame.new(0, h * 0.24, w * 0.05), color, "ellipsoid")
		for _, x in { -0.28, 0, 0.28 } do
			accessory(folder, head, "Tranca", Vector3.new(w * 0.2, h * 1.1, w * 0.2), CFrame.new(x * w, -h * 0.25, w * 0.46), color, "ellipsoid")
		end
	elseif style == "bone" or style == "bone_tras" then
		local back = style == "bone_tras"
		accessory(folder, head, "Bone", Vector3.new(w * 1.1, h * 0.62, w * 1.12), CFrame.new(0, h * 0.28, 0), shirtColor, "ellipsoid")
		local brimZ = if back then w * 0.55 else -w * 0.55
		accessory(folder, head, "Aba", Vector3.new(0.08, w * 0.85, w * 0.85), CFrame.new(0, h * 0.2, brimZ) * up, shirtColor, "cylinder")
	elseif style == "gorro" then
		accessory(folder, head, "Gorro", Vector3.new(w * 1.12, h * 0.85, w * 1.14), CFrame.new(0, h * 0.3, 0.02), shirtColor, "ellipsoid", Enum.Material.Fabric)
		accessory(folder, head, "Barra", Vector3.new(h * 0.18, w * 1.16, w * 1.16), CFrame.new(0, h * 0.08, 0.02) * up, shirtColor, "cylinder", Enum.Material.Fabric)
	elseif style == "chef" then
		accessory(folder, head, "Touca", Vector3.new(h * 0.65, w * 0.98, w * 0.98), CFrame.new(0, h * 0.62, 0) * up, rgb(250, 250, 250), "cylinder")
		accessory(folder, head, "TopoTouca", Vector3.new(w * 1.2, h * 0.55, w * 1.2), CFrame.new(0, h * 0.95, 0), rgb(250, 250, 250), "ellipsoid")
	elseif style == "fone" then
		accessory(folder, head, "Cabelo", Vector3.new(w * 1.1, h * 0.7, w * 1.14), CFrame.new(0, h * 0.22, w * 0.05), color, "ellipsoid")
		accessory(folder, head, "Arco", Vector3.new(w * 1.25, 0.14, 0.22), CFrame.new(0, h * 0.58, 0), rgb(25, 25, 28))
		for _, x in { -1, 1 } do
			accessory(folder, head, "Concha", Vector3.new(0.22, w * 0.5, w * 0.5), CFrame.new(x * w * 0.56, 0.02, 0), rgb(25, 25, 28), "cylinder")
			accessory(folder, head, "LuzFone", Vector3.new(0.05, w * 0.32, w * 0.32), CFrame.new(x * w * 0.68, 0.02, 0), shirtColor, "cylinder", Enum.Material.Neon)
		end
	end
end

-- Pinta o boneco e refaz cabelo/chapéu. Funciona no avatar R15 e no boneco de blocos.
function Looks.apply(model, look)
	look = Looks.sanitize(look)
	local skin = Looks.Skins[look.skin]
	local shirt = Looks.Colors[look.shirt]
	local pants = Looks.Colors[look.pants]
	local shoes = Looks.Colors[look.shoes]
	local blocky = model:GetAttribute("Blocos") == true
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Parent == model then
			local name = part.Name
			if name == "HumanoidRootPart" then
				if blocky then
					part.Color = shirt
				end
			elseif SHIRT[name] then
				part.Color = shirt
			elseif PANTS[name] then
				part.Color = pants
			elseif SHOES[name] then
				part.Color = shoes
			elseif SKIN[name] then
				part.Color = skin
			end
		end
	end
	local old = model:FindFirstChild("Acessorios")
	if old then
		old:Destroy()
	end
	local head = model:FindFirstChild("Head")
	if head then
		local folder = Instance.new("Folder")
		folder.Name = "Acessorios"
		folder.Parent = model
		buildHair(folder, head, look.hair, Looks.HairColors[look.hairColor], shirt)
	end
end

return Looks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000004">
				<Properties>
					<string name="Name">Models</string>
					<ProtectedString name="Source"><![CDATA[-- Models: bebidas e comidas do cardápio em 3D e a bandeja.
-- Usado no servidor (mão dos bonecos, balcão) e na interface (ícones 3D).

local Models = {}

local rgb = Color3.fromRGB
local v = Vector3.new
local M = Enum.Material

local function part(model, primary, size, offset, color, material, props)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			p[key] = value
		end
	end
	if primary then
		p.CFrame = primary.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = primary
		weld.Part1 = p
		weld.Parent = p
	else
		p.CFrame = offset
	end
	p.Parent = model
	return p
end

local CYLINDER = { Shape = Enum.PartType.Cylinder }
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

-- Desenha um produto do cardápio. O ponto de apoio (PrimaryPart) fica na base.
function Models.product(product, cframe)
	local model = Instance.new("Model")
	model.Name = product.id
	local base = part(model, nil, v(0.5, 0.05, 0.5), cframe, product.color, M.SmoothPlastic, { Transparency = 1 })
	model.PrimaryPart = base
	local kind = product.visual
	if kind == "lata" then
		part(model, base, v(0.75, 0.42, 0.42), CFrame.new(0, 0.4, 0) * UPRIGHT, product.color, M.Metal, CYLINDER)
		part(model, base, v(0.05, 0.36, 0.36), CFrame.new(0, 0.79, 0) * UPRIGHT, rgb(200, 200, 205), M.Metal, CYLINDER)
	elseif kind == "garrafa" then
		part(model, base, v(0.8, 0.38, 0.38), CFrame.new(0, 0.42, 0) * UPRIGHT, product.color, M.Glass, CYLINDER)
		part(model, base, v(0.45, 0.16, 0.16), CFrame.new(0, 1.02, 0) * UPRIGHT, product.color, M.Glass, CYLINDER)
		part(model, base, v(0.3, 0.39, 0.39), CFrame.new(0, 0.42, 0) * UPRIGHT, rgb(240, 230, 210), M.SmoothPlastic, CYLINDER)
	elseif kind == "dose" then
		part(model, base, v(0.4, 0.34, 0.34), CFrame.new(0, 0.2, 0) * UPRIGHT, rgb(230, 240, 255), M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.5 })
		part(model, base, v(0.26, 0.28, 0.28), CFrame.new(0, 0.15, 0) * UPRIGHT, product.color, M.Glass, CYLINDER)
	elseif kind == "copo" or kind == "taca" then
		local height = if kind == "taca" then 0.55 else 0.7
		if kind == "taca" then
			part(model, base, v(0.45, 0.08, 0.08), CFrame.new(0, 0.25, 0) * UPRIGHT, rgb(230, 240, 255), M.Glass, CYLINDER)
		end
		local y = if kind == "taca" then 0.5 + height / 2 else height / 2
		part(model, base, v(height, 0.5, 0.5), CFrame.new(0, y, 0) * UPRIGHT, rgb(230, 240, 255), M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.55 })
		part(model, base, v(height * 0.8, 0.44, 0.44), CFrame.new(0, y - height * 0.08, 0) * UPRIGHT, product.color, M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.15 })
		part(model, base, v(0.2, 0.2, 0.2), CFrame.new(0.15, y + height / 2, 0), rgb(120, 200, 60), M.SmoothPlastic, { Shape = Enum.PartType.Ball })
	elseif kind == "copao" then
		part(model, base, v(1.1, 0.62, 0.62), CFrame.new(0, 0.55, 0) * UPRIGHT, rgb(235, 240, 255), M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.5 })
		part(model, base, v(0.9, 0.55, 0.55), CFrame.new(0, 0.47, 0) * UPRIGHT, product.color, M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.1 })
		for i = 0, 2 do
			part(model, base, v(0.18, 0.18, 0.18), CFrame.new(-0.12 + i * 0.12, 0.95, 0.05 * i), rgb(240, 250, 255), M.Glass, { Transparency = 0.2 })
		end
		part(model, base, v(0.06, 0.8, 0.06), CFrame.new(0.12, 1.25, 0) * CFrame.Angles(0, 0, math.rad(-12)), rgb(255, 60, 120), M.SmoothPlastic)
	elseif kind == "caneca" then
		part(model, base, v(0.8, 0.5, 0.5), CFrame.new(0, 0.4, 0) * UPRIGHT, product.color, M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.2 })
		part(model, base, v(0.18, 0.52, 0.52), CFrame.new(0, 0.86, 0) * UPRIGHT, rgb(255, 255, 250), M.SmoothPlastic, CYLINDER)
		part(model, base, v(0.1, 0.45, 0.25), CFrame.new(0.33, 0.42, 0), rgb(230, 240, 255), M.Glass, { Transparency = 0.4 })
	elseif kind == "espeto" then
		part(model, base, v(0.06, 1.3, 0.06), CFrame.new(0, 0.65, 0), rgb(200, 160, 100), M.Wood)
		for i = 0, 3 do
			part(model, base, v(0.28, 0.24, 0.28), CFrame.new(0, 0.55 + i * 0.22, 0), if i % 2 == 0 then product.color else rgb(190, 60, 40), M.SmoothPlastic)
		end
	elseif kind == "balde" then
		part(model, base, v(0.8, 0.9, 0.9), CFrame.new(0, 0.4, 0) * UPRIGHT, rgb(200, 205, 215), M.Metal, CYLINDER)
		for i = 0, 3 do
			local angle = i * math.pi / 2
			part(model, base, v(0.6, 0.22, 0.22), CFrame.new(math.cos(angle) * 0.2, 0.95, math.sin(angle) * 0.2) * UPRIGHT, rgb(40, 110, 50), M.Glass, CYLINDER)
		end
	elseif kind == "porcao" then
		part(model, base, v(0.08, 0.9, 0.9), CFrame.new(0, 0.05, 0) * UPRIGHT, rgb(250, 250, 250), M.SmoothPlastic, CYLINDER)
		for i = 0, 6 do
			local angle = i * 0.9
			part(model, base, v(0.1, 0.1, 0.45), CFrame.new(math.cos(angle) * 0.18, 0.15 + (i % 3) * 0.05, math.sin(angle) * 0.18) * CFrame.Angles(0, angle, math.rad(10)), product.color, M.SmoothPlastic)
		end
	else
		part(model, base, v(0.5, 0.8, 0.5), CFrame.new(0, 0.4, 0), product.color, M.Glass)
	end
	return model
end

-- Bandeja com até 6 itens, usada por jogadores e garçons.
function Models.tray(products)
	local model = Instance.new("Model")
	model.Name = "Bandeja"
	local base = part(model, nil, v(1.6, 0.1, 1.6), CFrame.new(), rgb(190, 192, 200), M.Metal)
	model.PrimaryPart = base
	part(model, base, v(0.06, 1.7, 1.7), CFrame.new(0, 0, 0) * UPRIGHT, rgb(170, 172, 180), M.Metal, CYLINDER)
	local spots = { { -0.42, -0.42 }, { 0.42, -0.42 }, { -0.42, 0.42 }, { 0.42, 0.42 }, { 0, 0 }, { 0, -0.7 } }
	for index, product in products do
		local spot = spots[index]
		if spot == nil then
			break
		end
		local item = Models.product(product, base.CFrame * CFrame.new(spot[1], 0.05, spot[2]) * CFrame.new(0, 0, 0))
		for _, p in item:GetDescendants() do
			if p:IsA("BasePart") and p ~= item.PrimaryPart then
				p.Size *= 0.75
			end
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = base
		weld.Part1 = item.PrimaryPart
		weld.Parent = item.PrimaryPart
		item.Parent = model
	end
	return model
end

Models.part = part
Models.CYLINDER = CYLINDER
Models.UPRIGHT = UPRIGHT

return Models
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000005">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[-- Util: formatação e a adega inicial que todo jogador novo recebe.

local Util = {}

function Util.formatMoney(amount)
	local negative = amount < 0
	local digits = tostring(math.floor(math.abs(amount)))
	local grouped = digits:reverse():gsub("(%d%d%d)", "%1."):reverse()
	if grouped:sub(1, 1) == "." then
		grouped = grouped:sub(2)
	end
	return (if negative then "-R$ " else "R$ ") .. grouped
end

function Util.formatNumber(amount)
	return (Util.formatMoney(amount):gsub("^R%$ ", ""))
end

function Util.formatDecimal(value)
	return (string.format("%.1f", value):gsub("%.", ","))
end

function Util.clockText(hour)
	local h = math.floor(hour)
	local m = math.floor((hour - h) * 6) * 10
	return string.format("%02d:%02d", h, m)
end

-- Adega inicial (terreno de 36 x 36): paredes, fachada com portas de enrolar, balcão com caixa,
-- geladeira, um bar com banquetas e mesas com cadeiras. { id, x, z, rotação }.
-- Rotação 1 vira o móvel para -X, 2 para +Z (o fundo) e 3 para +X.
Util.StarterLayout = {
	-- fundo
	{ "parede_reboco", -16, 35, 0 }, { "parede_reboco", -12, 35, 0 }, { "parede_reboco", -8, 35, 0 },
	{ "parede_reboco", -4, 35, 0 }, { "parede_reboco", 0, 35, 0 }, { "parede_reboco", 4, 35, 0 },
	{ "parede_reboco", 8, 35, 0 }, { "parede_reboco", 12, 35, 0 }, { "parede_reboco", 16, 35, 0 },
	-- laterais
	{ "parede_reboco", -17, 20, 1 }, { "parede_reboco", -17, 24, 1 }, { "parede_reboco", -17, 28, 1 }, { "parede_reboco", -17, 32, 1 },
	{ "parede_reboco", 17, 20, 1 }, { "parede_reboco", 17, 24, 1 }, { "parede_reboco", 17, 28, 1 }, { "parede_reboco", 17, 32, 1 },
	-- fachada
	{ "parede_tijolo", -16, 17, 0 }, { "parede_janela", -12, 17, 0 },
	{ "porta_enrolar", -8, 17, 0 }, { "porta_enrolar", -4, 17, 0 }, { "porta_enrolar", 0, 17, 0 },
	{ "porta_enrolar", 4, 17, 0 }, { "porta_enrolar", 8, 17, 0 },
	{ "parede_janela", 12, 17, 0 }, { "parede_tijolo", 16, 17, 0 },
	-- balcão, geladeira e bar
	{ "balcao_caixa", 0, 26, 0 },
	{ "geladeira_cerveja", -10, 33, 0 },
	{ "engradados", -15, 33, 0 }, { "engradados", -13, 33, 0 },
	{ "balcao_bar_reto", 10, 31, 0 }, { "balcao_bar_reto", 14, 31, 0 },
	{ "banqueta", 9, 29, 2 }, { "banqueta", 11, 29, 2 }, { "banqueta", 13, 29, 2 }, { "banqueta", 15, 29, 2 },
	-- mesas de dentro
	{ "mesa_plastico", -12, 22, 0 },
	{ "cadeira_vermelha", -15, 21, 3 }, { "cadeira_vermelha", -15, 23, 3 }, { "cadeira_vermelha", -9, 21, 1 }, { "cadeira_vermelha", -9, 23, 1 },
	{ "mesa_plastico", 12, 22, 0 },
	{ "cadeira_vermelha", 9, 21, 3 }, { "cadeira_vermelha", 9, 23, 3 }, { "cadeira_vermelha", 15, 21, 1 }, { "cadeira_vermelha", 15, 23, 1 },
	-- calçada
	{ "mesa_plastico", -10, 8, 0 },
	{ "cadeira_vermelha", -13, 7, 3 }, { "cadeira_vermelha", -13, 9, 3 }, { "cadeira_vermelha", -7, 7, 1 }, { "cadeira_vermelha", -7, 9, 1 },
	{ "mesa_plastico", 10, 8, 0 },
	{ "cadeira_vermelha", 7, 7, 3 }, { "cadeira_vermelha", 7, 9, 3 }, { "cadeira_vermelha", 13, 7, 1 }, { "cadeira_vermelha", 13, 9, 1 },
	{ "vaso_planta", -15, 15, 0 }, { "vaso_planta", 15, 15, 0 },
	{ "poste_luz", -17, 1, 0 }, { "poste_luz", 17, 1, 0 },
}

return Util
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX0000000F">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX0000000E">
			<Properties>
				<string name="Name">AdegaServer</string>
				<ProtectedString name="Source"><![CDATA[-- AdegaServer (Script em ServerScriptService, com os módulos Data, Plot, Props, Restaurant, Rig e Staff dentro)
-- Liga tudo: mundo, iluminação, relógio, terrenos, jogadores, economia, missões e as ações da interface.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

print("[Adega] Servidor iniciando…")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared", 15)
if Shared == nil then
	error("[Adega] Não achei a pasta AdegaShared dentro do ReplicatedStorage. Veja o README para instalar.")
end
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Util = require(Shared.Util)
local Looks = require(Shared.Looks)

local Data = require(script.Data)
local Plot = require(script.Plot)
local Props = require(script.Props)
local Restaurant = require(script.Restaurant)
local Rig = require(script.Rig)
local Staff = require(script.Staff)

local rgb = Color3.fromRGB
local formatMoney = Util.formatMoney

Data.init(Config.DataStoreName)
task.spawn(Rig.preload)

-- Comunicação com a interface -----------------------------------------------------------------------

local old = ReplicatedStorage:FindFirstChild("AdegaRemotes")
if old then
	old:Destroy()
end
local remotes = Instance.new("Folder")
remotes.Name = "AdegaRemotes"
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "Estado"
stateEvent.Parent = remotes
local noticeEvent = Instance.new("RemoteEvent")
noticeEvent.Name = "Aviso"
noticeEvent.Parent = remotes
local actionFunction = Instance.new("RemoteFunction")
actionFunction.Name = "Acao"
actionFunction.Parent = remotes
remotes.Parent = ReplicatedStorage

local function notify(player, text, kind, extra)
	if player and player.Parent then
		noticeEvent:FireClient(player, text, kind or "info", extra)
	end
end

-- Iluminação e relógio --------------------------------------------------------------------------------

local function ensureEffect(className, name, props)
	local effect = Lighting:FindFirstChild(name)
	if effect == nil then
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
	end
	for key, value in props do
		effect[key] = value
	end
end

Lighting.ClockTime = 16.5
Lighting.Brightness = 1.8
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 0.4
Lighting.OutdoorAmbient = rgb(118, 104, 136)
Lighting.Ambient = rgb(40, 34, 56)
Lighting.ShadowSoftness = 0.3
ensureEffect("Atmosphere", "AdegaAtmosfera", { Density = 0.3, Offset = 0.15, Color = rgb(205, 175, 220), Decay = rgb(92, 62, 140), Glare = 0.35, Haze = 1.4 })
ensureEffect("BloomEffect", "AdegaBrilho", { Intensity = 0.25, Size = 18, Threshold = 2.4 })
ensureEffect("ColorCorrectionEffect", "AdegaCor", { Saturation = 0.12, Contrast = 0.05, Brightness = -0.03, TintColor = rgb(255, 247, 240) })
ensureEffect("SunRaysEffect", "AdegaRaios", { Intensity = 0.05, Spread = 0.6 })
ensureEffect("DepthOfFieldEffect", "AdegaFoco", { FarIntensity = 0.12, FocusDistance = 80, InFocusRadius = 70, NearIntensity = 0 })

-- Mundo: chão, rua, calçada, postes e prédios do outro lado ------------------------------------------

local world = Instance.new("Folder")
world.Name = "AdegaMundo"
world.Parent = workspace

local function worldPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		part[key] = value
	end
	part.Parent = world
	return part
end

local totalWidth = Config.PlotCount * Config.PlotSpacing + 160
local front = Config.PlotFrontZ
if workspace:FindFirstChild("Baseplate") == nil then
	worldPart({ Name = "Chao", Size = Vector3.new(totalWidth + 400, 2, 700), Position = Vector3.new(0, -1, front), Color = rgb(80, 120, 60), Material = Enum.Material.Grass })
end
worldPart({ Name = "Calcada", Size = Vector3.new(totalWidth, 0.5, 8), Position = Vector3.new(0, 0.25, front - 4), Color = rgb(176, 170, 162), Material = Enum.Material.Pavement })
worldPart({ Name = "MeioFio", Size = Vector3.new(totalWidth, 0.55, 0.5), Position = Vector3.new(0, 0.27, front - 8.25), Color = rgb(225, 225, 225), Material = Enum.Material.Concrete })
worldPart({ Name = "Asfalto", Size = Vector3.new(totalWidth, 0.3, 20), Position = Vector3.new(0, 0.15, front - 18.5), Color = rgb(42, 42, 48), Material = Enum.Material.Asphalt })
worldPart({ Name = "CalcadaFrente", Size = Vector3.new(totalWidth, 0.5, 8), Position = Vector3.new(0, 0.25, front - 32.5), Color = rgb(176, 170, 162), Material = Enum.Material.Pavement })
for x = -totalWidth / 2 + 6, totalWidth / 2 - 6, 12 do
	worldPart({ Name = "Faixa", Size = Vector3.new(6, 0.05, 0.5), Position = Vector3.new(x, 0.32, front - 18.5), Color = rgb(250, 210, 60), CanCollide = false })
end
for x = -totalWidth / 2 + 20, totalWidth / 2 - 20, 40 do
	worldPart({ Name = "Poste", Size = Vector3.new(0.5, 16, 0.5), Position = Vector3.new(x, 8, front - 30), Color = rgb(50, 50, 56), Material = Enum.Material.Metal })
	worldPart({ Name = "BracoPoste", Size = Vector3.new(0.4, 0.4, 4), Position = Vector3.new(x, 16, front - 28.2), Color = rgb(50, 50, 56), Material = Enum.Material.Metal })
	local lamp = worldPart({ Name = "Luminaria", Size = Vector3.new(1.2, 0.4, 1.8), Position = Vector3.new(x, 15.7, front - 26.6), Color = rgb(255, 220, 160), Material = Enum.Material.Neon })
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 205, 150)
	light.Range = 34
	light.Brightness = 1.4
	light.Parent = lamp
end

local BUILDING_COLORS = { rgb(214, 112, 90), rgb(240, 200, 120), rgb(120, 170, 200), rgb(200, 200, 190), rgb(160, 120, 180), rgb(110, 160, 120), rgb(230, 150, 170), rgb(180, 160, 130) }
local random = Random.new(7)
local x = -totalWidth / 2 + 14
while x < totalWidth / 2 - 14 do
	local width = random:NextInteger(18, 28)
	local height = random:NextInteger(16, 40)
	local depth = 18
	local center = Vector3.new(x + width / 2, height / 2, front - 37 - depth / 2)
	worldPart({ Name = "Predio", Size = Vector3.new(width, height, depth), Position = center, Color = BUILDING_COLORS[random:NextInteger(1, #BUILDING_COLORS)], Material = Enum.Material.Concrete })
	worldPart({ Name = "Topo", Size = Vector3.new(width + 0.6, 0.8, depth + 0.6), Position = center + Vector3.new(0, height / 2 + 0.4, 0), Color = rgb(70, 70, 76), Material = Enum.Material.Concrete })
	for wy = 4, height - 4, 6 do
		for wx = -width / 2 + 3, width / 2 - 3, 4.5 do
			local lit = random:NextNumber() < 0.55
			worldPart({
				Name = "Janela",
				Size = Vector3.new(2.4, 3, 0.2),
				Position = Vector3.new(center.X + wx, wy, center.Z + depth / 2 + 0.1),
				Color = if lit then rgb(255, 214, 140) else rgb(40, 50, 70),
				Material = if lit then Enum.Material.Neon else Enum.Material.Glass,
				CanCollide = false,
			})
		end
	end
	x += width + random:NextInteger(1, 4)
end

task.spawn(function()
	local hoursPerSecond = 24 / (Config.DayLengthMinutes * 60)
	local last = os.clock()
	while true do
		task.wait(0.1)
		local t = os.clock()
		Lighting.ClockTime = (Lighting.ClockTime + (t - last) * hoursPerSecond) % 24
		last = t
	end
end)

-- Terrenos e jogadores --------------------------------------------------------------------------------

local plots = {}
local plotOf = {}
for index = 1, Config.PlotCount do
	plots[index] = Plot.new(index)
end
print("[Adega] " .. Config.PlotCount .. " terrenos criados")

local function leaderstat(player, name, className)
	local stats = player:FindFirstChild("leaderstats")
	return stats and stats:FindFirstChild(name)
end

local function updateLeaderstats(plot)
	local player = plot.owner
	if player == nil then
		return
	end
	local cash = leaderstat(player, "Dinheiro")
	if cash then
		cash.Value = math.floor(plot.cash)
	end
	local level = leaderstat(player, "Nível")
	if level then
		level.Value = plot.level
	end
	local rating = leaderstat(player, "Avaliação")
	if rating and plot.rt then
		rating.Value = Util.formatDecimal(Restaurant.rating(plot)) .. " ★"
	end
end

local function markDirty(plot)
	plot.dirty = true
end

-- Missões -----------------------------------------------------------------------------------------

local function currentQuest(plot)
	return Config.Quests[plot.questIndex]
end

local completeQuestIfReady

local function questInstantCheck(plot)
	local quest = currentQuest(plot)
	if quest == nil then
		return
	end
	if quest.event == "rating4" and plot.rt and #plot.rt.ratings >= 10 and Restaurant.rating(plot) >= 4 then
		plot.questProgress = quest.target
	elseif quest.event == "level15" and plot.level >= 15 then
		plot.questProgress = quest.target
	elseif quest.event == "staffCount8" and #plot.staff >= 8 then
		plot.questProgress = quest.target
	end
	completeQuestIfReady(plot)
end

local function addCash(plot, amount)
	plot.cash += amount
	updateLeaderstats(plot)
	markDirty(plot)
end

completeQuestIfReady = function(plot)
	local quest = currentQuest(plot)
	if quest == nil or plot.questProgress < quest.target then
		return
	end
	addCash(plot, quest.reward)
	notify(plot.owner, "Missão cumprida: " .. quest.text .. " (+" .. formatMoney(quest.reward) .. ")", "missao")
	plot.questIndex += 1
	plot.questProgress = 0
	markDirty(plot)
	questInstantCheck(plot)
end

local function questEvent(plot, name, amount)
	local quest = currentQuest(plot)
	if quest and quest.event == name then
		plot.questProgress += amount or 1
		markDirty(plot)
		completeQuestIfReady(plot)
	end
end

-- Dinheiro e experiência ----------------------------------------------------------------------------

local function addXp(plot, amount)
	plot.xp += amount
	while plot.level < Config.MaxLevel and plot.xp >= Config.xpForLevel(plot.level) do
		plot.xp -= Config.xpForLevel(plot.level)
		plot.level += 1
		notify(plot.owner, "Sua adega chegou ao nível " .. plot.level .. "!", "nivel", { level = plot.level })
		Props.sparkle(plot:toWorld(0, 4, 8), rgb(200, 120, 255))
		questInstantCheck(plot)
	end
	updateLeaderstats(plot)
	markDirty(plot)
end

local function earn(plot, amount, position)
	addCash(plot, amount)
	addXp(plot, amount)
	plot.day.earned += amount
	if position then
		Props.popup(position + Vector3.new(0, 2, 0), "+" .. formatMoney(amount), rgb(110, 255, 140))
	end
end

-- Salvamento --------------------------------------------------------------------------------------

local function serialize(plot)
	local staff = {}
	for _, member in plot.staff do
		table.insert(staff, { role = member.role.id, name = member.name, level = member.level, look = member.look })
	end
	return {
		version = 3,
		cash = math.floor(plot.cash),
		xp = plot.xp,
		level = plot.level,
		sizeLevel = plot.sizeLevel,
		floor = plot.style.floor,
		wall = plot.style.wall,
		ownedFloors = plot.ownedFloors,
		ownedWalls = plot.ownedWalls,
		furniture = plot:serialize(),
		staff = staff,
		ratings = if plot.rt then plot.rt.ratings else {},
		questIndex = plot.questIndex,
		questProgress = plot.questProgress,
		totalServed = plot.totalServed,
	}
end

local function save(player)
	local plot = plotOf[player]
	if plot and plot.canSave then
		Data.save(player.UserId, serialize(plot))
	end
end

-- Entrada e saída ---------------------------------------------------------------------------------

local nextStaffId = 1
local function spawnStaff(plot, entry)
	local data = { id = nextStaffId, role = entry.role, name = entry.name, level = entry.level, look = entry.look }
	nextStaffId += 1
	return Staff.spawn(plot, data)
end

local function moveToPlot(player, plot)
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local spot = plot:toWorld(0, -4, 3)
		character:PivotTo(CFrame.lookAt(spot, spot + Vector3.new(0, 0, 1)))
	end
end

local function onPlayerAdded(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Dinheiro"
	cash.Parent = stats
	local level = Instance.new("IntValue")
	level.Name = "Nível"
	level.Value = 1
	level.Parent = stats
	local rating = Instance.new("StringValue")
	rating.Name = "Avaliação"
	rating.Value = "3,0 ★"
	rating.Parent = stats
	stats.Parent = player

	local plot = nil
	for _, candidate in plots do
		if candidate.owner == nil and not candidate.loading then
			plot = candidate
			break
		end
	end
	if plot == nil then
		notify(player, "Servidor cheio: todas as adegas estão ocupadas. Visite as outras!", "erro")
		return
	end
	plot.loading = true
	plotOf[player] = plot

	local loaded, saved = Data.load(player.UserId)
	if player.Parent == nil then
		plot.loading = false
		plotOf[player] = nil
		return
	end
	if type(saved) ~= "table" or saved.version ~= 3 then
		saved = nil
	end

	plot.canSave = loaded
	plot.cash = if saved then tonumber(saved.cash) or Config.StartingCash else Config.StartingCash
	plot.xp = if saved then tonumber(saved.xp) or 0 else 0
	plot.level = if saved then math.clamp(tonumber(saved.level) or 1, 1, Config.MaxLevel) else 1
	plot.questIndex = if saved then tonumber(saved.questIndex) or 1 else 1
	plot.questProgress = if saved then tonumber(saved.questProgress) or 0 else 0
	plot.totalServed = if saved then tonumber(saved.totalServed) or 0 else 0
	plot.ownedFloors = if saved and type(saved.ownedFloors) == "table" then saved.ownedFloors else { cimento = true }
	plot.ownedWalls = if saved and type(saved.ownedWalls) == "table" then saved.ownedWalls else { branco = true }
	plot.day = { served = 0, earned = 0, reviews = 0, stars = 0 }
	plot.staff = {}

	plot:claim(player, saved)
	plot.loading = false
	Restaurant.setup(plot, {
		earn = function(amount, position)
			earn(plot, amount, position)
		end,
		event = function(name, amount)
			if name == "served" then
				plot.totalServed += amount
				plot.day.served += amount
			end
			questEvent(plot, name, amount)
		end,
		notify = function(text, kind)
			notify(player, text, kind)
		end,
		review = function(stars)
			plot.day.reviews += 1
			plot.day.stars += stars
			updateLeaderstats(plot)
			questInstantCheck(plot)
		end,
	}, saved)

	if saved and type(saved.staff) == "table" then
		for _, entry in saved.staff do
			if type(entry) == "table" and Config.staffById(entry.role) then
				spawnStaff(plot, entry)
			end
		end
	end

	updateLeaderstats(plot)
	markDirty(plot)

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if plot.owner == player then
			moveToPlot(player, plot)
			Restaurant.updateTray(plot)
		end
	end)
	player.CharacterRemoving:Connect(function()
		if plot.owner == player then
			Restaurant.dropCarry(plot)
		end
	end)
	if player.Character then
		task.spawn(moveToPlot, player, plot)
	end
	if saved == nil then
		notify(player, "Bem-vindo! Essa adega agora é sua. Siga as missões para começar.", "nivel")
	end
	questInstantCheck(plot)
end

local function onPlayerRemoving(player)
	save(player)
	local plot = plotOf[player]
	plotOf[player] = nil
	if plot and plot.owner == player then
		Staff.clear(plot)
		Restaurant.teardown(plot)
		plot:release()
		plot.canSave = false
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

game:BindToClose(function()
	for _, player in Players:GetPlayers() do
		task.spawn(save, player)
	end
	task.wait(3)
end)

task.spawn(function()
	while true do
		task.wait(Config.AutoSaveInterval)
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
	end
end)

-- Ações da interface --------------------------------------------------------------------------------

local function result(ok, message)
	return { ok = ok, msg = message }
end

local function unusedName(plot)
	local used = {}
	for _, member in plot.staff do
		used[member.name] = true
	end
	local options = {}
	for _, name in Config.StaffNames do
		if not used[name] then
			table.insert(options, name)
		end
	end
	if #options == 0 then
		return Config.StaffNames[math.random(1, #Config.StaffNames)] .. " " .. math.random(2, 9)
	end
	return options[math.random(1, #options)]
end

local function findStaff(plot, id)
	for _, member in plot.staff do
		if member.id == id then
			return member
		end
	end
	return nil
end

local actions = {}

function actions.colocar(player, plot, payload)
	local item = Catalog.ById[payload.id]
	if item == nil or type(payload.x) ~= "number" or type(payload.z) ~= "number" or type(payload.r) ~= "number" then
		return result(false, "Item inválido")
	end
	local rotation = math.floor(payload.r) % 4
	local w, d = Catalog.footprint(item, rotation)
	local x = Catalog.snap(payload.x, w)
	local z = Catalog.snap(payload.z, d)
	local ok, reason = plot:canPlace(item, x, z, rotation, nil, plot.level)
	if not ok then
		return result(false, reason)
	end
	if plot.cash < item.price then
		return result(false, "Falta dinheiro: " .. formatMoney(item.price))
	end
	addCash(plot, -item.price)
	local rec = plot:place(item.id, x, z, rotation, true)
	if rec and ((rec.kind == "chair" and rec.attached) or (rec.host and #rec.seats > 0)) then
		questEvent(plot, "placeSeating", 1)
	end
	questEvent(plot, "place_" .. item.id, 1)
	return result(true, nil)
end

function actions.mover(player, plot, payload)
	local rec = plot.furniture[payload.uid]
	if rec == nil or type(payload.x) ~= "number" or type(payload.z) ~= "number" or type(payload.r) ~= "number" then
		return result(false, "Móvel não encontrado")
	end
	local canModify, why = Restaurant.canModify(plot, rec)
	if not canModify then
		return result(false, why)
	end
	local item = rec.item
	local rotation = math.floor(payload.r) % 4
	local w, d = Catalog.footprint(item, rotation)
	local x = Catalog.snap(payload.x, w)
	local z = Catalog.snap(payload.z, d)
	local ok, reason = plot:canPlace(item, x, z, rotation, rec.uid, nil)
	if not ok then
		return result(false, reason)
	end
	plot:remove(rec.uid)
	plot:place(item.id, x, z, rotation, true)
	return result(true, nil)
end

function actions.vender(player, plot, payload)
	local rec = plot.furniture[payload.uid]
	if rec == nil then
		return result(false, "Móvel não encontrado")
	end
	local canModify, why = Restaurant.canModify(plot, rec)
	if not canModify then
		return result(false, why)
	end
	local refund = math.floor(rec.item.price * Config.SellRefund)
	plot:remove(rec.uid)
	addCash(plot, refund)
	return result(true, "Vendido por " .. formatMoney(refund))
end

function actions.contratar(player, plot, payload)
	local role = Config.staffById(payload.role)
	if role == nil then
		return result(false, "Função inválida")
	end
	if plot.level < role.level then
		return result(false, "Libera no nível " .. role.level)
	end
	if #plot.staff >= Config.maxStaff(plot.level) then
		return result(false, "Limite de funcionários do seu nível. Suba de nível para contratar mais.")
	end
	if plot.cash < role.hire then
		return result(false, "Falta dinheiro: " .. formatMoney(role.hire))
	end
	addCash(plot, -role.hire)
	local member = spawnStaff(plot, { role = role.id, name = unusedName(plot), level = 1 })
	questEvent(plot, "hire_" .. role.id, 1)
	questInstantCheck(plot)
	markDirty(plot)
	return result(true, member and (member.name .. " foi contratado como " .. role.name) or nil)
end

function actions.treinar(player, plot, payload)
	local member = findStaff(plot, payload.id)
	if member == nil then
		return result(false, "Funcionário não encontrado")
	end
	if member.level >= Config.StaffMaxLevel then
		return result(false, "Já está no nível máximo")
	end
	local price = Config.trainPrice(member.role, member.level)
	if plot.cash < price then
		return result(false, "Falta dinheiro: " .. formatMoney(price))
	end
	addCash(plot, -price)
	member.level += 1
	Staff.updateTag(member)
	Props.sparkle(member.rig.root.Position, rgb(120, 200, 255))
	markDirty(plot)
	return result(true, member.name .. " agora está no nível " .. member.level)
end

function actions.visual(player, plot, payload)
	local member = findStaff(plot, payload.id)
	if member == nil then
		return result(false, "Funcionário não encontrado")
	end
	Staff.setLook(member, Looks.sanitize(payload.look, member.look))
	if type(payload.name) == "string" then
		local name = payload.name:gsub("[%c<>]", ""):sub(1, 18)
		if #name >= 2 then
			member.name = name
			member.actor.name = name
			Staff.updateTag(member)
		end
	end
	questEvent(plot, "customize", 1)
	markDirty(plot)
	return result(true, "Visual de " .. member.name .. " atualizado")
end

function actions.demitir(player, plot, payload)
	local member = findStaff(plot, payload.id)
	if member == nil then
		return result(false, "Funcionário não encontrado")
	end
	Staff.remove(plot, member)
	markDirty(plot)
	return result(true, member.name .. " foi demitido")
end

function actions.expandir(player, plot)
	local nextSize = Config.PlotSizes[plot.sizeLevel + 1]
	if nextSize == nil then
		return result(false, "Seu terreno já está no tamanho máximo")
	end
	if plot.level < nextSize.level then
		return result(false, "Libera no nível " .. nextSize.level)
	end
	if plot.cash < nextSize.price then
		return result(false, "Falta dinheiro: " .. formatMoney(nextSize.price))
	end
	addCash(plot, -nextSize.price)
	plot.sizeLevel += 1
	plot.size = nextSize.size
	plot:applySize()
	Props.sparkle(plot:toWorld(0, plot.size / 2, 3))
	questEvent(plot, "expand", 1)
	markDirty(plot)
	return result(true, "Terreno ampliado para " .. nextSize.size .. " x " .. nextSize.size)
end

function actions.estilo(player, plot, payload)
	local list = if payload.kind == "floor" then Config.Floors elseif payload.kind == "wall" then Config.WallColors else nil
	local owned = if payload.kind == "floor" then plot.ownedFloors else plot.ownedWalls
	local option = list and Config.findById(list, payload.id)
	if option == nil then
		return result(false, "Opção inválida")
	end
	if not owned[option.id] then
		if plot.cash < option.price then
			return result(false, "Falta dinheiro: " .. formatMoney(option.price))
		end
		addCash(plot, -option.price)
		owned[option.id] = true
	end
	if payload.kind == "floor" then
		plot.style.floor = option.id
	else
		plot.style.wall = option.id
	end
	plot:applyStyle()
	questEvent(plot, "style", 1)
	markDirty(plot)
	return result(true, nil)
end

function actions.voltar(player, plot)
	moveToPlot(player, plot)
	return result(true, nil)
end

local lastAction = {}
actionFunction.OnServerInvoke = function(player, action, payload)
	local plot = plotOf[player]
	if plot == nil or plot.owner ~= player or plot.rt == nil then
		return result(false, "Sua adega ainda está carregando")
	end
	local handler = type(action) == "string" and actions[action]
	if handler == nil then
		return result(false, "Ação desconhecida")
	end
	local t = os.clock()
	if lastAction[player] and t - lastAction[player] < 0.12 then
		return result(false, "Calma!")
	end
	lastAction[player] = t
	if type(payload) ~= "table" then
		payload = {}
	end
	local ok, response = pcall(handler, player, plot, payload)
	if not ok then
		warn("[Adega] Erro na ação", action, response)
		return result(false, "Algo deu errado")
	end
	markDirty(plot)
	return response
end

-- Estado para a interface ---------------------------------------------------------------------------

local function buildState(plot)
	local snapshot = Restaurant.snapshot(plot)
	local staff = {}
	for _, member in plot.staff do
		table.insert(staff, {
			id = member.id,
			role = member.role.id,
			name = member.name,
			level = member.level,
			train = if member.level < Config.StaffMaxLevel then Config.trainPrice(member.role, member.level) else nil,
			look = member.look,
		})
	end
	local quest = currentQuest(plot)
	local reviews = {}
	for i = 1, math.min(8, #snapshot.reviews) do
		reviews[i] = snapshot.reviews[i]
	end
	return {
		cash = math.floor(plot.cash),
		level = plot.level,
		xp = plot.xp,
		xpNext = Config.xpForLevel(plot.level),
		plotIndex = plot.index,
		origin = plot.origin.Position,
		size = plot.size,
		sizeLevel = plot.sizeLevel,
		style = plot.style,
		ownedFloors = plot.ownedFloors,
		ownedWalls = plot.ownedWalls,
		staff = staff,
		maxStaff = Config.maxStaff(plot.level),
		quest = if quest then { text = quest.text, progress = math.min(plot.questProgress, quest.target), target = quest.target, reward = quest.reward, index = plot.questIndex, total = #Config.Quests } else nil,
		day = plot.day,
		totalServed = plot.totalServed,
		appeal = plot:appeal(),
		orders = snapshot.orders,
		carry = snapshot.carry,
		carryLimit = Config.CarryLimit,
		present = snapshot.present,
		freeTables = snapshot.freeTables,
		dirtyTables = snapshot.dirtyTables,
		tableMoney = snapshot.tableMoney,
		rating = snapshot.rating,
		ratingCount = #plot.rt.ratings,
		reviews = reviews,
		menu = snapshot.menu,
		groupsPerMinute = snapshot.groupsPerMinute,
		night = snapshot.night,
	}
end

-- Resumo da noite: quando o relógio passa das 6h.
local lastHour = Lighting.ClockTime
local function checkDayRollover()
	local hour = Lighting.ClockTime
	if lastHour < 6 and hour >= 6 then
		for _, plot in plots do
			if plot.owner and plot.day then
				local day = plot.day
				notify(plot.owner, "Resumo do dia", "resumo", {
					served = day.served,
					earned = day.earned,
					rating = if day.reviews > 0 then day.stars / day.reviews else nil,
				})
				plot.day = { served = 0, earned = 0, reviews = 0, stars = 0 }
			end
		end
	end
	lastHour = hour
end

local lastFull = 0
local lastSend = 0
while true do
	task.wait(0.25)
	local t = os.clock()
	for _, plot in plots do
		if plot.owner and plot.rt then
			local ok, err = pcall(Restaurant.tick, plot)
			if not ok then
				warn("[Adega] Erro na adega", plot.index, err)
			end
		end
	end
	checkDayRollover()
	if t - lastSend >= 0.5 then
		lastSend = t
		local full = t - lastFull >= 2
		if full then
			lastFull = t
		end
		for _, plot in plots do
			if plot.owner and plot.rt and (full or plot.dirty or plot.rt.dirty) then
				plot.dirty = false
				plot.rt.dirty = false
				local ok, state = pcall(buildState, plot)
				if ok then
					stateEvent:FireClient(plot.owner, state)
				else
					warn("[Adega] Erro montando o estado", state)
				end
			end
		end
	end
end
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX00000008">
				<Properties>
					<string name="Name">Data</string>
					<ProtectedString name="Source"><![CDATA[-- Data: salvar e carregar o progresso, com novas tentativas quando o DataStore falha.

local DataStoreService = game:GetService("DataStoreService")

local Data = {}

local store = nil

function Data.init(name)
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(name)
	end)
	if ok then
		store = result
	else
		warn("[Adega] DataStore indisponível, o progresso não será salvo:", result)
	end
	return store ~= nil
end

local function key(userId)
	return "jogador_" .. userId
end

-- Devolve (true, dados ou nil) se a leitura funcionou, ou (false, nil) se falhou.
function Data.load(userId)
	if store == nil then
		return false, nil
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(key(userId))
		end)
		if ok then
			return true, result
		end
		warn("[Adega] Falha ao carregar (tentativa " .. attempt .. "):", result)
		task.wait(attempt)
	end
	return false, nil
end

function Data.save(userId, data)
	if store == nil then
		return false
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:SetAsync(key(userId), data)
		end)
		if ok then
			return true
		end
		warn("[Adega] Falha ao salvar (tentativa " .. attempt .. "):", err)
		task.wait(attempt)
	end
	return false
end

return Data
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000009">
				<Properties>
					<string name="Name">Plot</string>
					<ProtectedString name="Source"><![CDATA[-- Plot: um terreno. Cuida do chão, da área construível, do estilo e dos móveis colocados
-- (com a grade de ocupação). O comportamento dos clientes fica no módulo Restaurant, que
-- recebe avisos pelos ganchos plot.hooks.added / removed / canModify.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Util = require(Shared.Util)

local Props = require(script.Parent.Props)

local Plot = {}
Plot.__index = Plot

local rgb = Color3.fromRGB
local GROUND_Y = 0.5
local FLOOR_Y = 0.6

local function makePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		part[key] = value
	end
	part.Parent = parent
	return part
end

local function signText(part, text, color)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
	label.TextColor3 = color
	label.Text = text
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.05, 0)
	padding.PaddingRight = UDim.new(0.05, 0)
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = gui
	return label
end

function Plot.new(index)
	local x = (index - (Config.PlotCount + 1) / 2) * Config.PlotSpacing
	local self = setmetatable({}, Plot)
	self.index = index
	self.origin = CFrame.new(x, FLOOR_Y, Config.PlotFrontZ)
	self.owner = nil
	self.sizeLevel = 1
	self.size = Config.PlotSizes[1].size
	self.style = { floor = "cimento", wall = "branco" }
	self.furniture = {}
	self.occupied = {}
	self.nextUid = 1
	self.hooks = {}

	local model = Instance.new("Model")
	model.Name = "Adega" .. index
	self.model = model
	for _, name in { "Terreno", "Moveis", "Pessoas", "Efeitos" } do
		local folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = model
	end
	self.landFolder = model.Terreno
	self.furnitureFolder = model.Moveis
	self.peopleFolder = model.Pessoas
	self.effectsFolder = model.Efeitos

	local base = CFrame.new(x, 0, Config.PlotFrontZ)
	makePart(self.landFolder, {
		Name = "Grama",
		Size = Vector3.new(Config.LandWidth, GROUND_Y, Config.LandDepth),
		CFrame = base * CFrame.new(0, GROUND_Y / 2, Config.LandDepth / 2),
		Color = rgb(88, 130, 66),
		Material = Enum.Material.Grass,
	})
	self.floor = makePart(self.landFolder, {
		Name = "PisoConstrucao",
		Size = Vector3.new(self.size, FLOOR_Y - GROUND_Y, self.size),
		CFrame = self.origin * CFrame.new(0, -(FLOOR_Y - GROUND_Y) / 2, self.size / 2),
	})
	self.curbs = {}
	for i = 1, 4 do
		self.curbs[i] = makePart(self.landFolder, { Name = "Borda", Color = rgb(200, 196, 188), Material = Enum.Material.Concrete, CanCollide = false })
	end

	-- placa na frente do terreno
	makePart(self.landFolder, {
		Name = "PostePlaca",
		Size = Vector3.new(0.4, 7, 0.4),
		CFrame = base * CFrame.new(-Config.LandWidth / 2 + 4, GROUND_Y + 3.5, 1),
		Color = rgb(50, 50, 55),
		Material = Enum.Material.Metal,
	})
	local board = makePart(self.landFolder, {
		Name = "PlacaDono",
		Size = Vector3.new(9, 3, 0.3),
		CFrame = base * CFrame.new(-Config.LandWidth / 2 + 4, GROUND_Y + 8, 0.8),
		Color = rgb(22, 18, 30),
	})
	self.signLabel = signText(board, "TERRENO DISPONÍVEL", rgb(255, 196, 40))

	self:applySize()
	self:applyStyle()
	model.Parent = workspace
	return self
end

function Plot:toWorld(x, z, y)
	return (self.origin * CFrame.new(x, y or 0, z)).Position
end

function Plot:toLocal(position)
	return self.origin:PointToObjectSpace(position)
end

function Plot:sidewalkPoint(side)
	return self:toWorld(side * (Config.LandWidth / 2 + 6), -4, -(FLOOR_Y - GROUND_Y))
end

function Plot:entrancePoint()
	return self:toWorld(0, -3, -(FLOOR_Y - GROUND_Y))
end

-- Área construível e estilo -------------------------------------------------------------------------

function Plot:applySize()
	local size = self.size
	self.floor.Size = Vector3.new(size, FLOOR_Y - GROUND_Y, size)
	self.floor.CFrame = self.origin * CFrame.new(0, -(FLOOR_Y - GROUND_Y) / 2, size / 2)
	local h = 0.35
	local specs = {
		{ Vector3.new(size + 0.8, h, 0.4), CFrame.new(0, h / 2 - 0.05, -0.2) },
		{ Vector3.new(size + 0.8, h, 0.4), CFrame.new(0, h / 2 - 0.05, size + 0.2) },
		{ Vector3.new(0.4, h, size), CFrame.new(-size / 2 - 0.2, h / 2 - 0.05, size / 2) },
		{ Vector3.new(0.4, h, size), CFrame.new(size / 2 + 0.2, h / 2 - 0.05, size / 2) },
	}
	for i, spec in specs do
		self.curbs[i].Size = spec[1]
		self.curbs[i].CFrame = self.origin * spec[2]
	end
end

function Plot:wallColor()
	return Config.findById(Config.WallColors, self.style.wall).color
end

function Plot:applyStyle()
	local floor = Config.findById(Config.Floors, self.style.floor) or Config.Floors[1]
	self.floor.Color = floor.color
	self.floor.Material = floor.material
	local color = self:wallColor()
	for _, part in self.furnitureFolder:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Pintura") then
			part.Color = color
		end
	end
end

-- Móveis ------------------------------------------------------------------------------------------

function Plot:canPlace(item, x, z, rotation, ignoreUid, ownerLevel)
	if ownerLevel and ownerLevel < item.level then
		return false, "Libera no nível " .. item.level
	end
	if not Catalog.inBounds(item, x, z, rotation, self.size) then
		return false, "Fora da área da adega"
	end
	for _, key in Catalog.cells(item, x, z, rotation) do
		local uid = self.occupied[key]
		if uid and uid ~= ignoreUid then
			return false, "Já tem algo nesse lugar"
		end
	end
	return true, nil
end

local function lowestFreeNumber(furniture)
	local used = {}
	for _, rec in furniture do
		if rec.number then
			used[rec.number] = true
		end
	end
	local n = 1
	while used[n] do
		n += 1
	end
	return n
end

-- Coloca um móvel sem cobrar nada (quem chama já validou e cobrou).
function Plot:place(itemId, x, z, rotation, animate)
	local item = Catalog.ById[itemId]
	if item == nil then
		return nil
	end
	local localCF = Catalog.localCFrame(x, z, rotation)
	local cframe = self.origin * localCF
	local model = Catalog.buildModel(item, cframe, { wallColor = self:wallColor() })
	local uid = self.nextUid
	self.nextUid += 1
	model:SetAttribute("Uid", uid)
	model:SetAttribute("ItemId", itemId)
	model:SetAttribute("X", x)
	model:SetAttribute("Z", z)
	model:SetAttribute("R", rotation)

	local rec = {
		uid = uid,
		id = itemId,
		item = item,
		kind = item.kind,
		x = x,
		z = z,
		r = rotation,
		cframe = cframe,
		model = model,
		cells = Catalog.cells(item, x, z, rotation),
	}
	for _, key in rec.cells do
		self.occupied[key] = uid
	end

	local front = cframe:VectorToWorldSpace(Vector3.new(0, 0, -1))
	rec.front = front
	if Catalog.isSeatingHost(item) then
		-- mesa ou balcão de bar: recebe os clientes das cadeiras viradas para ele
		rec.host = true
		rec.number = lowestFreeNumber(self.furniture)
		rec.status = "free"
		rec.money = 0
		rec.seats = {}
		rec.top = Catalog.point3(cframe, item.top)
		rec.topPart = model:FindFirstChild("Tampo") or model.PrimaryPart
		if item.kind == "bar" then
			rec.ready = {}
			rec.pickup = rec.top
			rec.staffPos = Catalog.floorPoint(cframe, { 0, item.size[2] * 2 / 2 + 1.4 })
		end
		local tag = Instance.new("BillboardGui")
		tag.Name = "Numero"
		tag.Size = UDim2.fromOffset(30, 30)
		tag.StudsOffset = Vector3.new(0, 1.3, 0)
		tag.MaxDistance = 40
		tag.LightInfluence = 0
		tag.Parent = rec.topPart
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = rgb(255, 255, 255)
		label.BackgroundTransparency = 0.05
		label.TextColor3 = rgb(40, 34, 48)
		label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
		label.TextScaled = true
		label.Text = tostring(rec.number)
		label.Parent = tag
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = label
		local padding = Instance.new("UIPadding")
		padding.PaddingTop = UDim.new(0.15, 0)
		padding.PaddingBottom = UDim.new(0.15, 0)
		padding.Parent = label
		rec.numberTag = tag
	elseif item.kind == "chair" then
		rec.seatList = {}
		for index, seat in Catalog.seatPoints(item, x, z, rotation) do
			rec.seatList[index] = {
				pos = (self.origin * CFrame.new(seat.pos.X, 0, seat.pos.Z)).Position,
				face = self.origin:VectorToWorldSpace(seat.face),
				height = seat.height,
				frontKey = seat.frontKey,
				chair = rec,
			}
		end
	elseif item.kind == "station" then
		rec.use = Catalog.floorPoint(cframe, item.use)
		rec.top = Catalog.point3(cframe, item.top)
		rec.part = model:FindFirstChild("Uso") or model.PrimaryPart
		rec.products = {}
		for _, product in Config.Products do
			if product.station == itemId then
				table.insert(rec.products, product)
			end
		end
		rec.ready = {}
	elseif item.kind == "counter" then
		rec.queue = Catalog.floorPoint(cframe, item.queue)
		rec.staffPos = Catalog.floorPoint(cframe, item.staff)
		rec.pickup = Catalog.point3(cframe, item.pickup)
		rec.part = model:FindFirstChild("Uso") or model.PrimaryPart
		rec.line = {}
		rec.ready = {}
	elseif item.staff then
		rec.staffPos = Catalog.floorPoint(cframe, item.staff)
	end

	if item.spin then
		local spinner = model:FindFirstChild(item.spin)
		if spinner then
			TweenService:Create(spinner, TweenInfo.new(8, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1), {
				Orientation = spinner.Orientation + Vector3.new(0, 360, 0),
			}):Play()
		end
	end

	if animate then
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part.Name ~= "Raiz" then
				local finalCFrame, finalTransparency = part.CFrame, part.Transparency
				part.CFrame = finalCFrame + Vector3.new(0, 2.5, 0)
				part.Transparency = 1
				TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { CFrame = finalCFrame, Transparency = finalTransparency }):Play()
			end
		end
		Props.sparkle(cframe.Position + Vector3.new(0, 2, 0))
	end

	model.Parent = self.furnitureFolder
	self.furniture[uid] = rec
	if not self.batching then
		self:relink()
	end
	if self.hooks.added then
		self.hooks.added(self, rec)
	end
	return rec
end

-- Liga cada cadeira à mesa ou balcão que está na frente dela. Mesas em uso mantêm os
-- lugares que tinham, para não atrapalhar quem está sentado.
function Plot:relink()
	for _, rec in self.furniture do
		if rec.host and rec.status == "free" then
			rec.seats = {}
		end
		if rec.kind == "chair" then
			rec.attached = nil
		end
	end
	for _, rec in self.furniture do
		if rec.kind == "chair" then
			for _, seat in rec.seatList do
				local hostUid = self.occupied[seat.frontKey]
				local host = hostUid and self.furniture[hostUid]
				if host and host.host then
					rec.attached = host
					if host.status == "free" then
						table.insert(host.seats, seat)
					end
				end
			end
		end
	end
	for _, rec in self.furniture do
		if rec.host and rec.numberTag then
			rec.numberTag.Enabled = #rec.seats > 0 or rec.status ~= "free"
		end
	end
end

function Plot:remove(uid)
	local rec = self.furniture[uid]
	if rec == nil then
		return nil
	end
	if self.hooks.removed then
		self.hooks.removed(self, rec)
	end
	for _, key in rec.cells do
		if self.occupied[key] == uid then
			self.occupied[key] = nil
		end
	end
	self.furniture[uid] = nil
	rec.removed = true
	rec.model:Destroy()
	if not self.batching then
		self:relink()
	end
	return rec
end

function Plot:clearFurniture()
	self.batching = true
	for uid in self.furniture do
		self:remove(uid)
	end
	self.batching = false
	self.occupied = {}
	self.nextUid = 1
end

function Plot:serialize()
	local list = {}
	for _, rec in self.furniture do
		table.insert(list, { rec.id, rec.x, rec.z, rec.r })
	end
	return list
end

function Plot:loadLayout(list)
	self.batching = true
	for _, entry in list do
		local item = Catalog.ById[entry[1]]
		if item and type(entry[2]) == "number" and type(entry[3]) == "number" and type(entry[4]) == "number" then
			local rotation = math.floor(entry[4]) % 4
			if self:canPlace(item, entry[2], entry[3], rotation, nil, nil) then
				self:place(entry[1], entry[2], entry[3], rotation, false)
			end
		end
	end
	self.batching = false
	self:relink()
end

function Plot:appeal()
	local total = 0
	for _, rec in self.furniture do
		total += rec.item.appeal or 0
	end
	return total
end

function Plot:find(kind)
	local list = {}
	for _, rec in self.furniture do
		if rec.kind == kind then
			table.insert(list, rec)
		end
	end
	return list
end

-- Dono --------------------------------------------------------------------------------------------

function Plot:claim(player, saved)
	self.owner = player
	self.sizeLevel = math.clamp(saved and saved.sizeLevel or 1, 1, #Config.PlotSizes)
	self.size = Config.PlotSizes[self.sizeLevel].size
	self.style = {
		floor = if saved and Config.findById(Config.Floors, saved.floor) then saved.floor else "cimento",
		wall = if saved and Config.findById(Config.WallColors, saved.wall) then saved.wall else "branco",
	}
	self:applySize()
	self:loadLayout(if saved and type(saved.furniture) == "table" then saved.furniture else Util.StarterLayout)
	self:applyStyle()
	self.signLabel.Text = "ADEGA " .. string.upper(player.DisplayName)
end

function Plot:release()
	self:clearFurniture()
	self.peopleFolder:ClearAllChildren()
	self.effectsFolder:ClearAllChildren()
	self.owner = nil
	self.sizeLevel = 1
	self.size = Config.PlotSizes[1].size
	self.style = { floor = "cimento", wall = "branco" }
	self:applySize()
	self:applyStyle()
	self.signLabel.Text = "TERRENO DISPONÍVEL"
end

return Plot
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000A">
				<Properties>
					<string name="Name">Props</string>
					<ProtectedString name="Source"><![CDATA[-- Props: bebidas e comidas em 3D, bandeja, dinheiro na mesa, sujeira, balões e efeitos.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Models = require(ReplicatedStorage:WaitForChild("AdegaShared"):WaitForChild("Models"))

local Props = {}

Props.product = Models.product
Props.tray = Models.tray

local rgb = Color3.fromRGB
local v = Vector3.new
local M = Enum.Material
local part = Models.part
local CYLINDER = Models.CYLINDER
local UPRIGHT = Models.UPRIGHT

-- Dinheiro deixado na mesa.
function Props.money(cframe, amount)
	local model = Instance.new("Model")
	model.Name = "Dinheiro"
	local base = part(model, nil, v(1, 0.05, 0.6), cframe, rgb(60, 160, 80), M.SmoothPlastic, { Transparency = 1 })
	model.PrimaryPart = base
	local stacks = math.clamp(math.ceil(amount / 25), 1, 5)
	for i = 0, stacks - 1 do
		part(model, base, v(1, 0.12, 0.5), CFrame.new(0, 0.06 + i * 0.13, 0) * CFrame.Angles(0, math.rad(i * 14), 0), rgb(80, 180, 100), M.SmoothPlastic)
	end
	part(model, base, v(0.35, 0.08, 0.35), CFrame.new(0.55, 0.05, 0.3) * UPRIGHT, rgb(230, 190, 60), M.Metal, CYLINDER)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(110, 34)
	gui.StudsOffset = Vector3.new(0, 1.4, 0)
	gui.MaxDistance = 50
	gui.LightInfluence = 0
	gui.Parent = base
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = rgb(255, 255, 255)
	label.TextColor3 = rgb(30, 140, 70)
	label.FontFace = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
	label.TextScaled = true
	label.Text = "R$ " .. amount
	label.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.4, 0)
	corner.Parent = label
	return model, label
end

-- Copos vazios e latas amassadas depois que os clientes vão embora.
function Props.dirt(cframe, count)
	local model = Instance.new("Model")
	model.Name = "Sujeira"
	local base = part(model, nil, v(0.2, 0.05, 0.2), cframe, rgb(0, 0, 0), M.SmoothPlastic, { Transparency = 1 })
	model.PrimaryPart = base
	for i = 1, math.max(2, count) do
		local angle = i * 2.1
		local offset = CFrame.new(math.cos(angle) * 0.6, 0, math.sin(angle) * 0.6)
		if i % 2 == 0 then
			part(model, base, v(0.42, 0.42, 0.42), offset * CFrame.new(0, 0.22, 0) * CFrame.Angles(0, angle, math.rad(90)), rgb(170, 170, 176), M.Metal, CYLINDER)
		else
			part(model, base, v(0.6, 0.45, 0.45), offset * CFrame.new(0, 0.3, 0) * UPRIGHT, rgb(225, 230, 235), M.Glass, { Shape = Enum.PartType.Cylinder, Transparency = 0.45 })
		end
	end
	part(model, base, v(0.6, 0.02, 0.5), CFrame.new(-0.3, 0.01, -0.4), rgb(230, 220, 180), M.SmoothPlastic)
	return model
end

-- Balão em cima da cabeça ou da mesa ----------------------------------------------------------------

local FONT_HEAVY = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Heavy)
local INK = rgb(40, 34, 48)

local function productViewport(parent, product, size, order)
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromOffset(size, size)
	viewport.BackgroundTransparency = 1
	viewport.Ambient = rgb(200, 196, 210)
	viewport.LightColor = rgb(255, 250, 240)
	viewport.LightDirection = Vector3.new(-0.5, -1, -0.6)
	viewport.LayoutOrder = order or 0
	local model = Models.product(product, CFrame.new())
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	local center, extent = model:GetBoundingBox()
	local distance = extent.Magnitude / 2 / math.tan(math.rad(15)) * 1.05
	camera.CFrame = CFrame.lookAt(center.Position + Vector3.new(0.35, 0.45, -1).Unit * distance, center.Position)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	viewport.Parent = parent
	return viewport
end
Props.productViewport = productViewport

-- Balão: mode "text" (texto curto), "call" (cliente chamando) ou "products" (bebidas em 3D).
function Props.bubble(adornee, offsetY)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Balao"
	gui.Size = UDim2.fromOffset(64, 64)
	gui.StudsOffset = Vector3.new(0, offsetY or 2.8, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = adornee

	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = rgb(255, 255, 255)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 20)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = rgb(255, 255, 255)
	stroke.Thickness = 3
	stroke.Transparency = 0
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, -8)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.FontFace = FONT_HEAVY
	label.TextColor3 = INK
	label.Text = ""
	label.Parent = frame
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = label

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -12, 1, -14)
	row.Position = UDim2.fromOffset(6, 3)
	row.BackgroundTransparency = 1
	row.Visible = false
	row.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -18, 0, 6)
	track.Position = UDim2.new(0, 9, 1, -11)
	track.BackgroundColor3 = rgb(232, 228, 236)
	track.BorderSizePixel = 0
	track.Visible = false
	track.Parent = frame
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = rgb(52, 199, 89)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local bubble = { gui = gui }
	local shownKey = nil

	function bubble.text(text)
		row.Visible = false
		label.Visible = true
		label.Text = text
		label.TextColor3 = INK
		frame.BackgroundColor3 = rgb(255, 255, 255)
		stroke.Color = rgb(255, 255, 255)
		gui.Size = UDim2.fromOffset(64, 56)
		shownKey = nil
	end

	function bubble.call()
		row.Visible = false
		label.Visible = true
		label.Text = "!"
		label.TextColor3 = rgb(255, 255, 255)
		frame.BackgroundColor3 = rgb(255, 149, 0)
		stroke.Color = rgb(255, 255, 255)
		gui.Size = UDim2.fromOffset(58, 66)
		shownKey = nil
	end

	-- products = lista de produtos ainda não entregues
	function bubble.products(products)
		local ids = {}
		for _, product in products do
			table.insert(ids, product.id)
		end
		local key = table.concat(ids, ",")
		if key == shownKey then
			return
		end
		shownKey = key
		label.Visible = false
		row.Visible = true
		frame.BackgroundColor3 = rgb(255, 255, 255)
		stroke.Color = rgb(255, 255, 255)
		for _, child in row:GetChildren() do
			if child:IsA("ViewportFrame") then
				child:Destroy()
			end
		end
		for index, product in products do
			productViewport(row, product, 40, index)
		end
		gui.Size = UDim2.fromOffset(math.max(64, #products * 42 + 16), 62)
	end

	function bubble.bar(ratio)
		if ratio == nil then
			track.Visible = false
			return
		end
		track.Visible = true
		ratio = math.clamp(ratio, 0, 1)
		fill.Size = UDim2.fromScale(ratio, 1)
		fill.BackgroundColor3 = if ratio > 0.5 then rgb(52, 199, 89) elseif ratio > 0.25 then rgb(255, 179, 0) else rgb(255, 69, 58)
	end

	function bubble.destroy()
		gui:Destroy()
	end
	return bubble
end

local function anchorAt(position)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Position = position
	holder.Parent = workspace
	return holder
end

-- Texto que sobe e some (ganhos, emoções).
function Props.popup(position, text, color)
	local holder = anchorAt(position)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(150, 40)
	gui.StudsOffset = Vector3.new(0, 1, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.AlwaysOnTop = true
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.FontFace = FONT_HEAVY
	label.Text = text
	label.TextColor3 = color or rgb(110, 255, 140)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	TweenService:Create(gui, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 4.5, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(holder, 1.5)
end

function Props.sparkle(position, color)
	local holder = anchorAt(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color or rgb(255, 196, 40), rgb(255, 255, 255))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.4, 0.8)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(24)
	Debris:AddItem(holder, 1.5)
end

return Props
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000B">
				<Properties>
					<string name="Name">Restaurant</string>
					<ProtectedString name="Source"><![CDATA[-- Restaurant: clientes, pedidos e tudo que o jogador e a equipe fazem na adega.
--
-- Ciclo de uma mesa: o grupo chega e senta -> lê o cardápio -> chama (❗) -> alguém anota ->
-- cada bebida é preparada numa estação -> alguém entrega -> o grupo bebe e pode pedir outra rodada ->
-- vai embora deixando dinheiro e sujeira -> alguém pega o dinheiro e limpa a mesa.
-- No balcão: o cliente entra na fila, pede, recebe e paga na hora.
--
-- Estados de um item do pedido: new (ainda não anotado), pending (esperando preparo),
-- preparing (alguém da equipe preparando), ready (pronto num balcão ou estação),
-- carried (na mão de alguém), served (entregue) e cancelled (o cliente foi embora).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Rig = require(script.Parent.Rig)
local Props = require(script.Parent.Props)

local Restaurant = {}

local C = Config.Customer
local rgb = Color3.fromRGB
local formatMoney = Util.formatMoney

local function now()
	return os.clock()
end

local function randomIn(range)
	return range[1] + math.random() * (range[2] - range[1])
end

function Restaurant.nightFactor()
	local hour = Lighting.ClockTime
	if hour >= 18 or hour < 2 then
		return Config.NightBoost
	elseif hour < 6 then
		return Config.LateNightFactor
	end
	return 1
end

function Restaurant.staffCount(plot, role)
	local count = 0
	for _, staff in plot.staff or {} do
		if role == nil or staff.role.id == role then
			count += 1
		end
	end
	return count
end

-- Cardápio liberado: produtos cuja estação existe na adega e cujo nível já foi alcançado.
function Restaurant.menu(plot)
	local stations = {}
	for _, rec in plot.furniture do
		if rec.kind == "station" then
			stations[rec.id] = true
		end
	end
	local list = {}
	for _, product in Config.Products do
		if stations[product.station] and plot.level >= product.level then
			table.insert(list, product)
		end
	end
	return list
end

local function notify(plot, text, kind)
	local rt = plot.rt
	if rt and rt.callbacks.notify then
		rt.callbacks.notify(text, kind)
	end
end

local function notifyOnce(plot, key, text, kind, cooldown)
	local rt = plot.rt
	local last = rt.warnings[key]
	if last and now() - last < (cooldown or 45) then
		return
	end
	rt.warnings[key] = now()
	notify(plot, text, kind)
end

local function event(plot, name, amount)
	local rt = plot.rt
	if rt and rt.callbacks.event then
		rt.callbacks.event(name, amount or 1)
	end
end

local function markDirty(plot)
	if plot.rt then
		plot.rt.dirty = true
	end
end

-- Itens prontos --------------------------------------------------------------------------------------

local function relayoutReady(plot, place)
	local base = place.pickup or place.top
	for index, item in place.ready do
		if item.model then
			local slot = index - 1
			local offset = place.cframe:VectorToWorldSpace(Vector3.new((slot % 6) * 0.9, 0, -math.floor(slot / 6) * 0.9))
			item.model:PivotTo(CFrame.new(base + offset))
		end
	end
end

local function removeReady(plot, item)
	local place = item.place
	if place then
		local index = table.find(place.ready, item)
		if index then
			table.remove(place.ready, index)
		end
		relayoutReady(plot, place)
	end
	if item.model then
		item.model:Destroy()
		item.model = nil
	end
	item.place = nil
end

function Restaurant.putReady(plot, item, place)
	if item.state == "cancelled" or place.removed then
		return
	end
	item.state = "ready"
	item.actor = nil
	item.place = place
	table.insert(place.ready, item)
	item.model = Props.product(item.product, CFrame.new(place.pickup or place.top))
	item.model.Parent = plot.effectsFolder
	relayoutReady(plot, place)
	markDirty(plot)
end

-- Onde deixar um item pronto: o pedido do balcão vai para o próprio balcão; o da mesa vai para o
-- balcão mais perto da estação (ou fica na própria estação se não houver balcão).
function Restaurant.pickupPlaceFor(plot, item, station)
	local order = item.order
	if order.kind == "counter" and order.place and not order.place.removed then
		return order.place
	end
	local best, bestDistance = nil, math.huge
	for _, rec in plot.furniture do
		if (rec.kind == "counter" or rec.kind == "bar") and rec.staffPos then
			local distance = (rec.staffPos - station.use).Magnitude
			if distance < bestDistance then
				best, bestDistance = rec, distance
			end
		end
	end
	return best or station
end

-- Bandeja do jogador ---------------------------------------------------------------------------------

local function updateTray(plot)
	local player = plot.owner
	local character = player and player.Character
	if character == nil then
		return
	end
	local old = character:FindFirstChild("AdegaBandeja")
	if old then
		old:Destroy()
	end
	local carry = plot.rt.carry
	if #carry == 0 then
		return
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand == nil then
		return
	end
	local products = {}
	for _, item in carry do
		table.insert(products, item.product)
	end
	local tray = Props.tray(products)
	tray.Name = "AdegaBandeja"
	for _, part in tray:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.Massless = true
		end
	end
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = tray.PrimaryPart
	weld.C0 = if hand.Name == "RightHand" then CFrame.new(0, -0.15, -0.75) else CFrame.new(0, -1.05, -0.75)
	weld.Parent = tray.PrimaryPart
	tray.Parent = character
end
Restaurant.updateTray = updateTray

local function removeFromCarry(plot, item)
	local carry = plot.rt.carry
	local index = table.find(carry, item)
	if index then
		table.remove(carry, index)
		updateTray(plot)
	end
end

-- Quando o jogador morre ou sai, o que estava na bandeja volta para a fila de preparo.
function Restaurant.dropCarry(plot)
	local rt = plot.rt
	if rt == nil then
		return
	end
	for _, item in rt.carry do
		if item.state == "carried" then
			item.state = "pending"
			item.actor = nil
		end
	end
	table.clear(rt.carry)
	markDirty(plot)
end

-- Pedidos ----------------------------------------------------------------------------------------------

local function newOrder(plot, party)
	local rt = plot.rt
	local menu = Restaurant.menu(plot)
	local order = {
		id = rt.nextId,
		party = party,
		kind = party.kind,
		items = {},
		state = "waiting",
		createdAt = now(),
		place = party.table or party.counter,
	}
	rt.nextId += 1
	for _, member in party.members do
		local product = menu[math.random(1, #menu)]
		member.served = false
		table.insert(order.items, { id = rt.nextId, order = order, product = product, member = member, state = "new" })
		rt.nextId += 1
	end
	table.insert(rt.orders, order)
	markDirty(plot)
	return order
end

local function closeOrder(plot, order)
	local index = table.find(plot.rt.orders, order)
	if index then
		table.remove(plot.rt.orders, index)
	end
	markDirty(plot)
end

local function cancelOrder(plot, order)
	for _, item in order.items do
		if item.state == "ready" then
			removeReady(plot, item)
		elseif item.state == "carried" and item.actor == plot.rt.playerActor then
			removeFromCarry(plot, item)
		end
		if item.state ~= "served" then
			item.state = "cancelled"
		end
	end
	order.state = "cancelled"
	closeOrder(plot, order)
end

function Restaurant.takeOrder(plot, order, actor)
	if order.state ~= "waiting" then
		return false
	end
	order.state = "open"
	order.takenAt = now()
	order.claim = nil
	for _, item in order.items do
		item.state = "pending"
	end
	if actor.kind == "player" then
		event(plot, "takeOrder")
	end
	markDirty(plot)
	return true
end

local function orderComplete(order)
	for _, item in order.items do
		if item.state ~= "served" then
			return false
		end
	end
	return true
end

function Restaurant.deliver(plot, order, items, actor)
	local count = 0
	for _, item in items do
		if item.order == order and item.state ~= "cancelled" and item.state ~= "served" then
			item.state = "served"
			item.actor = nil
			local member = item.member
			member.served = true
			if member.rig and Rig.isAlive(member.rig) then
				Rig.hold(member.rig, Props.product(item.product, member.rig.root.CFrame))
			end
			count += 1
		end
	end
	if count > 0 then
		order.lastDeliveryAt = now()
		if actor.kind == "player" then
			event(plot, "deliver", 1)
		end
		local where = if order.place then (order.place.top or order.place.queue) else nil
		if where then
			Props.popup(where + Vector3.new(0, 2, 0), "Entregue!", rgb(110, 255, 140))
		end
	end
	if orderComplete(order) then
		order.state = "done"
		order.servedAt = now()
		closeOrder(plot, order)
	end
	markDirty(plot)
	return count
end

-- Busca de tarefas (usada pela equipe e pelos prompts) --------------------------------------------------

function Restaurant.claimOrderToTake(plot, kind, actor)
	local best = nil
	for _, order in plot.rt.orders do
		if order.state == "waiting" and order.kind == kind and order.claim == nil and order.party.ready then
			if best == nil or order.createdAt < best.createdAt then
				best = order
			end
		end
	end
	if best then
		best.claim = actor
	end
	return best
end

local function stationsFor(plot, product)
	local list = {}
	for _, rec in plot.furniture do
		if rec.kind == "station" and rec.id == product.station then
			table.insert(list, rec)
		end
	end
	return list
end

local function nearest(list, position)
	local best, bestDistance = nil, math.huge
	for _, rec in list do
		local distance = ((rec.use or rec.staffPos or rec.cframe.Position) - position).Magnitude
		if distance < bestDistance then
			best, bestDistance = rec, distance
		end
	end
	return best
end
Restaurant.nearest = nearest

-- Próximo item a preparar. filter(item) opcional.
function Restaurant.claimPendingItem(plot, actor, position, filter)
	local best = nil
	for _, order in plot.rt.orders do
		for _, item in order.items do
			if item.state == "pending" and (filter == nil or filter(item)) then
				if best == nil or (order.takenAt or 0) < (best.order.takenAt or 0) then
					best = item
				end
			end
		end
	end
	if best == nil then
		return nil, nil
	end
	local station = nearest(stationsFor(plot, best.product), position)
	if station == nil then
		return nil, nil
	end
	best.state = "preparing"
	best.actor = actor
	best.station = station
	markDirty(plot)
	return best, station
end

function Restaurant.releaseItem(plot, item)
	if item.state == "preparing" or item.state == "carried" then
		item.state = "pending"
		item.actor = nil
		item.station = nil
		markDirty(plot)
	end
end

-- Itens prontos de pedidos de mesa (ou de balcão, se kind = "counter"), do mesmo lugar.
function Restaurant.claimReadyBatch(plot, actor, kind, limit)
	local place = nil
	local batch = {}
	for _, rec in plot.furniture do
		if rec.ready and #rec.ready > 0 then
			for _, item in rec.ready do
				if item.order.kind == kind and item.claim == nil and item.state == "ready" then
					if place == nil then
						place = rec
					end
					if rec == place and #batch < limit then
						item.claim = actor
						table.insert(batch, item)
					end
				end
			end
		end
		if place then
			break
		end
	end
	return batch, place
end

function Restaurant.pickUp(plot, item, actor)
	if item.state ~= "ready" then
		return false
	end
	removeReady(plot, item)
	item.claim = nil
	item.state = "carried"
	item.actor = actor
	markDirty(plot)
	return true
end

function Restaurant.claimTable(plot, actor, need)
	local list = {}
	for _, rec in plot.furniture do
		if rec.host then
			local wants = (need == "money" and rec.money > 0 and rec.moneyClaim == nil)
				or (need == "dirty" and rec.status == "dirty" and rec.cleanClaim == nil)
			if wants then
				table.insert(list, rec)
			end
		end
	end
	local rec = list[1]
	if rec then
		if need == "money" then
			rec.moneyClaim = actor
		else
			rec.cleanClaim = actor
		end
	end
	return rec
end

function Restaurant.collectMoney(plot, rec, actor)
	rec.moneyClaim = nil
	if rec.money <= 0 then
		return 0
	end
	local amount = rec.money
	rec.money = 0
	if rec.moneyModel then
		rec.moneyModel:Destroy()
		rec.moneyModel = nil
	end
	plot.rt.callbacks.earn(amount, rec.top)
	if actor.kind == "player" then
		event(plot, "collect")
	end
	markDirty(plot)
	return amount
end

function Restaurant.clean(plot, rec, actor)
	rec.cleanClaim = nil
	if rec.status ~= "dirty" then
		return false
	end
	if rec.dirtModel then
		rec.dirtModel:Destroy()
		rec.dirtModel = nil
	end
	rec.status = "free"
	plot:relink()
	Props.sparkle(rec.top + Vector3.new(0, 0.5, 0), rgb(120, 200, 255))
	if actor.kind == "player" then
		event(plot, "clean")
	end
	markDirty(plot)
	return true
end

-- Libera tudo que um funcionário tinha reservado (quando é demitido ou some).
function Restaurant.releaseActor(plot, actor)
	local rt = plot.rt
	if rt == nil then
		return
	end
	for _, order in rt.orders do
		if order.claim == actor then
			order.claim = nil
		end
		for _, item in order.items do
			if item.actor == actor then
				Restaurant.releaseItem(plot, item)
			end
			if item.claim == actor then
				item.claim = nil
			end
		end
	end
	for _, rec in plot.furniture do
		if rec.moneyClaim == actor then
			rec.moneyClaim = nil
		end
		if rec.cleanClaim == actor then
			rec.cleanClaim = nil
		end
	end
end

-- Avaliações e pagamento -------------------------------------------------------------------------------

local function satisfactionOf(plot, party)
	local appeal = plot:appeal()
	local score = 68 + math.min(20, appeal * 0.45) + Restaurant.staffCount(plot, "seguranca") * 3 + Restaurant.staffCount(plot, "dj") * 2
	score -= party.waitPenalty
	return math.clamp(score, 0, 100)
end

local function starsFor(score)
	return math.clamp(math.floor(score / 20) + 1, 1, 5)
end

local function addReview(plot, stars, name)
	local rt = plot.rt
	local phrases = Config.Reviews[stars]
	table.insert(rt.reviews, 1, { stars = stars, text = phrases[math.random(1, #phrases)], name = name })
	while #rt.reviews > 20 do
		table.remove(rt.reviews)
	end
	table.insert(rt.ratings, stars)
	while #rt.ratings > 40 do
		table.remove(rt.ratings, 1)
	end
	if rt.callbacks.review then
		rt.callbacks.review(stars)
	end
	markDirty(plot)
end

function Restaurant.rating(plot)
	local rt = plot.rt
	if rt == nil or #rt.ratings == 0 then
		return 3
	end
	local sum = 0
	for _, stars in rt.ratings do
		sum += stars
	end
	return sum / #rt.ratings
end

local CUSTOMER_NAMES = { "Fernanda", "Lucas", "Ana", "Rafael", "Juliana", "Bruno", "Camila", "Diego", "Aline", "Mateus", "Priscila", "Gustavo", "Renata", "Thiago", "Bianca", "Leandro" }

-- Grupos ----------------------------------------------------------------------------------------------

local function newParty(plot, kind, size)
	local rt = plot.rt
	local party = {
		id = rt.nextId,
		kind = kind,
		members = {},
		state = "arriving",
		rounds = 0,
		waitPenalty = 0,
		session = rt.session,
		spent = 0,
		ready = false,
	}
	rt.nextId += 1
	local side = if math.random() < 0.5 then -1 else 1
	party.side = side
	for i = 1, size do
		local start = plot:sidewalkPoint(side) + Vector3.new(-side * (i - 1) * 2.2, 0, (i % 2) * 1.5)
		local rig = Rig.new(plot.peopleFolder, start, Vector3.new(-side, 0, 0), Rig.randomLook(), "Cliente")
		table.insert(party.members, { rig = rig, served = false })
	end
	table.insert(rt.parties, party)
	rt.present += size
	markDirty(plot)
	return party
end

local function alive(plot, party)
	return plot.rt ~= nil and plot.rt.session == party.session and not party.gone
end

local function setBubble(plot, party, text)
	if party.bubble == nil then
		local adornee = if party.table then party.table.topPart else party.members[1].rig.head
		if adornee == nil then
			return
		end
		party.bubble = Props.bubble(adornee, if party.table then 4 else 2.6)
	end
	if text == "!" then
		party.bubble.call()
	else
		party.bubble.text(text)
	end
end

local function clearBubble(party)
	if party.bubble then
		party.bubble.destroy()
		party.bubble = nil
	end
end

local function orderProducts(order)
	local list = {}
	for _, item in order.items do
		if item.state ~= "served" then
			table.insert(list, item.product)
		end
	end
	return list
end

-- Espera até condition() ser verdadeira, mostrando a paciência no balão. Devolve false se acabou a paciência.
local function waitWithPatience(plot, party, condition, patience, label)
	local started = now()
	while alive(plot, party) do
		if condition() then
			return true, now() - started
		end
		local elapsed = now() - started
		if elapsed > patience then
			return false, elapsed
		end
		if party.bubble then
			if label then
				party.bubble.products(label())
			end
			party.bubble.bar(1 - elapsed / patience)
		end
		task.wait(0.4)
	end
	return false, now() - started
end

local function leaveAll(plot, party, angry)
	party.gone = true
	local rt = plot.rt
	clearBubble(party)
	for index, member in party.members do
		local rig = member.rig
		task.spawn(function()
			if not Rig.isAlive(rig) then
				return
			end
			if angry then
				Props.popup(rig.root.Position + Vector3.new(0, 2.5, 0), "Que demora!", rgb(255, 110, 100))
			end
			if member.seat and member.seated then
				Rig.stand(rig, member.seat.pos, -member.seat.face)
			end
			task.wait((index - 1) * 0.4)
			Rig.walkTo(rig, plot:sidewalkPoint(party.side), C.walkSpeed, function()
				return rt.session == party.session
			end)
			Rig.destroy(rig)
		end)
	end
	local index = table.find(rt.parties, party)
	if index then
		table.remove(rt.parties, index)
	end
	rt.present -= #party.members
	markDirty(plot)
end

local function finishTable(plot, party, angry)
	local rec = party.table
	local order = party.order
	if order and order.state ~= "done" and order.state ~= "cancelled" then
		cancelOrder(plot, order)
	end
	local name = CUSTOMER_NAMES[math.random(1, #CUSTOMER_NAMES)]
	if party.spent > 0 then
		-- quem já bebeu paga o que consumiu, mesmo indo embora bravo (só que sem gorjeta)
		local score = if angry then 0 else satisfactionOf(plot, party)
		local tip = party.spent * (score / 100) ^ 2 * 0.3
		local total = math.floor(party.spent + tip + 0.5)
		rec.money += total
		if rec.moneyModel then
			rec.moneyModel:Destroy()
		end
		rec.moneyModel = Props.money(CFrame.new(rec.top + rec.cframe:VectorToWorldSpace(Vector3.new(0.6, 0, 0.5))), rec.money)
		rec.moneyModel.Parent = plot.effectsFolder
		addReview(plot, if angry then 2 else starsFor(score), name)
		plot.rt.served += #party.members
		event(plot, "served", #party.members)
	elseif angry then
		addReview(plot, 1, name)
	end
	if party.spent > 0 or party.rounds > 0 then
		rec.status = "dirty"
		if rec.dirtModel then
			rec.dirtModel:Destroy()
		end
		rec.dirtModel = Props.dirt(CFrame.new(rec.top), #party.members)
		rec.dirtModel.Parent = plot.effectsFolder
	else
		rec.status = "free"
	end
	rec.party = nil
	if rec.status == "free" then
		plot:relink()
	end
	leaveAll(plot, party, angry)
end

local function runTable(plot, party)
	local rec = party.table
	rec.status = "reserved"
	rec.party = party

	-- cada pessoa anda até a sua cadeira
	local arrived, failed = 0, false
	for index, member in party.members do
		local seat = rec.seats[index]
		member.seat = seat
		task.spawn(function()
			task.wait((index - 1) * 0.5)
			local ok = Rig.walkTo(member.rig, seat.pos, C.walkSpeed, function()
				return alive(plot, party)
			end)
			if ok and alive(plot, party) then
				Rig.sit(member.rig, seat.pos, seat.face, seat.height)
				member.seated = true
			else
				failed = true
			end
			arrived += 1
		end)
	end
	local deadline = now() + 70
	while arrived < #party.members and now() < deadline and alive(plot, party) do
		task.wait(0.3)
	end
	if not alive(plot, party) then
		return
	end
	if failed or arrived < #party.members then
		rec.unreachableUntil = now() + 40
		notifyOnce(plot, "mesa" .. rec.number, "Os clientes não conseguem chegar na Mesa " .. rec.number .. ". Deixe um caminho livre até ela.", "erro")
		rec.status = "free"
		rec.party = nil
		plot:relink()
		leaveAll(plot, party, false)
		return
	end
	rec.status = "occupied"

	while alive(plot, party) do
		party.state = "reading"
		setBubble(plot, party, "...")
		party.bubble.bar(nil)
		task.wait(randomIn(C.readMenu))
		if not alive(plot, party) then
			return
		end
		if #Restaurant.menu(plot) == 0 then
			notifyOnce(plot, "semcardapio", "Seu cardápio está vazio! Coloque uma Geladeira de cerveja no modo construção.", "erro")
			finishTable(plot, party, true)
			return
		end

		party.state = "waitingOrder"
		local order = newOrder(plot, party)
		party.order = order
		party.ready = true
		setBubble(plot, party, "!")
		local taken, waited = waitWithPatience(plot, party, function()
			return order.state ~= "waiting"
		end, C.patienceOrder, nil)
		if not alive(plot, party) then
			return
		end
		if not taken then
			finishTable(plot, party, true)
			return
		end
		party.waitPenalty += math.max(0, waited - 10) * 1.0

		party.state = "waitingFood"
		local served, waitedFood = waitWithPatience(plot, party, function()
			return order.state == "done"
		end, C.patienceDelivery, function()
			return orderProducts(order)
		end)
		if not alive(plot, party) then
			return
		end
		for _, item in order.items do
			if item.state == "served" then
				party.spent += item.product.price
			end
		end
		if not served then
			finishTable(plot, party, party.spent == 0)
			return
		end
		party.waitPenalty += math.max(0, waitedFood - 18) * 0.7
		party.rounds += 1

		party.state = "drinking"
		clearBubble(party)
		local finishAt = now() + randomIn(C.drinkTime)
		while now() < finishAt and alive(plot, party) do
			task.wait(math.random(30, 70) / 10)
			if math.random() < 0.35 and alive(plot, party) then
				local member = party.members[math.random(1, #party.members)]
				if Rig.isAlive(member.rig) then
					Props.popup(member.rig.head.Position + Vector3.new(0, 1.2, 0), Rig.pick({ "Saúde!", "Hahaha", "Que delícia!", "Top demais!", "Bora mais uma?", "Esse lugar é bom!" }), rgb(255, 255, 255))
				end
			end
		end
		if not alive(plot, party) then
			return
		end
		for _, member in party.members do
			Rig.drop(member.rig)
		end
		local score = satisfactionOf(plot, party)
		local again = party.rounds < C.maxRounds and math.random() < C.reorderChance * (score / 80)
		if not again then
			break
		end
	end
	if alive(plot, party) then
		finishTable(plot, party, false)
	end
end

local function counterSpot(rec, position)
	return rec.queue + rec.front * ((position - 1) * 2.6)
end

local function runCounter(plot, party)
	local rec = party.counter
	local member = party.members[1]
	local rig = member.rig
	table.insert(rec.line, party)
	local function leaveLine()
		local index = table.find(rec.line, party)
		if index then
			table.remove(rec.line, index)
		end
	end
	local function check()
		return alive(plot, party) and not rec.removed
	end

	local spot = 0
	local joinedAt = now()
	while check() do
		local position = table.find(rec.line, party)
		if position == nil then
			break
		end
		if position ~= spot then
			spot = position
			if not Rig.walkTo(rig, counterSpot(rec, position), C.walkSpeed, check) then
				leaveLine()
				leaveAll(plot, party, false)
				return
			end
			Rig.face(rig, -rec.front)
		end
		if position == 1 then
			break
		end
		if now() - joinedAt > 120 then
			leaveLine()
			addReview(plot, 1, CUSTOMER_NAMES[math.random(1, #CUSTOMER_NAMES)])
			leaveAll(plot, party, true)
			return
		end
		task.wait(0.3)
	end
	if not check() then
		leaveLine()
		if alive(plot, party) then
			leaveAll(plot, party, false)
		end
		return
	end

	if #Restaurant.menu(plot) == 0 then
		leaveLine()
		leaveAll(plot, party, true)
		return
	end
	local order = newOrder(plot, party)
	party.order = order
	party.ready = true
	party.state = "waitingOrder"
	setBubble(plot, party, "!")
	member.prompt = Instance.new("ProximityPrompt")
	member.prompt.ObjectText = "Cliente do balcão"
	member.prompt.ActionText = "Anotar pedido"
	member.prompt.HoldDuration = 0.3
	member.prompt.MaxActivationDistance = 9
	member.prompt.RequiresLineOfSight = false
	member.prompt.Parent = rig.root
	member.prompt.Triggered:Connect(function(player)
		if player == plot.owner then
			Restaurant.playerCounterCustomer(plot, party)
		end
	end)
	party.prompt = member.prompt

	local taken, waited = waitWithPatience(plot, party, function()
		return order.state ~= "waiting"
	end, C.patienceOrder, nil)
	local served, waitedFood = false, 0
	if taken and alive(plot, party) then
		party.waitPenalty += math.max(0, waited - 10)
		party.state = "waitingFood"
		served, waitedFood = waitWithPatience(plot, party, function()
			return order.state == "done"
		end, C.patienceDelivery, function()
			return orderProducts(order)
		end)
		party.waitPenalty += math.max(0, waitedFood - 15) * 0.7
	end
	leaveLine()
	if member.prompt then
		member.prompt:Destroy()
		member.prompt = nil
	end
	if not alive(plot, party) then
		return
	end
	local name = CUSTOMER_NAMES[math.random(1, #CUSTOMER_NAMES)]
	if served then
		local score = satisfactionOf(plot, party)
		local price = order.items[1].product.price
		local total = math.floor(price * (1 + (score / 100) ^ 2 * 0.25) + 0.5)
		plot.rt.callbacks.earn(total, rig.root.Position)
		addReview(plot, starsFor(score), name)
		plot.rt.served += 1
		event(plot, "served", 1)
		leaveAll(plot, party, false)
	else
		if order.state ~= "cancelled" then
			cancelOrder(plot, order)
		end
		addReview(plot, 1, name)
		leaveAll(plot, party, true)
	end
end

-- Chegada de clientes ------------------------------------------------------------------------------

local function chooseSize(maxSize)
	local weights = C.partyWeights
	local total = 0
	for size = 1, maxSize do
		total += weights[size]
	end
	local roll = math.random() * total
	for size = 1, maxSize do
		roll -= weights[size]
		if roll <= 0 then
			return size
		end
	end
	return 1
end

function Restaurant.groupsPerMinute(plot)
	local rating = Restaurant.rating(plot)
	local base = C.baseGroupsPerMinute + plot:appeal() * 0.035 + plot.level * 0.12
	local staffBonus = 1 + Restaurant.staffCount(plot, "seguranca") * 0.05 + Restaurant.staffCount(plot, "dj") * 0.2
	return base * (0.55 + rating * 0.13) * Restaurant.nightFactor() * staffBonus
end

local function trySpawn(plot)
	local rt = plot.rt
	if rt.present >= C.maxPerPlot then
		return
	end
	if #Restaurant.menu(plot) == 0 then
		notifyOnce(plot, "semcardapio", "Seu cardápio está vazio! Coloque uma Geladeira de cerveja no modo construção.", "erro", 60)
		return
	end
	local tables, counters = {}, {}
	for _, rec in plot.furniture do
		if rec.host and rec.status == "free" and #rec.seats > 0 and (rec.unreachableUntil or 0) < now() then
			table.insert(tables, rec)
		elseif rec.kind == "counter" and #rec.line < 4 then
			table.insert(counters, rec)
		end
	end
	local useCounter = #counters > 0 and (#tables == 0 or math.random() < C.counterChance)
	if useCounter then
		local party = newParty(plot, "counter", 1)
		party.counter = counters[math.random(1, #counters)]
		task.spawn(runCounter, plot, party)
	elseif #tables > 0 then
		local rec = tables[math.random(1, #tables)]
		local size = chooseSize(math.min(4, #rec.seats))
		local party = newParty(plot, "table", size)
		party.table = rec
		rec.status = "reserved"
		task.spawn(runTable, plot, party)
	end
end

-- Prompts do jogador --------------------------------------------------------------------------------

local function carriedFor(plot, order)
	local list = {}
	for _, item in plot.rt.carry do
		if item.order == order then
			table.insert(list, item)
		end
	end
	return list
end

local function tableAction(plot, rec)
	local party = rec.party
	local order = party and party.order
	if order and order.state == "open" and #carriedFor(plot, order) > 0 then
		return "deliver", "Entregar pedido", 0
	end
	if order and order.state == "waiting" and party.ready then
		return "take", "Anotar pedido", 0.35
	end
	if rec.money > 0 then
		return "money", "Pegar " .. formatMoney(rec.money), 0
	end
	if rec.status == "dirty" then
		return "clean", "Limpar mesa", 1
	end
	return nil, nil, 0
end

local function nextPendingFor(plot, station)
	local best = nil
	for _, order in plot.rt.orders do
		for _, item in order.items do
			if item.state == "pending" and item.product.station == station.id then
				if best == nil or (order.takenAt or 0) < (best.order.takenAt or 0) then
					best = item
				end
			end
		end
	end
	return best
end

local function placeLabel(order)
	if order.kind == "counter" then
		return "Caixa"
	end
	local place = order.place
	if place and place.kind == "bar" then
		return "Balcão " .. place.number
	end
	return "Mesa " .. (place and place.number or "?")
end

function Restaurant.playerTable(plot, rec)
	local action = tableAction(plot, rec)
	local actor = plot.rt.playerActor
	if action == "deliver" then
		local order = rec.party.order
		local items = carriedFor(plot, order)
		for _, item in items do
			removeFromCarry(plot, item)
		end
		Restaurant.deliver(plot, order, items, actor)
	elseif action == "take" then
		if Restaurant.takeOrder(plot, rec.party.order, actor) then
			Props.popup(rec.top + Vector3.new(0, 2, 0), "Pedido anotado", rgb(255, 255, 255))
		end
	elseif action == "money" then
		Restaurant.collectMoney(plot, rec, actor)
	elseif action == "clean" then
		if rec.money > 0 then
			Restaurant.collectMoney(plot, rec, actor)
		end
		Restaurant.clean(plot, rec, actor)
	end
	markDirty(plot)
end

function Restaurant.playerCounterCustomer(plot, party)
	local order = party.order
	if order == nil then
		return
	end
	local actor = plot.rt.playerActor
	if order.state == "waiting" then
		Restaurant.takeOrder(plot, order, actor)
	elseif order.state == "open" then
		local items = carriedFor(plot, order)
		for _, item in items do
			removeFromCarry(plot, item)
		end
		if #items > 0 then
			Restaurant.deliver(plot, order, items, actor)
		end
	end
end

function Restaurant.playerPrepare(plot, station)
	local rt = plot.rt
	if #rt.carry >= Config.CarryLimit then
		notifyOnce(plot, "bandeja", "Sua bandeja está cheia. Entregue os pedidos primeiro.", "erro", 4)
		return
	end
	local item = nextPendingFor(plot, station)
	if item == nil then
		return
	end
	item.state = "carried"
	item.actor = rt.playerActor
	table.insert(rt.carry, item)
	updateTray(plot)
	Props.popup(station.use + Vector3.new(0, 5, 0), item.product.name, rgb(255, 255, 255))
	event(plot, "prepare")
	markDirty(plot)
end

function Restaurant.playerPickup(plot, place)
	local rt = plot.rt
	local picked = 0
	for _, item in table.clone(place.ready) do
		if #rt.carry >= Config.CarryLimit then
			break
		end
		if item.claim == nil and Restaurant.pickUp(plot, item, rt.playerActor) then
			table.insert(rt.carry, item)
			picked += 1
		end
	end
	if picked > 0 then
		updateTray(plot)
	elseif #rt.carry >= Config.CarryLimit then
		notifyOnce(plot, "bandeja", "Sua bandeja está cheia. Entregue os pedidos primeiro.", "erro", 4)
	end
end

local function newPrompt(part, key, holdDuration)
	local prompt = Instance.new("ProximityPrompt")
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = holdDuration or 0
	prompt.KeyboardKeyCode = key or Enum.KeyCode.E
	prompt.Enabled = false
	prompt.Parent = part
	return prompt
end

function Restaurant.attach(plot, rec)
	if rec.host then
		rec.prompt = newPrompt(rec.topPart)
		rec.prompt.ObjectText = (if rec.kind == "bar" then "Balcão " else "Mesa ") .. rec.number
		rec.prompt.Triggered:Connect(function(player)
			if player == plot.owner and plot.rt then
				Restaurant.playerTable(plot, rec)
			end
		end)
		if rec.kind == "bar" then
			rec.pickupPrompt = newPrompt(rec.topPart, Enum.KeyCode.F)
			rec.pickupPrompt.UIOffset = Vector2.new(0, 80)
			rec.pickupPrompt.Triggered:Connect(function(player)
				if player == plot.owner and plot.rt then
					Restaurant.playerPickup(plot, rec)
				end
			end)
		end
	elseif rec.kind == "station" then
		rec.prompt = newPrompt(rec.part)
		rec.prompt.Triggered:Connect(function(player)
			if player == plot.owner and plot.rt then
				Restaurant.playerPrepare(plot, rec)
			end
		end)
		rec.pickupPrompt = newPrompt(rec.part, Enum.KeyCode.F)
		rec.pickupPrompt.UIOffset = Vector2.new(0, 80)
		rec.pickupPrompt.Triggered:Connect(function(player)
			if player == plot.owner and plot.rt then
				Restaurant.playerPickup(plot, rec)
			end
		end)
	elseif rec.kind == "counter" then
		rec.pickupPrompt = newPrompt(rec.part, Enum.KeyCode.F)
		rec.pickupPrompt.Triggered:Connect(function(player)
			if player == plot.owner and plot.rt then
				Restaurant.playerPickup(plot, rec)
			end
		end)
	end
	markDirty(plot)
end

function Restaurant.detach(plot, rec)
	if rec.ready then
		for _, item in table.clone(rec.ready) do
			removeReady(plot, item)
			item.state = "pending"
		end
	end
	if rec.moneyModel then
		rec.moneyModel:Destroy()
	end
	if rec.dirtModel then
		rec.dirtModel:Destroy()
	end
	markDirty(plot)
end

function Restaurant.canModify(plot, rec)
	if rec.host and (rec.status ~= "free" or rec.money > 0) then
		return false, "A mesa " .. rec.number .. " está em uso. Espere ela ficar livre e limpa."
	end
	local host = rec.attached
	if rec.kind == "chair" and host and not host.removed and (host.status ~= "free" or host.money > 0) then
		return false, "Essa cadeira é da mesa " .. host.number .. ", que está em uso."
	end
	if rec.ready and #rec.ready > 0 then
		return false, "Tem pedido pronto em cima. Pegue antes de mexer."
	end
	if rec.kind == "counter" and #rec.line > 0 then
		return false, "Tem cliente na fila desse balcão."
	end
	if plot.rt then
		for _, order in plot.rt.orders do
			for _, item in order.items do
				if item.state == "preparing" and item.station == rec then
					return false, "Alguém está usando essa estação."
				end
			end
		end
	end
	return true, nil
end

local function refreshPrompts(plot)
	local rt = plot.rt
	for _, rec in plot.furniture do
		if rec.host and rec.prompt then
			local action, text, hold = tableAction(plot, rec)
			rec.prompt.Enabled = action ~= nil
			if action then
				rec.prompt.ActionText = text
				rec.prompt.HoldDuration = hold
			end
			if rec.pickupPrompt then
				local ready = #rec.ready
				rec.pickupPrompt.Enabled = ready > 0
				rec.pickupPrompt.ActionText = "Pegar pedidos prontos (" .. ready .. ")"
				rec.pickupPrompt.ObjectText = "Balcão " .. rec.number
			end
		elseif rec.kind == "station" and rec.prompt then
			local item = nextPendingFor(plot, rec)
			rec.prompt.Enabled = item ~= nil and #rt.carry < Config.CarryLimit
			if item then
				rec.prompt.ActionText = "Preparar " .. item.product.name
				rec.prompt.ObjectText = placeLabel(item.order)
				rec.prompt.HoldDuration = item.product.prep
			end
			local ready = #rec.ready
			rec.pickupPrompt.Enabled = ready > 0
			rec.pickupPrompt.ActionText = "Pegar pedidos prontos (" .. ready .. ")"
			rec.pickupPrompt.ObjectText = rec.item.name
		elseif rec.kind == "counter" and rec.pickupPrompt then
			local ready = #rec.ready
			rec.pickupPrompt.Enabled = ready > 0
			rec.pickupPrompt.ActionText = "Pegar pedidos prontos (" .. ready .. ")"
			rec.pickupPrompt.ObjectText = "Balcão"
		end
	end
	for _, party in rt.parties do
		if party.prompt and party.order then
			local order = party.order
			if order.state == "waiting" then
				party.prompt.Enabled = true
				party.prompt.ActionText = "Anotar pedido"
			elseif order.state == "open" and #carriedFor(plot, order) > 0 then
				party.prompt.Enabled = true
				party.prompt.ActionText = "Entregar " .. order.items[1].product.name
			else
				party.prompt.Enabled = false
			end
		end
	end
end

-- Ciclo de vida -------------------------------------------------------------------------------------

function Restaurant.setup(plot, callbacks, saved)
	plot.sessionCounter = (plot.sessionCounter or 0) + 1
	plot.rt = {
		session = plot.sessionCounter,
		parties = {},
		orders = {},
		carry = {},
		nextId = 1,
		present = 0,
		served = 0,
		reviews = {},
		ratings = {},
		warnings = {},
		callbacks = callbacks,
		nextSpawn = now() + 4,
		dirty = true,
		playerActor = { kind = "player", name = plot.owner.DisplayName },
	}
	if saved and type(saved.ratings) == "table" then
		for _, stars in saved.ratings do
			if type(stars) == "number" then
				table.insert(plot.rt.ratings, math.clamp(math.floor(stars), 1, 5))
			end
		end
	end
	plot.hooks.added = Restaurant.attach
	plot.hooks.removed = Restaurant.detach
	plot.hooks.canModify = Restaurant.canModify
	for _, rec in plot.furniture do
		Restaurant.attach(plot, rec)
	end
end

function Restaurant.teardown(plot)
	plot.rt = nil
	plot.hooks = {}
end

function Restaurant.tick(plot)
	local rt = plot.rt
	if rt == nil then
		return
	end
	if now() >= rt.nextSpawn then
		local rate = Restaurant.groupsPerMinute(plot)
		rt.nextSpawn = now() + (60 / rate) * (0.6 + math.random() * 0.8)
		trySpawn(plot)
	end
	refreshPrompts(plot)
end

-- Resumo para a interface.
function Restaurant.snapshot(plot)
	local rt = plot.rt
	local orders = {}
	for _, order in rt.orders do
		local icons = {}
		for _, item in order.items do
			table.insert(icons, { item.product.id, item.state })
		end
		local started = order.takenAt or order.createdAt
		local patience = if order.state == "waiting" then C.patienceOrder else C.patienceDelivery
		table.insert(orders, {
			label = placeLabel(order),
			state = order.state,
			icons = icons,
			wait = math.floor(now() - started),
			patience = math.clamp(1 - (now() - started) / patience, 0, 1),
		})
		if #orders >= 12 then
			break
		end
	end
	local carry = {}
	for _, item in rt.carry do
		table.insert(carry, { item.product.id, placeLabel(item.order) })
	end
	local free, dirty, money = 0, 0, 0
	for _, rec in plot.furniture do
		if rec.host and (#rec.seats > 0 or rec.status ~= "free") then
			if rec.status == "free" then
				free += 1
			elseif rec.status == "dirty" then
				dirty += 1
			end
			money += rec.money
		end
	end
	local menu = {}
	for _, product in Restaurant.menu(plot) do
		table.insert(menu, product.id)
	end
	return {
		orders = orders,
		carry = carry,
		present = rt.present,
		freeTables = free,
		dirtyTables = dirty,
		tableMoney = money,
		rating = Restaurant.rating(plot),
		reviews = rt.reviews,
		menu = menu,
		groupsPerMinute = Restaurant.groupsPerMinute(plot),
		night = Restaurant.nightFactor(),
	}
end

return Restaurant
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000C">
				<Properties>
					<string name="Name">Rig</string>
					<ProtectedString name="Source"><![CDATA[-- Rig: bonecos dos clientes e funcionários.
-- Usa avatares R15 com as animações padrão do Roblox. Se não der para criar o avatar,
-- cai para um boneco de blocos animado por solda. O corpo fica ancorado e é movido com
-- TweenService ao longo de caminhos calculados pelo PathfindingService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PathfindingService = game:GetService("PathfindingService")
local TweenService = game:GetService("TweenService")

local Looks = require(ReplicatedStorage:WaitForChild("AdegaShared"):WaitForChild("Looks"))

local Rig = {}

local rgb = Color3.fromRGB

local ANIMATIONS = {
	walk = "rbxassetid://507777826",
	idle = "rbxassetid://507766388",
	sit = "rbxassetid://2506281703",
}

local function pick(list)
	return list[math.random(1, #list)]
end
Rig.pick = pick

function Rig.randomLook()
	return Looks.random()
end

-- Avatar R15 base, criado uma vez e clonado para cada boneco ----------------------------------

local template = nil
local templateTried = false
local templateLoading = false

local function getTemplate()
	-- quem pedir enquanto o avatar base ainda está sendo criado espera por ele
	while templateLoading do
		task.wait(0.1)
	end
	if templateTried then
		return template
	end
	templateTried = true
	templateLoading = true
	local ok, result = pcall(function()
		local description = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if ok and result and result:FindFirstChild("HumanoidRootPart") then
		template = result
		for _, item in template:GetDescendants() do
			if item:IsA("BodyColors") or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("Accessory") then
				item:Destroy()
			end
		end
		local humanoid = template:FindFirstChildOfClass("Humanoid")
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		if humanoid:FindFirstChildOfClass("Animator") == nil then
			Instance.new("Animator").Parent = humanoid
		end
		for _, part in template:GetDescendants() do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.Massless = true
			end
		end
		template.HumanoidRootPart.Anchored = true
		template.HumanoidRootPart.Transparency = 1
		-- cópia para a interface mostrar retratos e a prévia da personalização
		local copy = template:Clone()
		copy.Name = "BonecoModelo"
		copy.Parent = ReplicatedStorage:WaitForChild("AdegaShared")
	else
		warn("[Adega] Não deu para criar avatares R15, usando bonecos de blocos:", result)
	end
	templateLoading = false
	return template
end
Rig.preload = getTemplate

local function weld(part0, part1, c0)
	part1.Anchored = false
	part1.Massless = true
	part1.CanCollide = false
	part1.CanQuery = false
	part1.CanTouch = false
	local w = Instance.new("Weld")
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = c0
	w.Parent = part1
	return w
end

local function newPart(name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end
Rig.newPart = newPart
Rig.weld = weld

-- Boneco de blocos (plano B) ---------------------------------------------------------------------

local LIMBS = {
	LeftArm = { pivot = Vector3.new(-1.5, 0.5, 0), hang = Vector3.new(0, -0.5, 0) },
	RightArm = { pivot = Vector3.new(1.5, 0.5, 0), hang = Vector3.new(0, -0.5, 0) },
	LeftLeg = { pivot = Vector3.new(-0.5, -1, 0), hang = Vector3.new(0, -1, 0) },
	RightLeg = { pivot = Vector3.new(0.5, -1, 0), hang = Vector3.new(0, -1, 0) },
}

local function limbC0(name, angle)
	local def = LIMBS[name]
	return CFrame.new(def.pivot) * CFrame.Angles(angle, 0, 0) * CFrame.new(def.hang)
end

local function buildBlocky(model)
	local white = rgb(240, 240, 240)
	local root = newPart("HumanoidRootPart", Vector3.new(2, 2, 1), white)
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Parent = model
	local head = newPart("Head", Vector3.new(1.2, 1.2, 1.2), white)
	weld(root, head, CFrame.new(0, 1.6, 0))
	local face = Instance.new("Decal")
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head
	head.Parent = model
	local welds = {}
	for name in LIMBS do
		local isArm = name == "LeftArm" or name == "RightArm"
		local limb = newPart(name, Vector3.new(1, 2, 1), white)
		welds[name] = weld(root, limb, limbC0(name, 0))
		limb.Parent = model
		if isArm then
			local sleeve = newPart("Manga", Vector3.new(1.05, 0.8, 1.05), white)
			weld(limb, sleeve, CFrame.new(0, 0.62, 0))
			sleeve.Parent = model
		end
	end
	return root, head, welds
end

-- API --------------------------------------------------------------------------------------------

-- Cria um boneco em pé em `feet` (posição do chão), olhando para `lookDir`.
function Rig.new(parent, feet, lookDir, look, name)
	local base = getTemplate()
	local model
	local rig = { look = look, pose = nil, tracks = {}, alive = true }

	if base then
		model = base:Clone()
		rig.root = model.HumanoidRootPart
		rig.head = model:FindFirstChild("Head")
		rig.hand = model:FindFirstChild("RightHand")
		rig.humanoid = model:FindFirstChildOfClass("Humanoid")
		rig.standOffset = rig.humanoid.HipHeight + rig.root.Size.Y / 2
		rig.sitOffset = rig.root.Size.Y / 2 + 0.55
		rig.isR15 = true
	else
		model = Instance.new("Model")
		local root, head, welds = buildBlocky(model)
		rig.root = root
		rig.head = head
		rig.welds = welds
		rig.hand = welds.RightArm.Part1
		rig.standOffset = 3.05
		rig.sitOffset = 1.5
		rig.isR15 = false
		rig.anims = {}
	end
	model.Name = name or "Cliente"
	model.PrimaryPart = rig.root
	rig.model = model
	model:SetAttribute("Blocos", not rig.isR15)
	Looks.apply(model, look)

	rig.root.CFrame = CFrame.lookAt(feet + Vector3.new(0, rig.standOffset, 0), feet + Vector3.new(lookDir.X, rig.standOffset, lookDir.Z))
	model.Parent = parent

	if rig.isR15 then
		local animator = rig.humanoid:FindFirstChildOfClass("Animator")
		for key, id in ANIMATIONS do
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			local ok, track = pcall(function()
				return animator:LoadAnimation(animation)
			end)
			if ok and track then
				track.Looped = true
				track.Priority = if key == "idle" then Enum.AnimationPriority.Idle else Enum.AnimationPriority.Movement
				rig.tracks[key] = track
			end
		end
	end
	Rig.setPose(rig, "idle")
	return rig
end

function Rig.isAlive(rig)
	return rig.alive and rig.model.Parent ~= nil
end

function Rig.destroy(rig)
	rig.alive = false
	rig.model:Destroy()
end

function Rig.feet(rig)
	return rig.root.Position - Vector3.new(0, rig.standOffset, 0)
end

local function setBlockyPose(rig, pose)
	for _, tween in rig.anims do
		tween:Cancel()
	end
	table.clear(rig.anims)
	for name, w in rig.welds do
		if name == "RightArm" and rig.held then
			continue
		end
		if pose == "walk" then
			local sign = if name == "LeftLeg" or name == "RightArm" then 1 else -1
			w.C0 = limbC0(name, math.rad(28) * sign)
			local tween = TweenService:Create(w, TweenInfo.new(0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { C0 = limbC0(name, math.rad(-28) * sign) })
			tween:Play()
			table.insert(rig.anims, tween)
		elseif pose == "sit" and (name == "LeftLeg" or name == "RightLeg") then
			w.C0 = limbC0(name, math.rad(90))
		else
			w.C0 = limbC0(name, 0)
		end
	end
end

function Rig.setPose(rig, pose)
	if rig.pose == pose then
		return
	end
	rig.pose = pose
	if rig.isR15 then
		for key, track in rig.tracks do
			if key == pose then
				if not track.IsPlaying then
					track:Play(0.15)
				end
			elseif track.IsPlaying then
				track:Stop(0.15)
			end
		end
	else
		setBlockyPose(rig, pose)
	end
end

function Rig.face(rig, direction)
	local position = rig.root.Position
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude > 0.01 then
		rig.root.CFrame = CFrame.lookAt(position, position + flat)
	end
end

function Rig.sit(rig, seatPosition, faceDir, seatHeight)
	local position = seatPosition + Vector3.new(0, seatHeight + rig.sitOffset, 0)
	rig.root.CFrame = CFrame.lookAt(position, position + Vector3.new(faceDir.X, 0, faceDir.Z))
	Rig.setPose(rig, "sit")
end

function Rig.stand(rig, feet, faceDir)
	local position = feet + Vector3.new(0, rig.standOffset, 0)
	rig.root.CFrame = CFrame.lookAt(position, position + Vector3.new(faceDir.X, 0, faceDir.Z))
	Rig.setPose(rig, "idle")
end

-- Segura um modelo (bebida, bandeja) na mão direita.
function Rig.hold(rig, model)
	Rig.drop(rig)
	if model == nil or rig.hand == nil then
		return
	end
	local offset = if rig.isR15 then CFrame.new(0, -0.35, -0.45) else CFrame.new(0, -1.1, -0.35)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
		end
	end
	local primary = model.PrimaryPart
	local w = Instance.new("Weld")
	w.Part0 = rig.hand
	w.Part1 = primary
	w.C0 = offset
	w.Parent = primary
	model.Parent = rig.model
	rig.held = model
	if not rig.isR15 then
		rig.welds.RightArm.C0 = limbC0("RightArm", math.rad(55))
	end
end

function Rig.drop(rig)
	if rig.held then
		rig.held:Destroy()
		rig.held = nil
	end
end

-- Caminhos ----------------------------------------------------------------------------------------

local AGENT = { AgentRadius = 1.2, AgentHeight = 5, AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 5 }
local OFFSETS = {}
for i = 0, 7 do
	local angle = i * math.pi / 4
	table.insert(OFFSETS, Vector3.new(math.cos(angle), 0, math.sin(angle)))
end

local function compute(from, to)
	local path = PathfindingService:CreatePath(AGENT)
	local ok = pcall(function()
		path:ComputeAsync(from, to)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		return path:GetWaypoints()
	end
	return nil
end

-- Acha um caminho do ponto `from` até `to`. Se o destino ou a saída estiverem colados num
-- móvel, tenta pontos vizinhos e completa o trecho final em linha reta.
function Rig.findPath(from, to)
	local points = compute(from, to)
	if points then
		return points, nil, nil
	end
	local starts = { from }
	for _, offset in OFFSETS do
		table.insert(starts, from + offset * 2.6)
	end
	local goals = { to }
	for _, radius in { 2, 3.2 } do
		for _, offset in OFFSETS do
			table.insert(goals, to + offset * radius)
		end
	end
	-- 1) destino ao lado do original
	for gi = 2, #goals do
		local found = compute(from, goals[gi])
		if found then
			return found, nil, to
		end
	end
	-- 2) saída ao lado da original (quem está sentado colado na mesa)
	for si = 2, #starts do
		local found = compute(starts[si], to)
		if found then
			return found, starts[si], nil
		end
	end
	-- 3) os dois ajustados, só com os vizinhos mais próximos
	for si = 2, #starts, 2 do
		for gi = 2, 9, 2 do
			local found = compute(starts[si], goals[gi])
			if found then
				return found, starts[si], to
			end
		end
	end
	return nil, nil, nil
end

local lastNoPathWarning = 0
local function warnNoPath(from, to)
	if os.clock() - lastNoPathWarning > 30 then
		lastNoPathWarning = os.clock()
		warn(string.format("[Adega] Sem caminho livre de (%.0f, %.0f) até (%.0f, %.0f); o boneco foi em linha reta. Deixe corredores mais largos entre os móveis.", from.X, from.Z, to.X, to.Z))
	end
end

local function stepTo(rig, target, speed)
	local from = rig.root.Position
	local destination = target + Vector3.new(0, rig.standOffset, 0)
	local flat = Vector3.new(destination.X - from.X, 0, destination.Z - from.Z)
	local distance = (destination - from).Magnitude
	if distance < 0.15 then
		return
	end
	local look = if flat.Magnitude > 0.05 then CFrame.lookAt(from, from + flat) else rig.root.CFrame
	rig.root.CFrame = look
	local duration = distance / speed
	TweenService:Create(rig.root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = look.Rotation + destination }):Play()
	task.wait(duration)
end

-- Anda até `target` (posição do chão). Devolve true se chegou.
-- Com approach = true, para ao lado do destino quando ele está dentro de um móvel (uma mesa).
function Rig.walkTo(rig, target, speed, alive, approach)
	alive = alive or function()
		return true
	end
	local from = Rig.feet(rig)
	if (from - target).Magnitude < 0.3 then
		return true
	end
	local waypoints, startFix, endFix = Rig.findPath(from, target)
	if waypoints == nil then
		-- Sem caminho (móveis apertados demais): vai em linha reta para não travar a adega.
		warnNoPath(from, target)
		Rig.setPose(rig, "walk")
		stepTo(rig, target, speed)
		if Rig.isAlive(rig) then
			Rig.setPose(rig, "idle")
		end
		return Rig.isAlive(rig) and alive()
	end
	if approach then
		endFix = nil
	end
	Rig.setPose(rig, "walk")
	if rig.tracks.walk then
		rig.tracks.walk:AdjustSpeed(speed / 12)
	end
	if startFix then
		stepTo(rig, startFix, speed)
	end
	for index, waypoint in waypoints do
		if not (Rig.isAlive(rig) and alive()) then
			break
		end
		if index > 1 or (waypoint.Position - Rig.feet(rig)).Magnitude > 0.5 then
			stepTo(rig, waypoint.Position, speed)
		end
	end
	if endFix and Rig.isAlive(rig) and alive() then
		stepTo(rig, endFix, speed)
	end
	if Rig.isAlive(rig) then
		Rig.setPose(rig, "idle")
	end
	return Rig.isAlive(rig) and alive()
end

-- Anda em linha reta, sem calcular caminho (trechos curtos, como sentar e levantar).
function Rig.slide(rig, target, speed)
	Rig.setPose(rig, "walk")
	stepTo(rig, target, speed)
	Rig.setPose(rig, "idle")
end

return Rig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000000D">
				<Properties>
					<string name="Name">Staff</string>
					<ProtectedString name="Source"><![CDATA[-- Staff: os funcionários. Cada um roda um laço que procura trabalho da sua função,
-- vai até o lugar, faz a tarefa e volta para o ponto de espera.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared")
local Config = require(Shared.Config)
local Looks = require(Shared.Looks)

local Rig = require(script.Parent.Rig)
local Props = require(script.Parent.Props)
local Restaurant = require(script.Parent.Restaurant)

local Staff = {}

local rgb = Color3.fromRGB

local function alive(staff)
	local plot = staff.plot
	return not staff.fired and plot.rt ~= nil and plot.rt.session == staff.session and Rig.isAlive(staff.rig)
end

local function speedOf(staff)
	return Config.staffSpeed(staff.level)
end

local function floorUnder(rec, point)
	return Vector3.new(point.X, rec.cframe.Position.Y, point.Z)
end

local function walk(staff, target, approach)
	if not alive(staff) then
		return false
	end
	return Rig.walkTo(staff.rig, target, 12 * speedOf(staff), function()
		return alive(staff)
	end, approach)
end

-- Faz uma tarefa parado, com um balão de progresso em cima da cabeça.
-- display: um produto (mostra a bebida em 3D) ou um texto curto.
local function work(staff, seconds, display)
	if not alive(staff) then
		return false
	end
	local bubble = Props.bubble(staff.rig.head, 5.4)
	if type(display) == "table" then
		bubble.products({ display })
	else
		bubble.text(display)
	end
	local duration = seconds / speedOf(staff)
	local started = os.clock()
	while os.clock() - started < duration do
		if not alive(staff) then
			bubble.destroy()
			return false
		end
		bubble.bar((os.clock() - started) / duration)
		task.wait(0.15)
	end
	bubble.destroy()
	return alive(staff)
end

local function holdProducts(staff, items)
	local products = {}
	for _, item in items do
		table.insert(products, item.product)
	end
	if #products == 0 then
		Rig.drop(staff.rig)
	else
		Rig.hold(staff.rig, Props.tray(products))
	end
end

local function idlePoint(staff)
	local plot = staff.plot
	local role = staff.role.id
	local index = staff.slot or 1
	if role == "seguranca" then
		local side = if index % 2 == 0 then 1 else -1
		return plot:toWorld(side * (3 + math.floor((index - 1) / 2) * 2), 1.2), Vector3.new(0, 0, -1)
	end
	if role == "dj" then
		for _, rec in plot.furniture do
			if rec.id == "cabine_dj" then
				return rec.staffPos, rec.front
			end
		end
	end
	local counters = plot:find("counter")
	if #counters > 0 then
		local counter = counters[1]
		local side = counter.cframe:VectorToWorldSpace(Vector3.new(1, 0, 0))
		local offset = ((index % 5) - 2) * 1.6
		return counter.staffPos + side * offset, counter.front
	end
	return plot:toWorld(((index % 5) - 2) * 2, plot.size * 0.6), Vector3.new(0, 0, -1)
end

local function goIdle(staff)
	local point, look = idlePoint(staff)
	if (Rig.feet(staff.rig) - point).Magnitude > 2.5 then
		walk(staff, point, true)
	end
	if alive(staff) and look then
		Rig.face(staff.rig, look)
	end
end

-- Leva itens para as mesas, agrupando por pedido.
local function deliverToTables(staff, carried)
	local plot = staff.plot
	while #carried > 0 and alive(staff) do
		local order = carried[1].order
		local group = {}
		for i = #carried, 1, -1 do
			if carried[i].order == order then
				table.insert(group, carried[i])
				table.remove(carried, i)
			end
		end
		if order.state == "open" and order.place and not order.place.removed then
			if walk(staff, floorUnder(order.place, order.place.top), true) and alive(staff) then
				Restaurant.deliver(plot, order, group, staff.actor)
			else
				for _, item in group do
					Restaurant.releaseItem(plot, item)
				end
			end
		end
		holdProducts(staff, carried)
	end
	for _, item in carried do
		Restaurant.releaseItem(plot, item)
	end
	Rig.drop(staff.rig)
end

-- Prepara um item numa estação. Devolve true se o item ficou pronto na mão do funcionário.
local function prepareAt(staff, item, station)
	if not walk(staff, station.use) then
		Restaurant.releaseItem(staff.plot, item)
		return false
	end
	Rig.face(staff.rig, -station.front)
	if not work(staff, item.product.prep, item.product) or item.state ~= "preparing" then
		if item.state == "preparing" then
			Restaurant.releaseItem(staff.plot, item)
		end
		return false
	end
	item.state = "carried"
	holdProducts(staff, { item })
	return true
end

local function waiterStep(staff)
	local plot = staff.plot
	local actor = staff.actor

	local batch, place = Restaurant.claimReadyBatch(plot, actor, "table", 4)
	if #batch > 0 then
		local stand = place.staffPos or place.use
		local carried = {}
		if walk(staff, stand) then
			for _, item in batch do
				if Restaurant.pickUp(plot, item, actor) then
					table.insert(carried, item)
				end
			end
		end
		for _, item in batch do
			item.claim = nil
		end
		holdProducts(staff, carried)
		deliverToTables(staff, carried)
		return true
	end

	local order = Restaurant.claimOrderToTake(plot, "table", actor)
	if order then
		if walk(staff, floorUnder(order.place, order.place.top), true) and order.state == "waiting" then
			if work(staff, 1.2, "Anotando") and order.state == "waiting" then
				Restaurant.takeOrder(plot, order, actor)
			end
		end
		if order.claim == actor then
			order.claim = nil
		end
		return true
	end

	local rec = Restaurant.claimTable(plot, actor, "money")
	if rec then
		if walk(staff, floorUnder(rec, rec.top), true) and work(staff, 0.5, "R$") then
			Restaurant.collectMoney(plot, rec, actor)
		end
		rec.moneyClaim = nil
		return true
	end

	-- Sem bartender, o garçom prepara as bebidas das mesas e já leva.
	if Restaurant.staffCount(plot, "bartender") == 0 then
		local item, station = Restaurant.claimPendingItem(plot, actor, Rig.feet(staff.rig), function(candidate)
			return candidate.order.kind == "table"
		end)
		if item then
			if prepareAt(staff, item, station) then
				deliverToTables(staff, { item })
			end
			return true
		end
	end
	return false
end

local function bartenderStep(staff)
	local plot = staff.plot
	local item, station = Restaurant.claimPendingItem(plot, staff.actor, Rig.feet(staff.rig))
	if item == nil then
		return false
	end
	if not prepareAt(staff, item, station) then
		return true
	end
	local place = Restaurant.pickupPlaceFor(plot, item, station)
	if place ~= station then
		walk(staff, place.staffPos or place.use)
	end
	Rig.drop(staff.rig)
	if item.state == "carried" and alive(staff) then
		Restaurant.putReady(plot, item, place)
	elseif item.state == "carried" then
		Restaurant.releaseItem(plot, item)
	end
	return true
end

local function cleanerStep(staff)
	local plot = staff.plot
	local rec = Restaurant.claimTable(plot, staff.actor, "dirty")
	if rec == nil then
		return false
	end
	if walk(staff, floorUnder(rec, rec.top), true) and work(staff, 2.2, "Limpando") then
		Restaurant.clean(plot, rec, staff.actor)
	end
	rec.cleanClaim = nil
	return true
end

local function handOver(staff, item)
	local order = item.order
	if order.state == "open" and order.place and not order.place.removed then
		walk(staff, order.place.staffPos)
		if alive(staff) then
			Restaurant.deliver(staff.plot, order, { item }, staff.actor)
		end
	else
		Restaurant.releaseItem(staff.plot, item)
	end
	Rig.drop(staff.rig)
end

local function clerkStep(staff)
	local plot = staff.plot
	local actor = staff.actor

	local batch, place = Restaurant.claimReadyBatch(plot, actor, "counter", 2)
	if #batch > 0 then
		local carried = {}
		if walk(staff, place.staffPos or place.use) then
			for _, item in batch do
				if Restaurant.pickUp(plot, item, actor) then
					table.insert(carried, item)
				end
			end
		end
		for _, item in batch do
			item.claim = nil
		end
		for _, item in carried do
			if alive(staff) then
				Restaurant.deliver(plot, item.order, { item }, actor)
			else
				Restaurant.releaseItem(plot, item)
			end
		end
		return true
	end

	local order = Restaurant.claimOrderToTake(plot, "counter", actor)
	if order then
		if walk(staff, order.place.staffPos) and order.state == "waiting" then
			-- o cliente pode ter desistido enquanto o atendente chegava ou anotava
			local done = work(staff, 0.8, "Anotando")
			if done and order.state == "waiting" then
				Restaurant.takeOrder(plot, order, actor)
			end
		end
		if order.claim == actor then
			order.claim = nil
		end
		return true
	end

	local item, station = Restaurant.claimPendingItem(plot, actor, Rig.feet(staff.rig), function(candidate)
		return candidate.order.kind == "counter"
	end)
	if item then
		if prepareAt(staff, item, station) then
			handOver(staff, item)
		end
		return true
	end
	return false
end

local STEPS = {
	garcom = waiterStep,
	bartender = bartenderStep,
	faxineiro = cleanerStep,
	atendente = clerkStep,
}

local function run(staff)
	local plot = staff.plot
	task.wait(0.5)
	Rig.walkTo(staff.rig, plot:entrancePoint(), 12, function()
		return alive(staff)
	end)
	while alive(staff) do
		local step = STEPS[staff.role.id]
		local ok, worked = true, false
		if step then
			ok, worked = pcall(step, staff)
			if not ok then
				warn("[Adega] Erro no funcionário", staff.name, worked)
				worked = false
			end
		end
		if not alive(staff) then
			break
		end
		if not worked then
			goIdle(staff)
			if staff.role.id == "dj" and math.random() < 0.25 then
				Props.popup(staff.rig.head.Position + Vector3.new(0, 1.5, 0), Rig.pick({ "♪", "♫", "♪ ♫" }), rgb(200, 140, 255))
			end
			task.wait(0.7)
		end
	end
end

local TAG_FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)

local function nameTag(staff)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffset = Vector3.new(0, 3.3, 0)
	gui.MaxDistance = 45
	gui.LightInfluence = 0
	gui.Parent = staff.rig.head
	local pill = Instance.new("Frame")
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.fromScale(0.5, 0)
	pill.Size = UDim2.fromOffset(150, 26)
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.BackgroundColor3 = rgb(255, 255, 255)
	pill.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = pill
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = pill
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = rgb(40, 34, 48)
	label.FontFace = TAG_FONT
	label.TextSize = 16
	label.RichText = true
	label.Parent = pill
	local role = Instance.new("TextLabel")
	role.AnchorPoint = Vector2.new(0.5, 0)
	role.Position = UDim2.new(0.5, 0, 0, 27)
	role.Size = UDim2.fromOffset(150, 16)
	role.BackgroundTransparency = 1
	role.TextColor3 = rgb(255, 255, 255)
	role.TextStrokeTransparency = 0.5
	role.FontFace = TAG_FONT
	role.TextSize = 13
	role.Text = staff.role.name
	role.Parent = gui
	staff.tag = label
end

function Staff.updateTag(staff)
	if staff.tag then
		staff.tag.Text = staff.name .. '  <font color="#FF9500">' .. string.rep("★", staff.level) .. "</font>"
	end
end

-- Muda a aparência do funcionário (cores, cabelo).
function Staff.setLook(staff, look)
	staff.look = Looks.sanitize(look, staff.role.look)
	if Rig.isAlive(staff.rig) then
		Looks.apply(staff.rig.model, staff.look)
	end
end

-- data = { id, role, name, level, look }
function Staff.spawn(plot, data)
	local role = Config.staffById(data.role)
	if role == nil or plot.rt == nil then
		return nil
	end
	local staff = {
		id = data.id,
		role = role,
		name = data.name,
		level = math.clamp(data.level or 1, 1, Config.StaffMaxLevel),
		plot = plot,
		session = plot.rt.session,
	}
	staff.actor = { kind = "staff", staff = staff, name = staff.name }
	local slot = 0
	for _, other in plot.staff do
		if other.role.id == role.id then
			slot += 1
		end
	end
	staff.slot = slot + 1
	local defaults = table.clone(role.look)
	defaults.skin = math.random(1, #Looks.Skins)
	staff.look = Looks.sanitize(data.look, defaults)
	staff.rig = Rig.new(plot.peopleFolder, plot:sidewalkPoint(1), Vector3.new(-1, 0, 0), staff.look, role.name)
	staff.rig.model:SetAttribute("StaffId", staff.id)
	nameTag(staff)
	Staff.updateTag(staff)
	table.insert(plot.staff, staff)
	task.spawn(run, staff)
	return staff
end

function Staff.remove(plot, staff)
	staff.fired = true
	Restaurant.releaseActor(plot, staff.actor)
	if Rig.isAlive(staff.rig) then
		local rig = staff.rig
		Rig.drop(rig)
		task.spawn(function()
			Rig.walkTo(rig, plot:sidewalkPoint(1), 12, function()
				return rig.model.Parent ~= nil
			end)
			Rig.destroy(rig)
		end)
	end
	local index = table.find(plot.staff, staff)
	if index then
		table.remove(plot.staff, index)
	end
end

function Staff.clear(plot)
	for _, staff in table.clone(plot.staff or {}) do
		staff.fired = true
		Rig.destroy(staff.rig)
	end
	plot.staff = {}
end

return Staff
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX00000017">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX00000016">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX00000015">
				<Properties>
					<string name="Name">AdegaClient</string>
					<ProtectedString name="Source"><![CDATA[-- AdegaClient (LocalScript em StarterPlayer > StarterPlayerScripts, com os módulos UI, Hud, Panels e Build dentro)
-- Recebe o estado do servidor e distribui para a HUD, as janelas e o modo construção.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local Util = require(Shared:WaitForChild("Util"))

local UI = require(script:WaitForChild("UI"))
local Hud = require(script:WaitForChild("Hud"))
local Panels = require(script:WaitForChild("Panels"))
local Build = require(script:WaitForChild("Build"))

local remotes = ReplicatedStorage:WaitForChild("AdegaRemotes")
local stateEvent = remotes:WaitForChild("Estado")
local noticeEvent = remotes:WaitForChild("Aviso")
local actionFunction = remotes:WaitForChild("Acao")

local App = {
	Config = Config,
	Catalog = Catalog,
	Util = Util,
	state = nil,
}

function App.toast(text, kind)
	Hud.toast(text, kind)
end

-- Chama uma ação no servidor. Mostra o erro como aviso; com quiet = true não mostra a mensagem de sucesso.
function App.invoke(action, payload, quiet)
	local ok, result = pcall(function()
		return actionFunction:InvokeServer(action, payload)
	end)
	if not ok or type(result) ~= "table" then
		Hud.toast("Sem resposta do servidor. Tente de novo.", "erro")
		return nil
	end
	if not result.ok then
		Hud.toast(result.msg or "Não deu certo", "erro")
	elseif result.msg and not quiet then
		Hud.toast(result.msg, "compra")
	end
	return result
end

function App.openMenu(id)
	if id == "construir" then
		Build.toggle()
	elseif id == "voltar" then
		App.invoke("voltar", {}, true)
	else
		if Build.isActive() then
			Build.setActive(false)
		end
		Panels.open(id)
	end
end

function App.onBuildMode(on)
	Hud.setBuildMode(on)
end

-- Itens novos quando a adega sobe de nível, para o banner.
local function unlockText(level)
	local names = {}
	for _, item in Catalog.Items do
		if item.level == level then
			table.insert(names, item.name)
		end
	end
	for _, product in Config.Products do
		if product.level == level then
			table.insert(names, product.name)
		end
	end
	for _, role in Config.Staff do
		if role.level == level then
			table.insert(names, role.name)
		end
	end
	if #names == 0 then
		return "Mais clientes e mais vagas na equipe!"
	end
	if #names > 4 then
		return "Liberou " .. table.concat(names, ", ", 1, 4) .. " e mais " .. (#names - 4) .. " itens"
	end
	return "Liberou " .. table.concat(names, ", ")
end

local function start(name, module)
	local ok, err = pcall(module.init, App)
	if not ok then
		warn("[Adega] Erro iniciando " .. name .. ":", err)
	end
end
start("Hud", Hud)
start("Panels", Panels)
start("Build", Build)

stateEvent.OnClientEvent:Connect(function(state)
	local previous = App.state
	App.state = state
	for name, update in { Hud = Hud.update, Panels = Panels.update, Build = Build.update } do
		local ok, err = pcall(update, state, previous)
		if not ok then
			warn("[Adega] Erro atualizando " .. name .. ":", err)
		end
	end
end)

noticeEvent.OnClientEvent:Connect(function(text, kind, extra)
	if kind == "resumo" then
		Hud.summary(extra or {})
	elseif kind == "nivel" and type(extra) == "table" and extra.level then
		Hud.banner("Nível " .. extra.level, unlockText(extra.level))
	else
		Hud.toast(text, kind)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		App.openMenu("construir")
	elseif input.KeyCode == Enum.KeyCode.G and not Build.isActive() then
		App.openMenu("equipe")
	elseif input.KeyCode == Enum.KeyCode.M and not Build.isActive() then
		App.openMenu("cardapio")
	end
end)

local camera = workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(UI.applyScale)
end
UI.applyScale()
-- No começo a câmera ainda pode estar com tamanho errado; reaplica a escala algumas vezes.
for _, delay in { 0.5, 2, 5 } do
	task.delay(delay, UI.applyScale)
end
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">Build</string>
						<ProtectedString name="Source"><![CDATA[-- Build: modo construção. Catálogo com miniaturas 3D, prévia na grade, colocar, mover, girar e vender.
-- Cadeiras giram sozinhas para a mesa ou balcão do lado (até o jogador apertar R).

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local UI = require(script.Parent.UI)
local Icons = require(script.Parent.Icons)

local Build = {}

local T = UI.T
local F = UI.F
local create = UI.create
local label = UI.label
local rgb = Color3.fromRGB

local App
local Catalog
local player = Players.LocalPlayer

local active = false
local currentCategory = "mesas"
local refs: { [string]: any } = {}
local cards = {}
local ghost = nil
local selected = nil
local occupancy = nil
local gridFolder = nil
local gridSize = nil
local connections = {}
local savedZoom = nil

-- Terreno do jogador --------------------------------------------------------------------------------

local function plotModel()
	if App.state == nil then
		return nil
	end
	return workspace:FindFirstChild("Adega" .. App.state.plotIndex)
end

local function origin()
	return CFrame.new(App.state.origin)
end

local function furnitureFolder()
	local plot = plotModel()
	return plot and plot:FindFirstChild("Moveis")
end

local function rebuildOccupancy()
	occupancy = {}
	local folder = furnitureFolder()
	if folder == nil then
		return
	end
	for _, model in folder:GetChildren() do
		local item = Catalog.ById[model:GetAttribute("ItemId") or ""]
		local x, z, r, uid = model:GetAttribute("X"), model:GetAttribute("Z"), model:GetAttribute("R"), model:GetAttribute("Uid")
		if item and x and z and r then
			for _, key in Catalog.cells(item, x, z, r) do
				occupancy[key] = { uid = uid, item = item }
			end
		end
	end
end

local function validity(item, x, z, rotation, ignoreUid)
	if App.state.level < item.level then
		return false, "Libera no nível " .. item.level
	end
	if not Catalog.inBounds(item, x, z, rotation, App.state.size) then
		return false, "Fora da área da adega"
	end
	if occupancy == nil then
		rebuildOccupancy()
	end
	for _, key in Catalog.cells(item, x, z, rotation) do
		local entry = occupancy[key]
		if entry and entry.uid ~= ignoreUid then
			return false, "Já tem algo nesse lugar"
		end
	end
	if ignoreUid == nil and App.state.cash < item.price then
		return false, "Falta dinheiro"
	end
	return true, nil
end

-- Quantos lugares da cadeira ficam virados para uma mesa ou balcão.
local function facingSeats(item, x, z, rotation)
	if occupancy == nil then
		rebuildOccupancy()
	end
	local count = 0
	for _, seat in Catalog.seatPoints(item, x, z, rotation) do
		local entry = occupancy[seat.frontKey]
		if entry and Catalog.isSeatingHost(entry.item) then
			count += 1
		end
	end
	return count
end

-- Grade e paredes transparentes ----------------------------------------------------------------------

local function clearGrid()
	if gridFolder then
		gridFolder:Destroy()
		gridFolder = nil
	end
	gridSize = nil
end

local function drawGrid()
	clearGrid()
	local size = App.state.size
	gridSize = size
	gridFolder = Instance.new("Folder")
	gridFolder.Name = "GradeAdega"
	local base = origin()
	local function line(cframe, lineSize, transparency)
		create("Part", {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
			Color = rgb(255, 255, 255),
			Transparency = transparency,
			Size = lineSize,
			CFrame = cframe,
			Parent = gridFolder,
		})
	end
	for x = -size / 2, size / 2, 2 do
		line(base * CFrame.new(x, 0.03, size / 2), Vector3.new(0.07, 0.02, size), if x % 8 == 0 then 0.55 else 0.75)
	end
	for z = 0, size, 2 do
		line(base * CFrame.new(0, 0.03, z), Vector3.new(size, 0.02, 0.07), if z % 8 == 0 then 0.55 else 0.75)
	end
	gridFolder.Parent = workspace.CurrentCamera
end

local function setWallsSeeThrough(on)
	local folder = furnitureFolder()
	if folder == nil then
		return
	end
	for _, model in folder:GetChildren() do
		local item = Catalog.ById[model:GetAttribute("ItemId") or ""]
		if item and Catalog.isWall(item) then
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = if on then 0.7 else 0
				end
			end
		end
	end
end

-- Prévia --------------------------------------------------------------------------------------------

local function mouseHit(includeList)
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = includeList
	return workspace:Raycast(ray.Origin, ray.Direction * 600, params)
end

local function endGhost()
	if ghost then
		ghost.model:Destroy()
		if ghost.hidden then
			for _, part in ghost.hidden:GetDescendants() do
				if part:IsA("BasePart") then
					part.LocalTransparencyModifier = 0
				end
			end
			setWallsSeeThrough(active)
		end
		ghost = nil
	end
	if refs.touchBar then
		refs.touchBar.Visible = false
	end
	refs.ghostInfo.Visible = false
end

local function startGhost(item, rotation, moveUid, hiddenModel)
	endGhost()
	local model = Catalog.buildModel(item, CFrame.new(0, -500, 0), { ghost = true, noLights = true })
	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = rgb(255, 255, 255)
	highlight.OutlineTransparency = 0.2
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model
	model.Parent = workspace.CurrentCamera
	ghost = { item = item, model = model, highlight = highlight, rotation = rotation or 0, moveUid = moveUid, hidden = hiddenModel, manual = moveUid ~= nil }
	if hiddenModel then
		for _, part in hiddenModel:GetDescendants() do
			if part:IsA("BasePart") then
				part.LocalTransparencyModifier = 0.85
			end
		end
	end
	refs.touchBar.Visible = UserInputService.TouchEnabled
	refs.ghostInfo.Visible = true
	refs.ghostName.Text = (if moveUid then "Movendo: " else "") .. item.name
	refs.ghostPrice.Text = if moveUid then "Grátis" else App.Util.formatMoney(item.price)
end

local function updateGhost()
	if ghost == nil or App.state == nil then
		return
	end
	local plot = plotModel()
	if plot == nil then
		return
	end
	local hit = mouseHit({ plot.Terreno })
	if hit == nil then
		return
	end
	local localPos = origin():PointToObjectSpace(hit.Position)
	local item = ghost.item

	-- cadeira: gira sozinha para a mesa do lado, se o jogador não escolheu a rotação
	if item.kind == "chair" and not ghost.manual then
		local best, bestCount = ghost.rotation, -1
		for offset = 0, 3 do
			local rotation = (ghost.rotation + offset) % 4
			local w, d = Catalog.footprint(item, rotation)
			local count = facingSeats(item, Catalog.snap(localPos.X, w), Catalog.snap(localPos.Z, d), rotation)
			if count > bestCount then
				best, bestCount = rotation, count
			end
		end
		ghost.rotation = best
	end

	local w, d = Catalog.footprint(item, ghost.rotation)
	local x = Catalog.snap(localPos.X, w)
	local z = Catalog.snap(localPos.Z, d)
	ghost.x, ghost.z = x, z
	ghost.model:PivotTo(origin() * Catalog.localCFrame(x, z, ghost.rotation) * CFrame.new(0, 0.1, 0))
	local ok, reason = validity(item, x, z, ghost.rotation, ghost.moveUid)
	ghost.valid = ok
	ghost.reason = reason
	local warning = nil
	if ok and item.kind == "chair" and facingSeats(item, x, z, ghost.rotation) == 0 then
		warning = "Sem mesa na frente: ninguém vai sentar aqui"
	end
	ghost.highlight.FillColor = if not ok then rgb(255, 69, 58) elseif warning then rgb(255, 179, 0) else rgb(52, 199, 89)
	refs.ghostReason.Text = if not ok then reason elseif warning then warning else (if UI.isTouch() then "Toque em Colocar" else "Clique para colocar")
	refs.ghostReason.TextColor3 = if not ok then T.red elseif warning then T.goldDark else T.greenDark
end

local function rotateGhost()
	if ghost then
		ghost.manual = true
		ghost.rotation = (ghost.rotation + 1) % 4
		updateGhost()
	end
end

local function placeGhost()
	if ghost == nil or ghost.x == nil then
		return
	end
	if not ghost.valid then
		App.toast(ghost.reason or "Não dá para colocar aqui", "erro")
		return
	end
	local payload = { id = ghost.item.id, x = ghost.x, z = ghost.z, r = ghost.rotation, uid = ghost.moveUid }
	local action = if ghost.moveUid then "mover" else "colocar"
	local wasMove = ghost.moveUid ~= nil
	local result = App.invoke(action, payload, true)
	if result and result.ok then
		occupancy = nil
		if wasMove then
			endGhost()
		end
	end
end

-- Seleção de móveis já colocados ----------------------------------------------------------------------

local function deselect()
	if selected then
		if selected.highlight then
			selected.highlight:Destroy()
		end
		selected = nil
	end
	refs.selection.Visible = false
end

local function selectModel(model)
	deselect()
	local item = Catalog.ById[model:GetAttribute("ItemId") or ""]
	if item == nil then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = rgb(0, 122, 255)
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = rgb(120, 190, 255)
	highlight.Parent = model
	selected = { model = model, item = item, uid = model:GetAttribute("Uid"), highlight = highlight, confirmSell = false }
	refs.selName.Text = item.name
	refs.sellButton.Text = "Vender por " .. App.Util.formatMoney(math.floor(item.price * App.Config.SellRefund))
	refs.selection.Visible = true
end

local function trySelect()
	local folder = furnitureFolder()
	if folder == nil then
		return
	end
	local hit = mouseHit({ folder })
	if hit == nil then
		deselect()
		return
	end
	local instance = hit.Instance
	while instance and instance.Parent ~= folder do
		instance = instance.Parent
	end
	if instance and instance:IsA("Model") then
		selectModel(instance)
	else
		deselect()
	end
end

-- Catálogo ------------------------------------------------------------------------------------------

local function thumbnail(item, parent)
	local viewport = create("ViewportFrame", {
		Position = UDim2.fromOffset(6, 6),
		Size = UDim2.new(1, -12, 0, 88),
		BackgroundColor3 = T.card,
		Ambient = rgb(200, 196, 210),
		LightColor = rgb(255, 250, 240),
		LightDirection = Vector3.new(-0.6, -1, -0.4),
		Parent = parent,
	}, { UI.corner(10) })
	local model = Catalog.buildModel(item, CFrame.new(), { noLights = true })
	model.Parent = viewport
	local camera = Instance.new("Camera")
	camera.FieldOfView = 30
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local cframe, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local distance = radius / math.tan(math.rad(camera.FieldOfView / 2)) * 0.95
	local direction = Vector3.new(0.7, 0.75, -1).Unit
	camera.CFrame = CFrame.lookAt(cframe.Position + direction * distance, cframe.Position)
	return viewport
end

local function refreshCards()
	if App.state == nil then
		return
	end
	for _, entry in cards do
		local item = entry.item
		entry.lock.Visible = App.state.level < item.level
		entry.price.TextColor3 = if App.state.cash >= item.price then T.goldDark else T.red
		local stroke = entry.frame:FindFirstChildOfClass("UIStroke")
		local chosen = ghost and ghost.item == item and not ghost.moveUid
		stroke.Color = if chosen then T.gold else rgb(0, 0, 0)
		stroke.Thickness = if chosen then 3 else 1
		stroke.Transparency = if chosen then 0 else 0.9
	end
end

local function kindLabel(item)
	if item.kind == "chair" then
		return #item.seats .. (if #item.seats == 1 then " lugar" else " lugares")
	elseif item.kind == "station" then
		return "Equipamento"
	elseif item.layer == "air" then
		return "Fica no alto"
	elseif item.layer == "rug" then
		return "Vai no chão"
	end
	return nil
end

local function showCategory(categoryId)
	currentCategory = categoryId
	for id, tab in refs.tabs do
		local on = id == categoryId
		tab.BackgroundTransparency = if on then 0 else 1
		tab.TextColor3 = if on then rgb(255, 255, 255) else T.muted
	end
	for _, entry in cards do
		entry.frame:Destroy()
	end
	table.clear(cards)
	for _, item in Catalog.Items do
		if item.category ~= categoryId then
			continue
		end
		local frame = create("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(136, 172), BackgroundColor3 = T.panel, LayoutOrder = item.order, Parent = refs.items }, {
			UI.corner(14),
			UI.stroke(rgb(0, 0, 0), 1, 0.9),
		})
		thumbnail(item, frame)
		label({ Text = item.name, FontFace = F.extra, TextSize = 13, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(9, 98), Size = UDim2.new(1, -18, 0, 32), Parent = frame })
		local price = label({ Text = App.Util.formatMoney(item.price), FontFace = F.heavy, TextSize = 16, TextColor3 = T.goldDark, Position = UDim2.fromOffset(9, 132), Size = UDim2.new(1, -18, 0, 18), Parent = frame })
		local extras = {}
		local kind = kindLabel(item)
		if kind then
			table.insert(extras, kind)
		end
		if (item.appeal or 0) > 0 then
			table.insert(extras, "+" .. item.appeal .. " ambiente")
		end
		label({ Text = table.concat(extras, " • "), FontFace = F.bold, TextSize = 11, TextColor3 = T.muted, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(9, 150), Size = UDim2.new(1, -18, 0, 14), Parent = frame })
		local lock = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 0.15, Visible = false, ZIndex = 5, Parent = frame }, { UI.corner(14) })
		local lockIcon = Icons.lock(28, T.muted)
		lockIcon.AnchorPoint = Vector2.new(0.5, 0.5)
		lockIcon.Position = UDim2.fromScale(0.5, 0.4)
		lockIcon.ZIndex = 6
		lockIcon.Parent = lock
		label({ Text = "Nível " .. item.level, FontFace = F.heavy, TextSize = 15, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.55), Size = UDim2.new(1, 0, 0, 20), ZIndex = 6, Parent = lock })
		local entry = { item = item, frame = frame, price = price, lock = lock }
		frame.Activated:Connect(function()
			if App.state.level < item.level then
				UI.shake(frame)
				App.toast(item.name .. " libera no nível " .. item.level, "erro")
				return
			end
			deselect()
			startGhost(item, 0, nil, nil)
			refreshCards()
		end)
		if item.desc then
			frame.MouseEnter:Connect(function()
				refs.tooltipText.Text = item.desc
				refs.tooltip.Visible = true
			end)
			frame.MouseLeave:Connect(function()
				refs.tooltip.Visible = false
			end)
		end
		table.insert(cards, entry)
	end
	refs.items.CanvasPosition = Vector2.zero
	refreshCards()
end

local function buildUI()
	local screen = UI.newScreen("AdegaConstrucao", 5, false)
	refs.screen = screen
	screen.Enabled = false

	local drawer = UI.scaled(UI.panel({ Name = "Catalogo", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(1100, 252), Parent = screen }))
	drawer.UICorner.CornerRadius = UDim.new(0, 22)
	local square = create("Frame", { Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = T.gold, Parent = drawer }, { UI.corner(10) })
	local hammer = Icons.hammer(24, rgb(255, 255, 255))
	hammer.AnchorPoint = Vector2.new(0.5, 0.5)
	hammer.Position = UDim2.fromScale(0.5, 0.5)
	hammer.Parent = square
	label({ Text = "Construir", FontFace = F.heavy, TextSize = 22, Position = UDim2.fromOffset(62, 12), Size = UDim2.fromOffset(130, 36), Parent = drawer })
	local tabs = create("Frame", { Position = UDim2.fromOffset(190, 12), Size = UDim2.new(1, -330, 0, 36), BackgroundTransparency = 1, Parent = drawer })
	UI.list(Enum.FillDirection.Horizontal, 4, nil, Enum.VerticalAlignment.Center).Parent = tabs
	refs.tabs = {}
	for index, category in Catalog.Categories do
		local tab = create("TextButton", {
			Text = category.name,
			FontFace = F.extra,
			TextSize = 15,
			TextColor3 = T.muted,
			AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 34),
			BackgroundColor3 = T.gold,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = tabs,
		}, { UI.corner("full"), UI.pad(0, 13, 0, 13) })
		tab.Activated:Connect(function()
			showCategory(category.id)
		end)
		refs.tabs[category.id] = tab
	end
	UI.button({ Style = "light", Text = "Sair", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 12), Size = UDim2.fromOffset(110, 36), Parent = drawer }, function()
		Build.setActive(false)
	end)
	refs.items = create("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 60),
		Size = UDim2.new(1, -24, 0, 184),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = rgb(180, 172, 190),
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		Parent = drawer,
	})
	UI.list(Enum.FillDirection.Horizontal, 10).Parent = refs.items
	UI.pad(2, 4, 8, 4).Parent = refs.items

	refs.tooltip = UI.panel({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -10),
		Size = UDim2.fromOffset(0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = drawer,
	})
	UI.pad(0, 16, 0, 16).Parent = refs.tooltip
	refs.tooltipText = label({ Text = "", FontFace = F.bold, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 42), Parent = refs.tooltip })

	-- informação da prévia
	local info = UI.scaled(UI.panel({ Name = "Previa", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(480, 90), Visible = false, Parent = screen }))
	refs.ghostInfo = info
	refs.ghostName = label({ Text = "", FontFace = F.heavy, TextSize = 18, Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, -170, 0, 24), TextTruncate = Enum.TextTruncate.AtEnd, Parent = info })
	refs.ghostPrice = label({ Text = "", FontFace = F.heavy, TextSize = 18, TextColor3 = T.goldDark, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -150, 0, 10), Size = UDim2.fromOffset(132, 24), Parent = info })
	refs.ghostReason = label({ Text = "", FontFace = F.extra, TextSize = 14, Position = UDim2.fromOffset(18, 36), Size = UDim2.new(1, -36, 0, 20), Parent = info })
	label({
		Text = if UI.isTouch() then "Toque no chão para mover a prévia" else "R gira  •  Q ou botão direito cancela  •  clique coloca",
		FontFace = F.medium,
		TextSize = 13,
		TextColor3 = T.muted,
		Position = UDim2.fromOffset(18, 60),
		Size = UDim2.new(1, -36, 0, 18),
		Parent = info,
	})

	local touchBar = create("Frame", { Position = UDim2.new(0, 0, 1, 10), Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Visible = false, Parent = info })
	UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center).Parent = touchBar
	UI.button({ Style = "blue", Text = "Girar", Size = UDim2.fromOffset(130, 46), LayoutOrder = 1, Parent = touchBar }, rotateGhost)
	UI.button({ Style = "green", Text = "Colocar", Size = UDim2.fromOffset(150, 46), LayoutOrder = 2, Parent = touchBar }, placeGhost)
	UI.button({ Style = "light", Text = "Cancelar", Size = UDim2.fromOffset(130, 46), LayoutOrder = 3, Parent = touchBar }, endGhost)
	refs.touchBar = touchBar

	-- painel do móvel selecionado
	local selection = UI.scaled(UI.panel({ Name = "Selecionado", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.fromOffset(600, 112), Visible = false, Parent = screen }))
	refs.selection = selection
	refs.selName = label({ Text = "", FontFace = F.heavy, TextSize = 18, Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, -36, 0, 24), TextTruncate = Enum.TextTruncate.AtEnd, Parent = selection })
	local row = create("Frame", { Position = UDim2.fromOffset(14, 48), Size = UDim2.new(1, -28, 0, 50), BackgroundTransparency = 1, Parent = selection })
	UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center).Parent = row
	UI.button({ Style = "blue", Text = "Mover", Size = UDim2.fromOffset(120, 46), LayoutOrder = 1, Parent = row }, function()
		if selected then
			local model, item = selected.model, selected.item
			local uid, rotation = selected.uid, model:GetAttribute("R") or 0
			deselect()
			startGhost(item, rotation, uid, model)
		end
	end)
	UI.button({ Style = "purple", Text = "Girar", Size = UDim2.fromOffset(110, 46), LayoutOrder = 2, Parent = row }, function()
		if selected then
			local model = selected.model
			local result = App.invoke("mover", { uid = selected.uid, x = model:GetAttribute("X"), z = model:GetAttribute("Z"), r = (model:GetAttribute("R") or 0) + 1 }, true)
			if result and result.ok then
				deselect()
				occupancy = nil
			end
		end
	end)
	refs.sellButton = UI.button({ Style = "red", Text = "Vender", Size = UDim2.fromOffset(200, 46), LayoutOrder = 3, Parent = row }, function()
		if selected == nil then
			return
		end
		if not selected.confirmSell then
			selected.confirmSell = true
			refs.sellButton.Text = "Confirmar venda?"
			return
		end
		local result = App.invoke("vender", { uid = selected.uid })
		if result and result.ok then
			deselect()
			occupancy = nil
		end
	end)
	UI.button({ Style = "light", Text = "Fechar", Size = UDim2.fromOffset(110, 46), LayoutOrder = 4, Parent = row }, deselect)
end

-- Ligar e desligar ----------------------------------------------------------------------------------

function Build.setActive(on)
	if on == active then
		return
	end
	if on and App.state == nil then
		return
	end
	active = on
	refs.screen.Enabled = on
	App.onBuildMode(on)
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
	if on then
		UI.closeWindows()
		drawGrid()
		setWallsSeeThrough(true)
		occupancy = nil
		showCategory(currentCategory)
		savedZoom = player.CameraMaxZoomDistance
		player.CameraMaxZoomDistance = math.max(savedZoom, 140)
		local folder = furnitureFolder()
		if folder then
			table.insert(connections, folder.ChildAdded:Connect(function()
				occupancy = nil
				task.defer(function()
					if active then
						setWallsSeeThrough(true)
					end
				end)
			end))
			table.insert(connections, folder.ChildRemoved:Connect(function()
				occupancy = nil
			end))
		end
		table.insert(connections, RunService.RenderStepped:Connect(updateGhost))
	else
		endGhost()
		deselect()
		clearGrid()
		setWallsSeeThrough(false)
		if savedZoom then
			player.CameraMaxZoomDistance = savedZoom
		end
	end
end

function Build.toggle()
	Build.setActive(not active)
end

function Build.isActive()
	return active
end

function Build.update(state)
	if not active then
		return
	end
	if gridSize ~= state.size then
		drawGrid()
	end
	refreshCards()
end

function Build.init(app)
	App = app
	Catalog = app.Catalog
	buildUI()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then
			return
		end
		if input.KeyCode == Enum.KeyCode.R and not processed then
			rotateGhost()
		elseif (input.KeyCode == Enum.KeyCode.Q and not processed) or input.UserInputType == Enum.UserInputType.MouseButton2 then
			if ghost then
				endGhost()
				refreshCards()
			else
				deselect()
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then
			if ghost then
				placeGhost()
			else
				trySelect()
			end
		elseif input.UserInputType == Enum.UserInputType.Touch and not processed and ghost == nil then
			task.defer(trySelect)
		end
	end)
end

return Build
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">Hud</string>
						<ProtectedString name="Source"><![CDATA[-- Hud: o que fica sempre na tela.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local UI = require(script.Parent.UI)
local Icons = require(script.Parent.Icons)

local Hud = {}

local T = UI.T
local F = UI.F
local create = UI.create
local label = UI.label
local rgb = Color3.fromRGB

local App
local screen
local refs: { [string]: any } = {}

local ITEM_COLORS = {
	new = T.cardDark,
	pending = T.cardDark,
	preparing = rgb(204, 228, 255),
	ready = rgb(206, 244, 214),
	carried = rgb(255, 232, 196),
	served = T.card,
}

local function productById(id)
	return App.Config.productById(id)
end

-- Perfil e missão ----------------------------------------------------------------------------------

local function buildProfile()
	local profile = UI.scaled(UI.panel({ Name = "Perfil", Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(300, 76), Parent = screen }))
	local badge = create("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(52, 52), BackgroundColor3 = T.gold, Parent = profile }, { UI.corner("full") })
	label({ Text = "NÍVEL", FontFace = F.heavy, TextSize = 10, TextColor3 = rgb(255, 236, 200), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 10), Parent = badge })
	refs.level = label({ Text = "1", FontFace = F.heavy, TextSize = 26, TextColor3 = rgb(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 30), Parent = badge })
	label({ Text = "Adega de " .. Players.LocalPlayer.DisplayName, FontFace = F.extra, TextSize = 17, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(76, 12), Size = UDim2.fromOffset(212, 22), Parent = profile })
	local _, fill = UI.bar(profile, { Position = UDim2.fromOffset(76, 42), Size = UDim2.fromOffset(212, 10) })
	refs.xpFill = fill
	refs.xpText = label({ Text = "", FontFace = F.bold, TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(76, 54), Size = UDim2.fromOffset(212, 14), Parent = profile })

	local quest = UI.scaled(UI.panel({ Name = "Missao", Position = UDim2.fromOffset(16, 96), Size = UDim2.fromOffset(300, 92), Parent = screen }))
	refs.quest = quest
	refs.questTitle = label({ Text = "MISSÃO", FontFace = F.heavy, TextSize = 11, TextColor3 = T.gold, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -110, 0, 14), Parent = quest })
	refs.questReward = UI.chip(quest, "", T.green, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8) })
	refs.questText = label({ Text = "", FontFace = F.bold, TextSize = 16, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(16, 30), Size = UDim2.new(1, -32, 0, 38), Parent = quest })
	local _, qFill = UI.bar(quest, { Position = UDim2.fromOffset(16, 72), Size = UDim2.new(1, -90, 0, 8) }, T.green)
	refs.questFill = qFill
	refs.questProgress = label({ Text = "", FontFace = F.extra, TextSize = 12, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -70, 0, 66), Size = UDim2.fromOffset(56, 18), Parent = quest })
end

-- Barra de status (dinheiro, relógio, avaliação) --------------------------------------------------------

local function divider(parent, order)
	create("Frame", { Size = UDim2.fromOffset(1, 36), BackgroundColor3 = T.line, BorderSizePixel = 0, LayoutOrder = order, Parent = parent })
end

local function buildStatus()
	local bar = UI.scaled(UI.panel({ Name = "Status", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(0, 64), AutomaticSize = Enum.AutomaticSize.X, Parent = screen }))
	UI.pad(0, 18, 0, 18).Parent = bar
	UI.list(Enum.FillDirection.Horizontal, 16, nil, Enum.VerticalAlignment.Center).Parent = bar

	local money = create("Frame", { Size = UDim2.fromOffset(0, 64), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = 1, Parent = bar })
	UI.list(Enum.FillDirection.Horizontal, 10, nil, Enum.VerticalAlignment.Center).Parent = money
	Icons.coin(34).Parent = money
	refs.money = label({ Text = "R$ 0", FontFace = F.heavy, TextSize = 30, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 40), Parent = money })
	refs.moneyAnchor = money
	refs.shownCash = create("NumberValue", { Value = 0 })
	refs.shownCash.Changed:Connect(function(value)
		refs.money.Text = App.Util.formatMoney(value)
	end)
	divider(bar, 2)

	local clock = create("Frame", { Size = UDim2.fromOffset(0, 64), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = 3, Parent = bar })
	UI.list(Enum.FillDirection.Horizontal, 10, nil, Enum.VerticalAlignment.Center).Parent = clock
	local clockIcon, setClock = Icons.clock(30)
	clockIcon.Parent = clock
	refs.setClock = setClock
	local clockText = create("Frame", { Size = UDim2.fromOffset(150, 44), BackgroundTransparency = 1, Parent = clock })
	refs.clock = label({ Text = "16:30", FontFace = F.heavy, TextSize = 24, Size = UDim2.new(1, 0, 0, 26), Parent = clockText })
	refs.period = label({ Text = "", FontFace = F.bold, TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 16), Parent = clockText })
	divider(bar, 4)

	local rating = create("Frame", { Size = UDim2.fromOffset(0, 64), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = 5, Parent = bar })
	UI.list(Enum.FillDirection.Horizontal, 8, nil, Enum.VerticalAlignment.Center).Parent = rating
	Icons.star(30, T.gold).Parent = rating
	local ratingText = create("Frame", { Size = UDim2.fromOffset(86, 44), BackgroundTransparency = 1, Parent = rating })
	refs.rating = label({ Text = "3,0", FontFace = F.heavy, TextSize = 24, Size = UDim2.new(1, 0, 0, 26), Parent = ratingText })
	label({ Text = "avaliação", FontFace = F.bold, TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 16), Parent = ratingText })

	local chips = UI.scaled(create("Frame", { Name = "Resumo", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 84), Size = UDim2.fromOffset(640, 28), BackgroundTransparency = 1, Parent = screen }))
	UI.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center).Parent = chips
	local function chip(order, color)
		local frame = create("Frame", { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), BackgroundColor3 = T.panel, BackgroundTransparency = 0.04, LayoutOrder = order, Parent = chips }, {
			UI.corner("full"),
			UI.pad(0, 12, 0, 10),
			UI.list(Enum.FillDirection.Horizontal, 7, nil, Enum.VerticalAlignment.Center),
		})
		Icons.dot(8, color).Parent = frame
		local text = label({ Text = "", FontFace = F.bold, TextSize = 13, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Parent = frame })
		return text, frame
	end
	refs.chipPeople = chip(1, T.blue)
	refs.chipFree = chip(2, T.green)
	refs.chipDirty, refs.chipDirtyFrame = chip(3, T.teal)
	refs.chipMoney, refs.chipMoneyFrame = chip(4, T.gold)
end

-- Pedidos -----------------------------------------------------------------------------------------

local function buildOrders()
	local panel = UI.scaled(UI.panel({ Name = "Pedidos", Position = UDim2.fromOffset(16, 200), Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = screen }))
	UI.pad(12, 12, 12, 12).Parent = panel
	UI.list(Enum.FillDirection.Vertical, 8).Parent = panel
	local header = create("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 0, Parent = panel })
	Icons.clipboard(18, T.text).Parent = header
	label({ Text = "Pedidos", FontFace = F.heavy, TextSize = 17, Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -60, 1, 0), Parent = header })
	refs.ordersCount = label({ Text = "", FontFace = F.heavy, TextSize = 14, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.fromScale(1, 1), Parent = header })
	refs.ordersEmpty = label({ Text = "Nenhum pedido agora. Os clientes chegam pela calçada.", FontFace = F.medium, TextSize = 13, TextColor3 = T.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1, Parent = panel })
	refs.orders = panel
	refs.tickets = {}
end

local function ticket(index)
	local existing = refs.tickets[index]
	if existing then
		return existing
	end
	local frame = create("Frame", { Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = T.card, LayoutOrder = index + 1, Parent = refs.orders }, { UI.corner(12) })
	local place = UI.chip(frame, "", T.blue, { Position = UDim2.fromOffset(8, 8) })
	local status = label({ Text = "", FontFace = F.bold, TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(10, 34), Size = UDim2.fromOffset(100, 16), Parent = frame })
	local icons = create("Frame", { Position = UDim2.fromOffset(112, 6), Size = UDim2.new(1, -118, 0, 40), BackgroundTransparency = 1, Parent = frame })
	UI.list(Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Right).Parent = icons
	local _, fill = UI.bar(frame, { Position = UDim2.new(0, 10, 1, -9), Size = UDim2.new(1, -20, 0, 4) }, T.green)
	local entry = { frame = frame, place = place, status = status, icons = icons, fill = fill, boxes = {} }
	refs.tickets[index] = entry
	return entry
end

local STATE_TEXT = {
	new = "Anotar",
	pending = "Preparar",
	preparing = "Preparando",
	ready = "Pronto",
	carried = "Na bandeja",
	served = "Entregue",
}

local function updateOrders(state)
	local orders = state.orders
	refs.ordersEmpty.Visible = #orders == 0
	refs.ordersCount.Text = if #orders > 0 then tostring(#orders) else ""
	for index = 1, math.max(#orders, #refs.tickets) do
		local order = orders[index]
		local entry = refs.tickets[index]
		if order == nil then
			if entry then
				entry.frame.Visible = false
			end
			continue
		end
		entry = ticket(index)
		entry.frame.Visible = true
		entry.place.Text = order.label
		if order.state == "waiting" then
			entry.place.BackgroundColor3 = T.gold
			entry.status.Text = "Chamando  " .. order.wait .. "s"
			entry.status.TextColor3 = T.goldDark
		else
			entry.place.BackgroundColor3 = T.blue
			local first = order.icons[1]
			for _, icon in order.icons do
				if icon[2] ~= "served" then
					first = icon
					break
				end
			end
			entry.status.Text = (STATE_TEXT[first[2]] or "") .. "  " .. order.wait .. "s"
			entry.status.TextColor3 = T.muted
		end
		for i, icon in order.icons do
			local box = entry.boxes[i]
			if box == nil or box.productId ~= icon[1] then
				if box then
					box.frame:Destroy()
				end
				local frame = create("Frame", { Size = UDim2.fromOffset(40, 40), BackgroundColor3 = T.cardDark, LayoutOrder = i, Parent = entry.icons }, { UI.corner(10) })
				local product = productById(icon[1])
				if product then
					UI.product(product, 38, { Position = UDim2.fromOffset(1, 1), Parent = frame })
				end
				box = { frame = frame, productId = icon[1] }
				entry.boxes[i] = box
			end
			box.frame.Visible = true
			box.frame.BackgroundColor3 = ITEM_COLORS[icon[2]] or T.cardDark
			box.frame.BackgroundTransparency = if icon[2] == "served" then 0.5 else 0
		end
		for i = #order.icons + 1, #entry.boxes do
			entry.boxes[i].frame.Visible = false
		end
		local ratio = order.patience
		entry.fill.Size = UDim2.fromScale(ratio, 1)
		entry.fill.BackgroundColor3 = if ratio > 0.5 then T.green elseif ratio > 0.25 then T.gold else T.red
	end
end

-- Bandeja e dica ---------------------------------------------------------------------------------------

local function buildCarry()
	local tray = UI.scaled(UI.panel({ Name = "Bandeja", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(0, 104), AutomaticSize = Enum.AutomaticSize.X, Visible = false, Parent = screen }))
	UI.pad(10, 14, 10, 14).Parent = tray
	refs.trayTitle = label({ Text = "BANDEJA", FontFace = F.heavy, TextSize = 12, TextColor3 = T.gold, Size = UDim2.fromOffset(200, 14), Parent = tray })
	local slots = create("Frame", { Position = UDim2.fromOffset(0, 20), Size = UDim2.fromOffset(0, 64), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = tray })
	UI.list(Enum.FillDirection.Horizontal, 8).Parent = slots
	refs.traySlots = {}
	for i = 1, 6 do
		local slot = create("Frame", { Size = UDim2.fromOffset(72, 64), BackgroundColor3 = T.card, LayoutOrder = i, Visible = i <= 4, Parent = slots }, { UI.corner(12) })
		local where = label({ Text = "", FontFace = F.extra, TextSize = 11, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -16), Size = UDim2.new(1, 0, 0, 14), Parent = slot })
		refs.traySlots[i] = { frame = slot, where = where, view = nil, productId = nil }
	end
	refs.tray = tray

	refs.hint = UI.scaled(create("Frame", {
		Name = "Dica",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -128),
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.panel,
		Visible = false,
		Parent = screen,
	}, { UI.corner("full"), UI.pad(0, 18, 0, 14), UI.list(Enum.FillDirection.Horizontal, 10, nil, Enum.VerticalAlignment.Center) }))
	refs.hintDot = Icons.dot(10, T.gold)
	refs.hintDot.Parent = refs.hint
	refs.hintText = label({ Text = "", FontFace = F.bold, TextSize = 15, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 38), Parent = refs.hint })
end

local function updateCarry(state)
	local carry = state.carry
	refs.tray.Visible = #carry > 0 and not refs.buildMode
	refs.trayTitle.Text = "BANDEJA  " .. #carry .. "/" .. state.carryLimit
	for i, slot in refs.traySlots do
		slot.frame.Visible = i <= state.carryLimit
		local entry = carry[i]
		local id = entry and entry[1]
		if slot.productId ~= id then
			if slot.view then
				slot.view:Destroy()
				slot.view = nil
			end
			slot.productId = id
			local product = id and productById(id)
			if product then
				slot.view = UI.product(product, 46, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Parent = slot.frame })
			end
		end
		slot.where.Text = if entry then entry[2] else ""
		slot.frame.BackgroundColor3 = if entry then rgb(255, 240, 214) else T.card
	end
end

local function updateHint(state)
	local text = nil
	local waiting, pending, ready = nil, false, false
	for _, order in state.orders do
		if order.state == "waiting" and waiting == nil then
			waiting = order.label
		end
		for _, icon in order.icons do
			if icon[2] == "pending" then
				pending = true
			elseif icon[2] == "ready" then
				ready = true
			end
		end
	end
	if #state.carry > 0 then
		text = "Leve a bandeja até " .. state.carry[1][2] .. " e aperte E para entregar"
	elseif waiting then
		text = waiting .. " está chamando: vá até lá e aperte E para anotar"
	elseif ready then
		text = "Tem pedido pronto no balcão: aperte F perto dele para pegar"
	elseif pending then
		text = "Prepare os pedidos: chegue perto da geladeira ou estação e segure E"
	elseif state.tableMoney > 0 then
		text = "Tem dinheiro deixado nas mesas para você pegar"
	elseif state.dirtyTables > 0 then
		text = "Tem mesa suja: segure E perto dela para limpar"
	end
	local show = text ~= nil and state.level < 10 and not refs.buildMode
	refs.hint.Visible = show
	if show then
		refs.hintText.Text = text
	end
end

-- Menu lateral ---------------------------------------------------------------------------------

local function buildMenu()
	local menu = UI.scaled(create("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.56, 0),
		Size = UDim2.fromOffset(80, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}))
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = menu
	refs.menu = menu
	refs.menuBadges = {}
	local entries = {
		{ id = "construir", icon = Icons.hammer, text = "Construir", color = T.gold },
		{ id = "equipe", icon = Icons.people, text = "Equipe", color = T.blue },
		{ id = "cardapio", icon = Icons.clipboard, text = "Cardápio", color = T.red },
		{ id = "avaliacoes", icon = Icons.star, text = "Avaliações", color = rgb(255, 179, 0) },
		{ id = "expandir", icon = Icons.expand, text = "Expandir", color = T.green },
		{ id = "estilo", icon = Icons.palette, text = "Estilo", color = T.purple },
		{ id = "voltar", icon = Icons.home, text = "Minha adega", color = T.muted },
	}
	for index, entry in entries do
		local button = create("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(78, 76), BackgroundColor3 = T.panel, LayoutOrder = index, Parent = menu }, {
			UI.corner(18),
			UI.stroke(rgb(0, 0, 0), 1, 0.9),
		})
		local square = create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = entry.color, Parent = button }, { UI.corner(12) })
		local icon = entry.icon(26, rgb(255, 255, 255), entry.color)
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.Parent = square
		label({ Text = entry.text, FontFace = F.extra, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 16), Parent = button })
		local badge = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.red, Visible = false, ZIndex = 3, Parent = button }, {
			UI.corner("full"),
			UI.stroke(rgb(255, 255, 255), 2, 0),
		})
		refs.menuBadges[entry.id] = badge
		local scale = create("UIScale", { Parent = button })
		button.MouseEnter:Connect(function()
			UI.tween(scale, 0.12, { Scale = 1.07 })
		end)
		button.MouseLeave:Connect(function()
			UI.tween(scale, 0.12, { Scale = 1 })
		end)
		button.Activated:Connect(function()
			UI.tween(scale, 0.08, { Scale = 0.92 })
			task.delay(0.08, function()
				UI.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
			end)
			App.openMenu(entry.id)
		end)
	end
end

-- Avisos, banner e resumo -----------------------------------------------------------------------------

local TOAST_STYLE = {
	compra = { icon = Icons.check, color = T.green },
	dinheiro = { icon = Icons.coin, color = T.gold },
	nivel = { icon = Icons.star, color = T.purple },
	erro = { icon = Icons.alert, color = T.red },
	info = { icon = Icons.info, color = T.blue },
	missao = { icon = Icons.star, color = T.gold },
}
local toastCount = 0

local function buildToasts()
	refs.toasts = UI.scaled(create("Frame", {
		Name = "Avisos",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.fromOffset(420, 300),
		BackgroundTransparency = 1,
		Parent = screen,
	}))
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = refs.toasts

	local overlay = UI.newScreen("AdegaDestaques", 20, true)
	local banner = UI.panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(460, 190), Visible = false, Parent = overlay })
	banner.UICorner.CornerRadius = UDim.new(0, 26)
	refs.bannerScale = create("UIScale", { Parent = banner })
	local top = create("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = T.gold, BorderSizePixel = 0, Parent = banner }, { UI.corner(26) })
	create("Frame", { Position = UDim2.new(0, 0, 1, -26), Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = T.gold, BorderSizePixel = 0, Parent = top })
	refs.bannerKicker = label({ Text = "NOVO NÍVEL", FontFace = F.heavy, TextSize = 15, TextColor3 = rgb(255, 236, 200), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 18), Parent = top })
	refs.bannerTitle = label({ Text = "", FontFace = F.heavy, TextSize = 36, TextColor3 = rgb(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 40), Parent = top })
	refs.bannerSub = label({ Text = "", FontFace = F.bold, TextSize = 16, TextWrapped = true, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(24, 80), Size = UDim2.new(1, -48, 0, 96), Parent = banner })
	refs.banner = banner
end

function Hud.toast(text, kind)
	local style = TOAST_STYLE[kind] or TOAST_STYLE.info
	toastCount += 1
	local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(420, 52), LayoutOrder = toastCount, Parent = refs.toasts })
	local box = UI.panel({ Position = UDim2.fromOffset(0, -16), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = holder })
	create("Frame", { Position = UDim2.fromOffset(0, 0), Size = UDim2.new(0, 6, 1, 0), BackgroundColor3 = style.color, BorderSizePixel = 0, Parent = box }, { UI.corner(3) })
	local icon = style.icon(26, style.color)
	icon.Position = UDim2.fromOffset(18, 13)
	icon.Parent = box
	label({ Text = text, FontFace = F.bold, TextSize = 15, TextWrapped = true, Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -68, 1, 0), Parent = box })
	UI.tween(box, 0.28, { Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
	local frames = {}
	for _, child in refs.toasts:GetChildren() do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames > 4 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #frames - 4 do
			frames[i]:Destroy()
		end
	end
	task.delay(3.6, function()
		if holder.Parent then
			UI.tween(box, 0.25, { Position = UDim2.fromOffset(0, -10), BackgroundTransparency = 1 })
			for _, child in box:GetDescendants() do
				if child:IsA("TextLabel") then
					UI.tween(child, 0.25, { TextTransparency = 1 })
				elseif child:IsA("Frame") then
					UI.tween(child, 0.25, { BackgroundTransparency = 1 })
				elseif child:IsA("UIStroke") then
					UI.tween(child, 0.25, { Transparency = 1 })
				end
			end
			task.wait(0.27)
			holder:Destroy()
		end
	end)
end

function Hud.banner(title, subtitle)
	local banner = refs.banner
	refs.bannerTitle.Text = title
	refs.bannerSub.Text = subtitle or ""
	banner.Visible = true
	refs.bannerScale.Scale = 0.4 * UI.currentScale()
	UI.tween(refs.bannerScale, 0.45, { Scale = UI.currentScale() }, Enum.EasingStyle.Back)
	local token = {}
	refs.bannerToken = token
	task.delay(3.4, function()
		if refs.bannerToken ~= token then
			return
		end
		UI.tween(refs.bannerScale, 0.25, { Scale = 0.4 * UI.currentScale() }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.wait(0.25)
		if refs.bannerToken == token then
			banner.Visible = false
		end
	end)
end

function Hud.summary(data)
	local win = refs.summary
	if win == nil then
		win = UI.window("Fim de expediente", "Como foi o dia na sua adega", T.gold, UDim2.fromOffset(520, 420))
		local body = win.body
		UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center).Parent = body
		local rows = {}
		for index, spec in { { Icons.people, T.blue, "Clientes atendidos" }, { Icons.coin, T.gold, "Faturamento" }, { Icons.star, T.gold, "Nota média do dia" } } do
			local row = UI.panel({ Size = UDim2.new(1, 0, 0, 62), LayoutOrder = index, Parent = body })
			local icon = spec[1](30, spec[2])
			icon.Position = UDim2.fromOffset(18, 16)
			icon.Parent = row
			label({ Text = spec[3], FontFace = F.bold, TextSize = 17, TextColor3 = T.muted, Position = UDim2.fromOffset(62, 0), Size = UDim2.new(1, -220, 1, 0), Parent = row })
			rows[index] = label({ Text = "", FontFace = F.heavy, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -170, 0, 0), Size = UDim2.fromOffset(150, 62), Parent = row })
		end
		UI.button({ Style = "gold", Text = "Bora pra mais um dia", Size = UDim2.fromOffset(280, 50), LayoutOrder = 5, Parent = body }, function()
			win.hide()
		end)
		win.rows = rows
		refs.summary = win
	end
	win.rows[1].Text = tostring(data.served or 0)
	win.rows[2].Text = App.Util.formatMoney(data.earned or 0)
	win.rows[3].Text = if data.rating then App.Util.formatDecimal(data.rating) else "—"
	win.show()
end

-- Atualização ------------------------------------------------------------------------------------

function Hud.update(state, previous)
	UI.tween(refs.shownCash, 0.45, { Value = state.cash })
	if previous and state.cash > previous.cash then
		refs.pendingGain = (refs.pendingGain or 0) + state.cash - previous.cash
	end
	refs.level.Text = tostring(state.level)
	local ratio = if state.level >= App.Config.MaxLevel then 1 else math.clamp(state.xp / state.xpNext, 0, 1)
	UI.tween(refs.xpFill, 0.3, { Size = UDim2.fromScale(ratio, 1) })
	refs.xpText.Text = if state.level >= App.Config.MaxLevel then "Nível máximo" else App.Util.formatNumber(state.xp) .. " / " .. App.Util.formatNumber(state.xpNext) .. " XP"

	local quest = state.quest
	refs.quest.Visible = quest ~= nil
	if quest then
		refs.questTitle.Text = "MISSÃO " .. quest.index .. " DE " .. quest.total
		refs.questText.Text = quest.text
		refs.questFill.Size = UDim2.fromScale(quest.progress / quest.target, 1)
		refs.questProgress.Text = quest.progress .. "/" .. quest.target
		refs.questReward.Text = "+" .. App.Util.formatMoney(quest.reward)
	end
	refs.orders.Position = UDim2.fromOffset(16, if quest then 200 else 96)

	refs.chipPeople.Text = state.present .. (if state.present == 1 then " cliente" else " clientes")
	refs.chipFree.Text = state.freeTables .. (if state.freeTables == 1 then " mesa livre" else " mesas livres")
	refs.chipDirty.Text = state.dirtyTables .. (if state.dirtyTables == 1 then " mesa suja" else " mesas sujas")
	refs.chipDirtyFrame.Visible = state.dirtyTables > 0
	refs.chipMoney.Text = App.Util.formatMoney(state.tableMoney) .. " nas mesas"
	refs.chipMoneyFrame.Visible = state.tableMoney > 0

	refs.rating.Text = App.Util.formatDecimal(state.rating)

	updateOrders(state)
	updateCarry(state)
	updateHint(state)

	refs.menuBadges.equipe.Visible = #state.staff == 0 and state.cash >= 300
	local nextSize = App.Config.PlotSizes[state.sizeLevel + 1]
	refs.menuBadges.expandir.Visible = nextSize ~= nil and state.level >= nextSize.level and state.cash >= nextSize.price
end

function Hud.setBuildMode(on)
	refs.buildMode = on
	refs.menu.Visible = not on
	refs.orders.Visible = not on
	if App.state then
		updateCarry(App.state)
		updateHint(App.state)
	end
end

local function floatingGain(amount)
	local gain = label({
		Text = "+" .. App.Util.formatMoney(amount),
		FontFace = F.heavy,
		TextSize = 22,
		TextColor3 = T.green,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 4),
		Size = UDim2.fromOffset(200, 26),
		ZIndex = 5,
		Parent = refs.moneyAnchor,
	})
	local stroke = create("UIStroke", { Color = rgb(255, 255, 255), Thickness = 2, Parent = gain })
	UI.tween(gain, 1.1, { Position = UDim2.new(0.5, 0, 1, 36), TextTransparency = 1 })
	UI.tween(stroke, 1.1, { Transparency = 1 })
	task.delay(1.2, function()
		gain:Destroy()
	end)
end

function Hud.init(app)
	App = app
	screen = UI.newScreen("AdegaHUD", 1, false)
	buildProfile()
	buildStatus()
	buildOrders()
	buildCarry()
	buildMenu()
	buildToasts()

	task.spawn(function()
		while true do
			task.wait(0.25)
			local hour = Lighting.ClockTime
			refs.clock.Text = App.Util.clockText(hour)
			refs.setClock(hour)
			if hour >= 18 or hour < 2 then
				refs.period.Text = "Horário nobre"
				refs.period.TextColor3 = T.goldDark
			elseif hour < 6 then
				refs.period.Text = "Madrugada calma"
				refs.period.TextColor3 = T.muted
			else
				refs.period.Text = "Movimento normal"
				refs.period.TextColor3 = T.muted
			end
			if refs.pendingGain and refs.pendingGain > 0 then
				floatingGain(refs.pendingGain)
				refs.pendingGain = 0
			end
		end
	end)
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000012">
					<Properties>
						<string name="Name">Icons</string>
						<ProtectedString name="Source"><![CDATA[-- Icons: ícones desenhados com formas simples (sem emojis nem imagens externas).
-- Cada função recebe o tamanho em pixels e devolve um Frame transparente com o desenho.

local UI = require(script.Parent.UI)

local Icons = {}

local create = UI.create
local rgb = Color3.fromRGB

local function canvas(size, props)
	local frame = create("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
	for key, value in props or {} do
		frame[key] = value
	end
	return frame
end

-- Retângulo pelo centro, em frações do ícone (0 a 1).
local function shape(parent, cx, cy, w, h, color, radius, rotation, props)
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(cx, cy),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rotation or 0,
		Parent = parent,
	})
	if radius then
		create("UICorner", { CornerRadius = if radius == "full" then UDim.new(1, 0) else UDim.new(radius, 0), Parent = frame })
	end
	for key, value in props or {} do
		frame[key] = value
	end
	return frame
end
Icons.shape = shape

local function glyph(parent, text, color, scale)
	return UI.label({
		Text = text,
		FontFace = UI.F.heavy,
		TextScaled = true,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(scale or 0.7, scale or 0.7),
		Parent = parent,
	})
end

function Icons.coin(size)
	local c = canvas(size)
	shape(c, 0.5, 0.5, 1, 1, rgb(255, 179, 0), "full")
	shape(c, 0.5, 0.5, 0.74, 0.74, rgb(255, 205, 64), "full")
	glyph(c, "$", rgb(196, 110, 0), 0.62)
	return c
end

-- Relógio com ponteiros; devolve (frame, função para acertar a hora).
function Icons.clock(size, color)
	local c = canvas(size)
	local face = shape(c, 0.5, 0.5, 1, 1, rgb(255, 255, 255), "full")
	create("UIStroke", { Color = color or rgb(36, 31, 46), Thickness = math.max(2, size / 12), Parent = face })
	local function hand(length, width)
		local pivot = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = c })
		shape(pivot, 0.5, 0.5 - length / 2, width, length, color or rgb(36, 31, 46), "full")
		return pivot
	end
	local hourHand = hand(0.28, 0.1)
	local minuteHand = hand(0.38, 0.07)
	shape(c, 0.5, 0.5, 0.14, 0.14, color or rgb(36, 31, 46), "full")
	local function set(hour)
		local h = hour % 12
		local m = (hour - math.floor(hour)) * 60
		hourHand.Rotation = (h + m / 60) * 30
		minuteHand.Rotation = m * 6
	end
	return c, set
end

function Icons.person(size, color)
	local c = canvas(size)
	shape(c, 0.5, 0.3, 0.42, 0.42, color, "full")
	shape(c, 0.5, 0.86, 0.78, 0.5, color, 0.45)
	return c
end

function Icons.people(size, color)
	local c = canvas(size)
	shape(c, 0.68, 0.32, 0.32, 0.32, color, "full", 0, { BackgroundTransparency = 0.35 })
	shape(c, 0.7, 0.78, 0.5, 0.36, color, 0.45, 0, { BackgroundTransparency = 0.35 })
	shape(c, 0.38, 0.3, 0.38, 0.38, color, "full")
	shape(c, 0.38, 0.82, 0.62, 0.42, color, 0.45)
	return c
end

function Icons.hammer(size, color)
	local c = canvas(size)
	shape(c, 0.44, 0.56, 0.14, 0.72, color, 0.4, 45)
	shape(c, 0.64, 0.34, 0.6, 0.24, color, 0.2, 45)
	return c
end

-- inner: cor dos detalhes internos (use a cor do fundo quando o ícone for branco)
function Icons.clipboard(size, color, inner)
	local c = canvas(size)
	shape(c, 0.5, 0.55, 0.72, 0.84, color, 0.16)
	shape(c, 0.5, 0.14, 0.36, 0.14, color, "full")
	for i = 0, 2 do
		shape(c, 0.5, 0.4 + i * 0.17, 0.44, 0.07, inner or rgb(255, 255, 255), "full")
	end
	return c
end

function Icons.star(size, color)
	local c = canvas(size)
	glyph(c, "★", color, 1.05)
	return c
end

function Icons.expand(size, color)
	local c = canvas(size)
	local t = 0.12
	for _, corner in { { 0.15, 0.15, 1, 1 }, { 0.85, 0.15, -1, 1 }, { 0.15, 0.85, 1, -1 }, { 0.85, 0.85, -1, -1 } } do
		local x, y, dx, dy = corner[1], corner[2], corner[3], corner[4]
		shape(c, x + dx * 0.14, y, 0.34, t, color, "full")
		shape(c, x, y + dy * 0.14, t, 0.34, color, "full")
	end
	return c
end

function Icons.palette(size, color, inner)
	local c = canvas(size)
	shape(c, 0.5, 0.5, 0.96, 0.9, color, "full")
	shape(c, 0.3, 0.38, 0.18, 0.18, rgb(255, 69, 58), "full")
	shape(c, 0.52, 0.26, 0.18, 0.18, rgb(255, 204, 0), "full")
	shape(c, 0.74, 0.4, 0.18, 0.18, rgb(0, 122, 255), "full")
	shape(c, 0.62, 0.68, 0.2, 0.2, inner or rgb(255, 255, 255), "full")
	return c
end

function Icons.home(size, color, inner)
	local c = canvas(size)
	shape(c, 0.5, 0.36, 0.58, 0.58, color, 0.12, 45)
	shape(c, 0.5, 0.7, 0.66, 0.5, color, 0.1)
	shape(c, 0.5, 0.8, 0.2, 0.3, inner or rgb(255, 255, 255), 0.3)
	return c
end

function Icons.check(size, color)
	local c = canvas(size)
	shape(c, 0.38, 0.6, 0.14, 0.38, color, "full", -45)
	shape(c, 0.6, 0.48, 0.14, 0.66, color, "full", 40)
	return c
end

function Icons.alert(size, color)
	local c = canvas(size)
	shape(c, 0.5, 0.5, 1, 1, color, "full")
	glyph(c, "!", rgb(255, 255, 255), 0.7)
	return c
end

function Icons.info(size, color)
	local c = canvas(size)
	shape(c, 0.5, 0.5, 1, 1, color, "full")
	glyph(c, "i", rgb(255, 255, 255), 0.66)
	return c
end

function Icons.lock(size, color)
	local c = canvas(size)
	local ring = shape(c, 0.5, 0.38, 0.5, 0.56, rgb(0, 0, 0), "full", 0, { BackgroundTransparency = 1 })
	create("UIStroke", { Color = color, Thickness = math.max(2, size / 9), Parent = ring })
	shape(c, 0.5, 0.7, 0.72, 0.5, color, 0.18)
	return c
end

function Icons.cart(size, color)
	local c = canvas(size)
	shape(c, 0.52, 0.45, 0.72, 0.42, color, 0.15)
	shape(c, 0.14, 0.2, 0.22, 0.09, color, "full")
	shape(c, 0.34, 0.86, 0.16, 0.16, color, "full")
	shape(c, 0.72, 0.86, 0.16, 0.16, color, "full")
	return c
end

function Icons.chair(size, color)
	local c = canvas(size)
	shape(c, 0.3, 0.32, 0.12, 0.6, color, "full")
	shape(c, 0.5, 0.58, 0.52, 0.12, color, "full")
	shape(c, 0.68, 0.8, 0.1, 0.36, color, "full")
	shape(c, 0.3, 0.8, 0.1, 0.36, color, "full")
	return c
end

function Icons.dot(size, color)
	local c = canvas(size)
	shape(c, 0.5, 0.5, 1, 1, color, "full")
	return c
end

return Icons
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000013">
					<Properties>
						<string name="Name">Panels</string>
						<ProtectedString name="Source"><![CDATA[-- Panels: janelas de Equipe (com retratos e personalização), Cardápio, Avaliações, Expandir e Estilo.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Looks = require(ReplicatedStorage:WaitForChild("AdegaShared"):WaitForChild("Looks"))

local Panels = {}

local T = UI.T
local F = UI.F
local create = UI.create
local label = UI.label
local rgb = Color3.fromRGB

local App
local windows: { [string]: any } = {}

local ROLE_COLORS = {
	garcom = T.blue,
	bartender = T.gold,
	faxineiro = T.teal,
	atendente = T.pink,
	seguranca = rgb(70, 70, 82),
	dj = T.purple,
}

local function lighten(color, amount)
	return color:Lerp(rgb(255, 255, 255), amount)
end

local function lookKey(look)
	return table.concat({ look.skin, look.shirt, look.pants, look.shoes, look.hair, look.hairColor }, ":")
end

local function clear(container)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function sectionTitle(parent, text, order)
	return label({ Text = text, FontFace = F.heavy, TextSize = 14, TextColor3 = T.muted, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order or 0, Parent = parent })
end

-- Abas no topo de uma janela.
local function tabs(parent, entries, onSelect)
	local bar = create("Frame", { Size = UDim2.fromOffset(0, 40), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = T.cardDark, Parent = parent }, {
		UI.corner("full"),
		UI.pad(4),
		UI.list(Enum.FillDirection.Horizontal, 4),
	})
	local buttons = {}
	local function choose(id)
		for key, button in buttons do
			local on = key == id
			button.BackgroundTransparency = if on then 0 else 1
			button.TextColor3 = if on then T.text else T.muted
		end
		onSelect(id)
	end
	for index, entry in entries do
		local button = create("TextButton", {
			Text = entry.text,
			FontFace = F.extra,
			TextSize = 15,
			AutoButtonColor = false,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 32),
			BackgroundColor3 = T.panel,
			LayoutOrder = index,
			Parent = bar,
		}, { UI.corner("full"), UI.pad(0, 18, 0, 18) })
		buttons[entry.id] = button
		button.Activated:Connect(function()
			choose(entry.id)
		end)
	end
	return bar, choose, buttons
end

-- Personalização de funcionário ---------------------------------------------------------------------

local function swatchRow(parent, colors, order, onPick)
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	create("UIGridLayout", { CellSize = UDim2.fromOffset(38, 38), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
	local buttons = {}
	for index, color in colors do
		local button = create("TextButton", { Text = "", AutoButtonColor = false, BackgroundColor3 = color, LayoutOrder = index, Parent = row }, {
			UI.corner("full"),
			UI.stroke(rgb(0, 0, 0), 1, 0.85),
		})
		buttons[index] = button
		button.Activated:Connect(function()
			onPick(index)
		end)
	end
	local function mark(selected)
		for index, button in buttons do
			local stroke = button:FindFirstChildOfClass("UIStroke")
			stroke.Color = if index == selected then T.gold else rgb(0, 0, 0)
			stroke.Thickness = if index == selected then 3 else 1
			stroke.Transparency = if index == selected then 0 else 0.85
		end
	end
	return mark
end

local function buildCustomizer()
	local win = UI.window("Visual do funcionário", "Escolha roupa, cabelo e cor de pele", T.blue, UDim2.fromOffset(960, 620))
	local body = win.body

	local stage = UI.panel({ Size = UDim2.new(0, 330, 1, 0), BackgroundColor3 = T.panel, Parent = body })
	create("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -86), Size = UDim2.fromOffset(220, 30), BackgroundColor3 = T.cardDark, Parent = stage }, { UI.corner("full") })
	local nameBox = create("TextBox", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(1, -36, 0, 46),
		BackgroundColor3 = T.card,
		Text = "",
		PlaceholderText = "Nome",
		FontFace = F.extra,
		TextSize = 20,
		TextColor3 = T.text,
		ClearTextOnFocus = false,
		Parent = stage,
	}, { UI.corner(12) })
	win.nameBox = nameBox

	local right = create("Frame", { Position = UDim2.fromOffset(346, 0), Size = UDim2.new(1, -346, 1, 0), BackgroundTransparency = 1, Parent = body })
	local scroll = UI.scroll(right, { Size = UDim2.new(1, 0, 1, -64) })
	UI.list(Enum.FillDirection.Vertical, 10).Parent = scroll
	UI.pad(0, 8, 8, 0).Parent = scroll

	win.marks = {}
	local function refreshPreview()
		if win.model then
			Looks.apply(win.model, win.look)
		end
		win.marks.skin(win.look.skin)
		win.marks.shirt(win.look.shirt)
		win.marks.pants(win.look.pants)
		win.marks.shoes(win.look.shoes)
		win.marks.hairColor(win.look.hairColor)
		for id, button in win.hairButtons do
			local on = id == win.look.hair
			button.BackgroundColor3 = if on then T.gold else T.panel
			button.TextColor3 = if on then rgb(255, 255, 255) else T.text
		end
	end
	local function picker(order, title, field, colors)
		sectionTitle(scroll, title, order)
		win.marks[field] = swatchRow(scroll, colors, order + 1, function(index)
			win.look[field] = index
			refreshPreview()
		end)
	end
	picker(1, "PELE", "skin", Looks.Skins)
	picker(3, "CAMISA E BONÉ", "shirt", Looks.Colors)
	picker(5, "CALÇA", "pants", Looks.Colors)
	picker(7, "SAPATO", "shoes", Looks.Colors)
	sectionTitle(scroll, "CABELO OU CHAPÉU", 9)
	local hairRow = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 10, Parent = scroll })
	create("UIGridLayout", { CellSize = UDim2.fromOffset(128, 38), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = hairRow })
	win.hairButtons = {}
	for index, hair in Looks.Hairs do
		local button = create("TextButton", { Text = hair.name, FontFace = F.extra, TextSize = 14, AutoButtonColor = false, BackgroundColor3 = T.panel, TextColor3 = T.text, LayoutOrder = index, Parent = hairRow }, {
			UI.corner(10),
			UI.stroke(rgb(0, 0, 0), 1, 0.88),
		})
		win.hairButtons[hair.id] = button
		button.Activated:Connect(function()
			win.look.hair = hair.id
			refreshPreview()
		end)
	end
	picker(11, "COR DO CABELO", "hairColor", Looks.HairColors)

	local actions = create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = right })
	UI.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right).Parent = actions
	UI.button({ Style = "light", Text = "Sortear", Size = UDim2.fromOffset(150, 50), LayoutOrder = 1, Parent = actions }, function()
		local random = Looks.random()
		random.shirt, random.pants = win.look.shirt, win.look.pants
		win.look = random
		refreshPreview()
	end)
	UI.button({ Style = "green", Text = "Salvar visual", Size = UDim2.fromOffset(200, 50), LayoutOrder = 2, Parent = actions }, function()
		local result = App.invoke("visual", { id = win.staffId, look = win.look, name = nameBox.Text })
		if result and result.ok then
			win.hide()
		end
	end)

	function win.edit(member)
		win.staffId = member.id
		win.look = table.clone(Looks.sanitize(member.look))
		nameBox.Text = member.name
		if win.viewport then
			win.viewport:Destroy()
		end
		local viewport, model = UI.avatar(win.look, 300, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.new(1, -20, 1, -110) }, true)
		viewport.Parent = stage
		win.viewport, win.model = viewport, model
		refreshPreview()
		win.show()
	end
	win.onShow = function()
		local angle = 0
		win.spin = RunService.RenderStepped:Connect(function(dt)
			angle += dt * 0.8
			if win.model and win.model.PrimaryPart then
				win.model:PivotTo(CFrame.new(win.model:GetPivot().Position) * CFrame.Angles(0, math.pi + math.sin(angle) * 0.6, 0))
			end
		end)
	end
	win.onHide = function()
		if win.spin then
			win.spin:Disconnect()
			win.spin = nil
		end
	end
	return win
end

-- Equipe ------------------------------------------------------------------------------------------

local function staffCard(parent, look, color, order)
	local card = UI.panel({ LayoutOrder = order, Parent = parent })
	local portrait = create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 150), BackgroundColor3 = lighten(color, 0.78), ClipsDescendants = true, Parent = card }, { UI.corner(12) })
	local viewport = UI.avatar(look, 150, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(170, 150), Parent = portrait })
	return card, portrait, viewport
end

local function buildStaff()
	local win = UI.window("Equipe", "Contrate gente para tocar a adega com você", T.blue, UDim2.fromOffset(940, 620))
	local body = win.body
	local pages = {}
	local _, selectTab, tabButtons = tabs(body, { { id = "equipe", text = "Sua equipe" }, { id = "contratar", text = "Contratar" } }, function(id)
		for key, page in pages do
			page.Visible = key == id
		end
	end)
	win.tabButtons = tabButtons

	local function grid(name)
		local page = UI.scroll(body, { Name = name, Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 1, -54) })
		create("UIGridLayout", { CellSize = UDim2.fromOffset(204, 336), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
		UI.pad(2, 2, 12, 2).Parent = page
		pages[name] = page
		return page
	end
	local teamPage = grid("equipe")
	local hirePage = grid("contratar")
	win.empty = label({ Text = "Ninguém contratado ainda. Comece por um garçom na aba Contratar.", FontFace = F.bold, TextSize = 16, TextColor3 = T.muted, TextWrapped = true, Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 40), Visible = false, Parent = body })

	-- contratar
	win.hireButtons = {}
	for index, role in App.Config.Staff do
		local look = Looks.sanitize(role.look)
		look.skin = (index % #Looks.Skins) + 1
		local card = staffCard(hirePage, look, ROLE_COLORS[role.id], index)
		label({ Text = role.name, FontFace = F.heavy, TextSize = 19, Position = UDim2.fromOffset(14, 168), Size = UDim2.new(1, -28, 0, 22), Parent = card })
		label({ Text = role.desc, FontFace = F.medium, TextSize = 13, TextColor3 = T.muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(14, 194), Size = UDim2.new(1, -28, 0, 72), Parent = card })
		local button = UI.button({ Position = UDim2.new(0, 12, 1, -56), Size = UDim2.new(1, -24, 0, 44), TextSize = 15, Parent = card }, function()
			if win.hireStatus and win.hireStatus[role.id] == "ok" then
				App.invoke("contratar", { role = role.id })
			else
				UI.shake(card)
			end
		end)
		win.hireButtons[role.id] = button
	end

	win.cards = {}
	function win.refresh(state)
		win.subtitle.Text = "Funcionários: " .. #state.staff .. " de " .. state.maxStaff .. ". O limite aumenta conforme a adega sobe de nível."
		tabButtons.equipe.Text = "Sua equipe (" .. #state.staff .. ")"
		win.hireStatus = {}
		for _, role in App.Config.Staff do
			local button = win.hireButtons[role.id]
			local status
			if state.level < role.level then
				status = "level"
				button.Text = "Libera no nível " .. role.level
				UI.setButtonStyle(button, "locked")
			elseif #state.staff >= state.maxStaff then
				status = "full"
				button.Text = "Equipe cheia"
				UI.setButtonStyle(button, "locked")
			else
				status = if state.cash >= role.hire then "ok" else "money"
				button.Text = "Contratar  " .. App.Util.formatMoney(role.hire)
				UI.setButtonStyle(button, if status == "ok" then "green" else "light")
			end
			win.hireStatus[role.id] = status
		end

		win.empty.Visible = #state.staff == 0 and pages.equipe.Visible
		local seen = {}
		for index, member in state.staff do
			seen[member.id] = true
			local role = App.Config.staffById(member.role)
			local entry = win.cards[member.id]
			local key = lookKey(member.look)
			if entry and entry.key ~= key then
				entry.card:Destroy()
				entry = nil
			end
			if entry == nil then
				local card = staffCard(teamPage, member.look, ROLE_COLORS[role.id], index)
				local name = label({ Text = "", FontFace = F.heavy, TextSize = 19, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 168), Size = UDim2.new(1, -28, 0, 22), Parent = card })
				UI.chip(card, role.name, ROLE_COLORS[role.id], { Position = UDim2.fromOffset(14, 194) })
				local stars = label({ Text = "", FontFace = F.heavy, TextSize = 16, TextColor3 = T.gold, RichText = true, Position = UDim2.fromOffset(14, 220), Size = UDim2.new(1, -28, 0, 18), Parent = card })
				local custom = UI.button({ Style = "blue", Text = "Personalizar", Position = UDim2.new(0, 12, 1, -94), Size = UDim2.new(1, -24, 0, 38), TextSize = 14, Parent = card })
				local train = UI.button({ Position = UDim2.new(0, 12, 1, -50), Size = UDim2.new(1, -64, 0, 38), TextSize = 14, Parent = card })
				local fire = UI.button({ Style = "light", Text = "", Position = UDim2.new(1, -46, 1, -50), Size = UDim2.fromOffset(34, 38), Parent = card })
				for _, angle in { 45, -45 } do
					create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 3), Rotation = angle, BackgroundColor3 = T.red, BorderSizePixel = 0, Parent = fire }, { UI.corner("full") })
				end
				entry = { card = card, name = name, stars = stars, train = train, fire = fire, key = key, confirm = false }
				custom.Activated:Connect(function()
					if win.members[member.id] then
						Panels.customizer().edit(win.members[member.id])
					end
				end)
				train.Activated:Connect(function()
					if entry.canTrain then
						App.invoke("treinar", { id = member.id })
					else
						UI.shake(card)
					end
				end)
				fire.Activated:Connect(function()
					if entry.confirm then
						App.invoke("demitir", { id = member.id })
					else
						entry.confirm = true
						App.toast("Clique de novo no X para demitir " .. member.name, "erro")
						task.delay(3, function()
							entry.confirm = false
						end)
					end
				end)
				win.cards[member.id] = entry
			end
			entry.card.LayoutOrder = index
			entry.name.Text = member.name
			entry.stars.Text = UI.stars(member.level) .. '  <font color="#847C92" size="13">' .. App.Util.formatDecimal(App.Config.staffSpeed(member.level)) .. "x mais rápido</font>"
			if member.train then
				entry.train.Text = "Treinar  " .. App.Util.formatMoney(member.train)
				entry.canTrain = state.cash >= member.train
				UI.setButtonStyle(entry.train, if entry.canTrain then "green" else "light")
			else
				entry.train.Text = "Nível máximo"
				entry.canTrain = false
				UI.setButtonStyle(entry.train, "locked")
			end
		end
		win.members = {}
		for _, member in state.staff do
			win.members[member.id] = member
		end
		for id, entry in win.cards do
			if not seen[id] then
				entry.card:Destroy()
				win.cards[id] = nil
			end
		end
	end
	selectTab("equipe")
	return win
end

-- Cardápio ------------------------------------------------------------------------------------------

local function buildMenu()
	local win = UI.window("Cardápio", "Cada estação do modo construção libera produtos novos", T.red)
	local grid = UI.scroll(win.body, { Size = UDim2.fromScale(1, 1) })
	create("UIGridLayout", { CellSize = UDim2.fromOffset(200, 236), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	UI.pad(2, 2, 12, 2).Parent = grid
	win.cards = {}
	for index, product in App.Config.Products do
		local card = UI.panel({ LayoutOrder = index, Parent = grid })
		local stage = create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 104), BackgroundColor3 = T.card, Parent = card }, { UI.corner(12) })
		local view = UI.product(product, 96, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = stage })
		label({ Text = product.name, FontFace = F.extra, TextSize = 15, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(14, 120), Size = UDim2.new(1, -28, 0, 36), Parent = card })
		label({ Text = App.Util.formatMoney(product.price), FontFace = F.heavy, TextSize = 20, TextColor3 = T.goldDark, Position = UDim2.fromOffset(14, 156), Size = UDim2.fromOffset(90, 22), Parent = card })
		label({ Text = "Preparo " .. App.Util.formatDecimal(product.prep) .. "s", FontFace = F.bold, TextSize = 13, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -110, 0, 158), Size = UDim2.fromOffset(96, 20), Parent = card })
		local status = label({ Text = "", FontFace = F.extra, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, Position = UDim2.new(0, 10, 1, -48), Size = UDim2.new(1, -20, 0, 38), Parent = card })
		UI.corner(10).Parent = status
		win.cards[product.id] = { status = status, view = view, station = App.Catalog.ById[product.station], product = product }
	end
	function win.refresh(state)
		local onMenu = {}
		for _, id in state.menu do
			onMenu[id] = true
		end
		for _, entry in win.cards do
			local product = entry.product
			if onMenu[product.id] then
				entry.status.Text = "No cardápio"
				entry.status.BackgroundColor3 = rgb(222, 247, 228)
				entry.status.TextColor3 = T.greenDark
				entry.view.ImageTransparency = 0
			elseif state.level < product.level then
				entry.status.Text = "Libera no nível " .. product.level
				entry.status.BackgroundColor3 = T.card
				entry.status.TextColor3 = T.muted
				entry.view.ImageTransparency = 0.55
			else
				entry.status.Text = "Coloque: " .. entry.station.name
				entry.status.BackgroundColor3 = rgb(255, 240, 214)
				entry.status.TextColor3 = T.goldDark
				entry.view.ImageTransparency = 0.25
			end
		end
	end
	return win
end

-- Avaliações ---------------------------------------------------------------------------------------

local function buildReviews()
	local win = UI.window("Avaliações", "O que os clientes estão achando da sua adega", rgb(255, 179, 0))
	local left = UI.panel({ Size = UDim2.new(0, 300, 1, 0), Parent = win.body })
	UI.pad(18).Parent = left
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = left
	win.big = label({ Text = "3,0", FontFace = F.heavy, TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 1, Parent = left })
	win.stars = label({ Text = "", FontFace = F.heavy, TextSize = 28, TextColor3 = rgb(255, 179, 0), RichText = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2, Parent = left })
	win.count = label({ Text = "", FontFace = F.medium, TextSize = 13, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Parent = left })
	win.rows = {}
	for index, name in { "Atendidos hoje", "Faturado hoje", "Total atendidos", "Pontos de ambiente", "Grupos por minuto" } do
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.card, LayoutOrder = 10 + index, Parent = left }, { UI.corner(10) })
		label({ Text = name, FontFace = F.bold, TextSize = 14, TextColor3 = T.muted, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Parent = row })
		win.rows[index] = label({ Text = "", FontFace = F.heavy, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -12, 1, 0), Parent = row })
	end
	label({ Text = "Atendimento rápido, decoração bonita e seguranças deixam os clientes mais felizes. Mais estrelas trazem mais gente e gorjeta maior.", FontFace = F.medium, TextSize = 12, TextColor3 = T.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 30, Parent = left })

	local list = UI.scroll(win.body, { Position = UDim2.fromOffset(316, 0), Size = UDim2.new(1, -316, 1, 0) })
	UI.list(Enum.FillDirection.Vertical, 10).Parent = list
	UI.pad(0, 6, 8, 0).Parent = list
	function win.refresh(state)
		win.big.Text = App.Util.formatDecimal(state.rating)
		win.stars.Text = UI.stars(state.rating)
		win.count.Text = "Média das últimas " .. state.ratingCount .. " avaliações"
		win.rows[1].Text = tostring(state.day.served)
		win.rows[2].Text = App.Util.formatMoney(state.day.earned)
		win.rows[3].Text = App.Util.formatNumber(state.totalServed)
		win.rows[4].Text = tostring(state.appeal)
		win.rows[5].Text = App.Util.formatDecimal(state.groupsPerMinute)
		local first = state.reviews[1]
		local signature = #state.reviews .. ":" .. (if first then first.name .. first.text .. state.ratingCount else "")
		if signature == win.signature then
			return
		end
		win.signature = signature
		clear(list)
		if #state.reviews == 0 then
			label({ Text = "Ainda sem avaliações. Atenda os primeiros clientes!", FontFace = F.bold, TextSize = 15, TextColor3 = T.muted, Size = UDim2.new(1, 0, 0, 40), Parent = list })
		end
		for index, review in state.reviews do
			local card = UI.panel({ Size = UDim2.new(1, 0, 0, 82), LayoutOrder = index, Parent = list })
			local initial = create("Frame", { Position = UDim2.fromOffset(14, 16), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = lighten(T.blue, 0.75), Parent = card }, { UI.corner("full") })
			label({ Text = string.sub(review.name, 1, 1), FontFace = F.heavy, TextSize = 18, TextColor3 = T.blue, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = initial })
			label({ Text = review.name, FontFace = F.extra, TextSize = 16, Position = UDim2.fromOffset(66, 12), Size = UDim2.new(1, -200, 0, 20), Parent = card })
			label({ Text = UI.stars(review.stars), FontFace = F.heavy, TextSize = 17, TextColor3 = rgb(255, 179, 0), RichText = true, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -134, 0, 12), Size = UDim2.fromOffset(120, 20), Parent = card })
			label({ Text = review.text, FontFace = F.medium, TextSize = 14, TextColor3 = T.muted, TextWrapped = true, Position = UDim2.fromOffset(66, 36), Size = UDim2.new(1, -80, 0, 36), Parent = card })
		end
	end
	return win
end

-- Expandir -------------------------------------------------------------------------------------------

local function buildExpand()
	local win = UI.window("Expandir terreno", "Mais espaço para mesas, bar e decoração", T.green, UDim2.fromOffset(780, 560))
	local preview = UI.panel({ Size = UDim2.fromOffset(300, 300), BackgroundColor3 = rgb(214, 232, 206), Parent = win.body })
	win.squares = {}
	local maxSize = App.Config.PlotSizes[#App.Config.PlotSizes].size
	for index = #App.Config.PlotSizes, 1, -1 do
		local tier = App.Config.PlotSizes[index]
		local side = 270 * tier.size / maxSize
		win.squares[index] = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -15),
			Size = UDim2.fromOffset(side, side),
			BackgroundColor3 = T.panel,
			ZIndex = 10 - index,
			Parent = preview,
		}, { UI.corner(8), UI.stroke(rgb(0, 0, 0), 1, 0.85) })
	end
	label({ Text = "A frente fica na calçada; a adega cresce para os lados e para o fundo.", FontFace = F.medium, TextSize = 13, TextColor3 = T.muted, TextWrapped = true, Position = UDim2.fromOffset(0, 312), Size = UDim2.fromOffset(300, 40), Parent = win.body })
	local list = create("Frame", { Position = UDim2.fromOffset(318, 0), Size = UDim2.new(1, -318, 1, 0), BackgroundTransparency = 1, Parent = win.body })
	UI.list(Enum.FillDirection.Vertical, 10).Parent = list
	win.rowsList = {}
	for index, tier in App.Config.PlotSizes do
		local row = UI.panel({ Size = UDim2.new(1, 0, 0, 66), LayoutOrder = index, Parent = list })
		label({ Text = tier.size .. " x " .. tier.size, FontFace = F.heavy, TextSize = 22, Position = UDim2.fromOffset(18, 0), Size = UDim2.fromOffset(120, 66), Parent = row })
		local info = label({ Text = "", FontFace = F.bold, TextSize = 13, TextColor3 = T.muted, Position = UDim2.fromOffset(132, 0), Size = UDim2.new(1, -300, 1, 0), Parent = row })
		local button = UI.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(156, 44), TextSize = 15, Parent = row }, function()
			if win.canBuy == index then
				App.invoke("expandir", {})
			else
				UI.shake(row)
			end
		end)
		win.rowsList[index] = { info = info, button = button }
	end
	function win.refresh(state)
		win.canBuy = nil
		for index, row in win.rowsList do
			local tier = App.Config.PlotSizes[index]
			win.squares[index].BackgroundColor3 = if index == state.sizeLevel then T.gold elseif index < state.sizeLevel then rgb(255, 214, 150) else T.panel
			win.squares[index].BackgroundTransparency = if index <= state.sizeLevel then 0 else 0.35
			if index <= state.sizeLevel then
				row.info.Text = if index == state.sizeLevel then "Seu tamanho atual" else "Já comprado"
				row.button.Text = "Comprado"
				UI.setButtonStyle(row.button, "ghost")
			elseif index == state.sizeLevel + 1 then
				row.info.Text = "Libera no nível " .. tier.level
				if state.level < tier.level then
					row.button.Text = "Nível " .. tier.level
					UI.setButtonStyle(row.button, "locked")
				else
					row.button.Text = App.Util.formatMoney(tier.price)
					local can = state.cash >= tier.price
					UI.setButtonStyle(row.button, if can then "green" else "light")
					if can then
						win.canBuy = index
					end
				end
			else
				row.info.Text = "Nível " .. tier.level .. " • " .. App.Util.formatMoney(tier.price)
				row.button.Text = "Bloqueado"
				UI.setButtonStyle(row.button, "locked")
			end
		end
	end
	return win
end

-- Estilo ------------------------------------------------------------------------------------------

local function buildStyle()
	local win = UI.window("Estilo", "Piso da adega e cor das paredes rebocadas", T.purple)
	local scroll = UI.scroll(win.body, { Size = UDim2.fromScale(1, 1) })
	UI.list(Enum.FillDirection.Vertical, 10).Parent = scroll
	UI.pad(0, 6, 10, 0).Parent = scroll
	win.entries = {}
	local function section(order, text, kind, list)
		sectionTitle(scroll, text, order)
		local grid = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, Parent = scroll })
		create("UIGridLayout", { CellSize = UDim2.fromOffset(196, 150), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		for index, option in list do
			local card = UI.panel({ LayoutOrder = index, Parent = grid })
			create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 60), BackgroundColor3 = option.color, Parent = card }, { UI.corner(10), UI.stroke(rgb(0, 0, 0), 1, 0.85) })
			label({ Text = option.name, FontFace = F.extra, TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(14, 76), Size = UDim2.new(1, -28, 0, 20), Parent = card })
			local button = UI.button({ Position = UDim2.new(0, 10, 1, -46), Size = UDim2.new(1, -20, 0, 36), TextSize = 14, Parent = card }, function()
				App.invoke("estilo", { kind = kind, id = option.id }, true)
			end)
			table.insert(win.entries, { kind = kind, option = option, card = card, button = button })
		end
	end
	section(1, "PISO", "floor", App.Config.Floors)
	section(10, "COR DAS PAREDES", "wall", App.Config.WallColors)
	function win.refresh(state)
		for _, entry in win.entries do
			local owned = if entry.kind == "floor" then state.ownedFloors else state.ownedWalls
			local active = if entry.kind == "floor" then state.style.floor else state.style.wall
			local id = entry.option.id
			local stroke = entry.card:FindFirstChildOfClass("UIStroke")
			if active == id then
				entry.button.Text = "Em uso"
				UI.setButtonStyle(entry.button, "gold")
				stroke.Color = T.gold
				stroke.Thickness = 2
				stroke.Transparency = 0
			else
				stroke.Color = rgb(0, 0, 0)
				stroke.Thickness = 1
				stroke.Transparency = 0.9
				if owned[id] then
					entry.button.Text = "Usar"
					UI.setButtonStyle(entry.button, "blue")
				else
					entry.button.Text = App.Util.formatMoney(entry.option.price)
					UI.setButtonStyle(entry.button, if state.cash >= entry.option.price then "green" else "light")
				end
			end
		end
	end
	return win
end

local BUILDERS = {
	equipe = buildStaff,
	cardapio = buildMenu,
	avaliacoes = buildReviews,
	expandir = buildExpand,
	estilo = buildStyle,
}

function Panels.customizer()
	if windows.visual == nil then
		windows.visual = buildCustomizer()
		windows.visual.refresh = function() end
	end
	return windows.visual
end

function Panels.open(name)
	local win = windows[name]
	if win == nil then
		local builder = BUILDERS[name]
		if builder == nil then
			return
		end
		win = builder()
		windows[name] = win
	end
	if win.open then
		win.hide()
		return
	end
	if App.state then
		win.refresh(App.state)
	end
	win.show()
end

function Panels.update(state)
	for _, win in windows do
		if win.open then
			win.refresh(state)
		end
	end
end

function Panels.init(app)
	App = app
end

return Panels
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000014">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[-- UI: tema e componentes da interface (cartões claros, botões, janelas, barras, ícones 3D).

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("AdegaShared")
local Models = require(Shared:WaitForChild("Models"))
local Looks = require(Shared:WaitForChild("Looks"))

local UI = {}

local rgb = Color3.fromRGB

UI.T = {
	panel = rgb(255, 255, 255),
	card = rgb(245, 243, 248),
	cardDark = rgb(232, 228, 238),
	bg = rgb(238, 235, 242),
	line = rgb(226, 221, 232),
	text = rgb(36, 31, 46),
	muted = rgb(132, 124, 146),
	gold = rgb(255, 149, 0),
	goldDark = rgb(222, 104, 0),
	green = rgb(52, 199, 89),
	greenDark = rgb(30, 150, 65),
	red = rgb(255, 69, 58),
	blue = rgb(0, 122, 255),
	purple = rgb(175, 82, 222),
	teal = rgb(48, 176, 199),
	pink = rgb(255, 55, 135),
	locked = rgb(214, 210, 220),
	dim = rgb(12, 8, 20),
}
local T = UI.T

local FAMILY = "rbxasset://fonts/families/BuilderSans.json"
UI.F = {
	regular = Font.new(FAMILY, Enum.FontWeight.Regular),
	medium = Font.new(FAMILY, Enum.FontWeight.Medium),
	bold = Font.new(FAMILY, Enum.FontWeight.Bold),
	extra = Font.new(FAMILY, Enum.FontWeight.ExtraBold),
	heavy = Font.new(FAMILY, Enum.FontWeight.Heavy),
}
local F = UI.F

function UI.create(className, props, children)
	local instance = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
local create = UI.create

function UI.corner(radius)
	return create("UICorner", { CornerRadius = if radius == "full" then UDim.new(1, 0) else UDim.new(0, radius or 12) })
end

function UI.stroke(color, thickness, transparency)
	return create("UIStroke", {
		Color = color or T.line,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.pad(top, right, bottom, left)
	right = right or top
	bottom = bottom or top
	left = left or right
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
	})
end

function UI.list(direction, padding, align, valign)
	return create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	})
end

function UI.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = F.bold,
		TextColor3 = T.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for key, value in props do
		defaults[key] = value
	end
	return create("TextLabel", defaults)
end

function UI.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Cartão branco com borda suave.
function UI.panel(props)
	local frame = create("Frame", {
		BackgroundColor3 = T.panel,
		BorderSizePixel = 0,
	})
	for key, value in props do
		frame[key] = value
	end
	UI.corner(16).Parent = frame
	UI.stroke(rgb(0, 0, 0), 1, 0.9).Parent = frame
	return frame
end

-- Botões --------------------------------------------------------------------------------------------
-- A cor vem do BackgroundColor3; o degradê é só claro/escuro (branco -> cinza), então o texto não some.

local BUTTON_STYLES = {
	green = { T.green, rgb(255, 255, 255) },
	gold = { T.gold, rgb(255, 255, 255) },
	red = { T.red, rgb(255, 255, 255) },
	blue = { T.blue, rgb(255, 255, 255) },
	purple = { T.purple, rgb(255, 255, 255) },
	light = { T.card, T.text },
	ghost = { T.card, T.muted },
	locked = { T.locked, rgb(120, 114, 132) },
}

function UI.button(props, onClick)
	local style = props.Style or "green"
	props.Style = nil
	local colors = BUTTON_STYLES[style]
	local button = create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = colors[1],
		FontFace = F.extra,
		TextSize = 16,
		TextColor3 = colors[2],
		Text = "",
		BorderSizePixel = 0,
	})
	for key, value in props do
		button[key] = value
	end
	UI.corner(12).Parent = button
	create("UIGradient", { Name = "Sombra", Color = ColorSequence.new(rgb(255, 255, 255), rgb(225, 225, 225)), Rotation = 90, Parent = button })
	local scale = create("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.08, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.setButtonStyle(button, style)
	local colors = BUTTON_STYLES[style]
	button.BackgroundColor3 = colors[1]
	button.TextColor3 = colors[2]
end

function UI.shake(frame)
	task.spawn(function()
		local origin = frame.Position
		for _, dx in { -8, 8, -5, 5, -2, 0 } do
			frame.Position = origin + UDim2.fromOffset(dx, 0)
			task.wait(0.035)
		end
		frame.Position = origin
	end)
end

-- Barra de progresso. Devolve (trilho, preenchimento).
function UI.bar(parent, props, color)
	local track = create("Frame", { BackgroundColor3 = T.cardDark, BorderSizePixel = 0, Parent = parent }, { UI.corner("full") })
	for key, value in props do
		track[key] = value
	end
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = color or T.gold, BorderSizePixel = 0, Parent = track }, { UI.corner("full") })
	return track, fill
end

function UI.stars(rating)
	local full = math.floor(rating)
	local half = rating - full >= 0.5
	local text = string.rep("★", full)
	local shown = full
	if half and full < 5 then
		text ..= '<font transparency="0.45">★</font>'
		shown += 1
	end
	if shown < 5 then
		text ..= '<font transparency="0.82">' .. string.rep("★", 5 - shown) .. "</font>"
	end
	return text
end

-- Pílula pequena com texto (etiquetas).
function UI.chip(parent, text, color, props)
	local chip = create("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		BackgroundColor3 = color or T.gold,
		Text = text,
		TextColor3 = rgb(255, 255, 255),
		FontFace = F.extra,
		TextSize = 12,
		Parent = parent,
	}, { UI.corner("full"), UI.pad(0, 9, 0, 9) })
	for key, value in props or {} do
		chip[key] = value
	end
	return chip
end

-- Objetos 3D em ViewportFrame ------------------------------------------------------------------------

local function frameCamera(viewport, model, direction, fov, tighten)
	local camera = Instance.new("Camera")
	camera.FieldOfView = fov or 30
	local center, extent = model:GetBoundingBox()
	local distance = extent.Magnitude / 2 / math.tan(math.rad(camera.FieldOfView / 2)) * (tighten or 1)
	camera.CFrame = CFrame.lookAt(center.Position + direction.Unit * distance, center.Position)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return camera
end

-- Bebida do cardápio em 3D.
function UI.product(product, size, props)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Ambient = rgb(205, 200, 215),
		LightColor = rgb(255, 250, 240),
		LightDirection = Vector3.new(-0.5, -1, -0.6),
	})
	for key, value in props or {} do
		viewport[key] = value
	end
	local model = Models.product(product, CFrame.new())
	model.Parent = viewport
	frameCamera(viewport, model, Vector3.new(0.35, 0.45, -1), 30, 1.02)
	return viewport
end

-- Retrato do boneco com a aparência dada. Devolve (viewport, modelo).
function UI.avatar(look, size, props, fullBody)
	local viewport = create("ViewportFrame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Ambient = rgb(200, 196, 210),
		LightColor = rgb(255, 250, 244),
		LightDirection = Vector3.new(-0.4, -0.8, -1),
	})
	for key, value in props or {} do
		viewport[key] = value
	end
	local template = Shared:FindFirstChild("BonecoModelo")
	if template == nil then
		return viewport, nil
	end
	local world = create("WorldModel", { Parent = viewport })
	local model = template:Clone()
	model:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi, 0))
	model.Parent = world
	Looks.apply(model, look)
	local camera = Instance.new("Camera")
	camera.FieldOfView = 28
	local head = model:FindFirstChild("Head")
	if fullBody or head == nil then
		local center, extent = model:GetBoundingBox()
		local distance = extent.Y / 2 / math.tan(math.rad(14)) * 1.08
		camera.CFrame = CFrame.lookAt(center.Position + Vector3.new(0.25, 0.1, 1).Unit * distance, center.Position)
	else
		local focus = head.Position - Vector3.new(0, 0.55, 0)
		camera.CFrame = CFrame.lookAt(focus + Vector3.new(0.35, 0.15, 1).Unit * 6.2, focus)
	end
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	return viewport, model
end

-- Escala ------------------------------------------------------------------------------------------

local scalers = {}

function UI.currentScale()
	local camera = workspace.CurrentCamera
	if camera == nil then
		return 1
	end
	local viewport = camera.ViewportSize
	if viewport.X < 50 then
		return 1
	end
	return math.clamp(math.min(viewport.X / 1366, viewport.Y / 768), 0.55, 1.2)
end

function UI.scaled(frame)
	local scaler = create("UIScale", { Scale = UI.currentScale(), Parent = frame })
	table.insert(scalers, scaler)
	return frame, scaler
end

function UI.applyScale()
	local value = UI.currentScale()
	for _, scaler in scalers do
		if scaler.Parent then
			scaler.Scale = value
		end
	end
end

function UI.isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function UI.newScreen(name, order, ignoreInset)
	return create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = ignoreInset == true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 0,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
end

-- Janelas -------------------------------------------------------------------------------------------

local modalScreen = nil
local openWindow = nil

function UI.closeButton(parent, onClick)
	local button = create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = T.card,
		Parent = parent,
	}, { UI.corner("full") })
	for _, angle in { 45, -45 } do
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(18, 3),
			Rotation = angle,
			BackgroundColor3 = T.muted,
			BorderSizePixel = 0,
			Parent = button,
		}, { UI.corner("full") })
	end
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = T.cardDark
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = T.card
	end)
	button.Activated:Connect(onClick)
	return button
end

-- accent: cor da faixa ao lado do título
function UI.window(title, subtitle, accent, size)
	if modalScreen == nil then
		modalScreen = UI.newScreen("AdegaJanelas", 10, true)
	end
	local dim = create("TextButton", {
		Name = title,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.dim,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = modalScreen,
	})
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size or UDim2.fromOffset(900, 580),
		BackgroundColor3 = T.bg,
		Active = true,
		Parent = dim,
	}, { UI.corner(24) })
	local scale = create("UIScale", { Parent = frame })
	local header = create("Frame", { Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = frame }, { UI.corner(24) })
	create("Frame", { Position = UDim2.new(0, 0, 1, -24), Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.panel, BorderSizePixel = 0, Parent = header })
	create("Frame", { Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.line, BorderSizePixel = 0, Parent = header })
	create("Frame", { Position = UDim2.fromOffset(28, 22), Size = UDim2.fromOffset(6, 40), BackgroundColor3 = accent or T.gold, BorderSizePixel = 0, Parent = header }, { UI.corner("full") })
	UI.label({ Text = title, FontFace = F.heavy, TextSize = 30, Position = UDim2.fromOffset(46, 14), Size = UDim2.new(1, -140, 0, 34), Parent = header })
	local sub = UI.label({ Text = subtitle or "", FontFace = F.medium, TextSize = 15, TextColor3 = T.muted, Position = UDim2.fromOffset(46, 48), Size = UDim2.new(1, -140, 0, 20), Parent = header })
	local body = create("Frame", { Position = UDim2.fromOffset(22, 102), Size = UDim2.new(1, -44, 1, -122), BackgroundTransparency = 1, Parent = frame })

	local win: { [string]: any } = { dim = dim, frame = frame, body = body, subtitle = sub, open = false }
	function win.show()
		if openWindow and openWindow ~= win then
			openWindow.hide()
		end
		openWindow = win
		win.open = true
		dim.Visible = true
		scale.Scale = UI.currentScale() * 0.9
		UI.tween(dim, 0.2, { BackgroundTransparency = 0.5 })
		UI.tween(scale, 0.3, { Scale = UI.currentScale() }, Enum.EasingStyle.Back)
		if win.onShow then
			win.onShow()
		end
	end
	function win.hide()
		if not win.open then
			return
		end
		win.open = false
		if openWindow == win then
			openWindow = nil
		end
		if win.onHide then
			win.onHide()
		end
		UI.tween(dim, 0.16, { BackgroundTransparency = 1 })
		UI.tween(scale, 0.16, { Scale = UI.currentScale() * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.16, function()
			if not win.open then
				dim.Visible = false
			end
		end)
	end
	function win.toggle()
		if win.open then
			win.hide()
		else
			win.show()
		end
	end
	UI.closeButton(header, win.hide).Position = UDim2.new(1, -22, 0, 22)
	dim.Activated:Connect(win.hide)
	return win
end

function UI.closeWindows()
	if openWindow then
		openWindow.hide()
	end
end

function UI.scroll(parent, props)
	local frame = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = rgb(180, 172, 190),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	for key, value in props do
		frame[key] = value
	end
	return frame
end

return UI
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
</roblox>
