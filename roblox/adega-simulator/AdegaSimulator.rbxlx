						<ProtectedString name="Source"><![CDATA[-- Hud: o que fica sempre na tela.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local UI = require(script.Parent.UI)

local Hud = {}

local T = UI.T
local F = UI.Fonts
local create = UI.create
local label = UI.label
local rgb = Color3.fromRGB

local App
local screen
local refs: { [string]: any } = {}

local STATE_STYLE = {
	waiting = { text = "❗ Anotar pedido", color = rgb(255, 160, 30) },
	open = { text = "⏳ Em preparo", color = rgb(70, 150, 255) },
}
local ITEM_COLORS = {
	new = rgb(70, 64, 92),
	pending = rgb(70, 64, 92),
	preparing = rgb(70, 150, 255),
	ready = rgb(56, 210, 116),
	carried = rgb(255, 196, 40),
	served = rgb(40, 34, 56),
}

-- Perfil e missão ----------------------------------------------------------------------------------

local function buildProfile()
	local profile = UI.scaled(UI.panel({ Name = "Perfil", Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(310, 78), Parent = screen }))
	local badge = create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(58, 58), BackgroundColor3 = rgb(255, 255, 255), Parent = profile }, {
		UI.corner("full"),
		UI.gradient(T.gold, T.orange),
		UI.stroke(rgb(255, 255, 255), 2, 0.4),
	})
	label({ Text = "NÍVEL", Font = F.black, TextSize = 10, TextColor3 = rgb(80, 40, 0), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 7), Size = UDim2.new(1, 0, 0, 12), Parent = badge })
	refs.level = label({ Text = "1", Font = F.title, TextSize = 28, TextColor3 = rgb(60, 25, 0), TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 32), Parent = badge })
	label({ Text = "Adega de " .. Players.LocalPlayer.DisplayName, TextSize = 17, TextTruncate = Enum.TextTruncate.AtEnd, Position = UDim2.fromOffset(80, 10), Size = UDim2.fromOffset(220, 22), Parent = profile })
	local xpTrack, fill = UI.bar(profile, { Position = UDim2.fromOffset(80, 42), Size = UDim2.fromOffset(218, 18) })
	refs.xpFill = fill
	refs.xpText = label({ Text = "", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = xpTrack })

	local quest = UI.scaled(UI.panel({ Name = "Missao", Position = UDim2.fromOffset(12, 96), Size = UDim2.fromOffset(310, 84), Parent = screen }))
	quest.UIStroke.Color = T.gold
	refs.quest = quest
	refs.questTitle = label({ Text = "MISSÃO", Font = F.black, TextSize = 11, TextColor3 = T.gold, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 14), Parent = quest })
	refs.questText = label({ Text = "", TextSize = 15, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(14, 24), Size = UDim2.new(1, -28, 0, 36), Parent = quest })
	local qTrack, qFill = UI.bar(quest, { Position = UDim2.fromOffset(14, 62), Size = UDim2.new(1, -120, 0, 12), ColorA = T.gold, ColorB = T.orange })
	refs.questFill = qFill
	refs.questProgress = label({ Text = "", TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = qTrack })
	refs.questReward = label({ Text = "", Font = F.title, TextSize = 15, TextColor3 = T.green, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -102, 0, 58), Size = UDim2.fromOffset(88, 20), Parent = quest })
end

-- Dinheiro e resumo ---------------------------------------------------------------------------------

local function buildMoney()
	local money = UI.scaled(UI.panel({ Name = "Dinheiro", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(280, 62), Parent = screen }))
	money.UIStroke.Color = T.gold
	money.UIStroke.Thickness = 2
	money.UIStroke.Transparency = 0.1
	create("Frame", { Position = UDim2.fromOffset(9, 8), Size = UDim2.fromOffset(46, 46), BackgroundColor3 = rgb(255, 255, 255), Parent = money }, {
		UI.corner("full"),
		UI.gradient(T.gold, T.orange),
		label({ Text = "💰", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }),
	})
	refs.money = label({ Text = "R$ 0", Font = F.title, TextSize = 34, TextColor3 = T.gold, Position = UDim2.fromOffset(64, 4), Size = UDim2.fromOffset(206, 54), Parent = money })
	create("UIStroke", { Color = rgb(90, 50, 0), Thickness = 1.2, Transparency = 0.4, Parent = refs.money })
	refs.moneyCard = money
	refs.shownCash = create("NumberValue", { Value = 0 })
	refs.shownCash.Changed:Connect(function(value)
		refs.money.Text = App.Util.formatMoney(value)
	end)

	local chips = UI.scaled(create("Frame", { Name = "Resumo", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 78), Size = UDim2.fromOffset(520, 28), BackgroundTransparency = 1, Parent = screen }))
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = chips })
	local function chip(order, color)
		local frame = create("Frame", { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), BackgroundColor3 = T.panel, BackgroundTransparency = 0.1, LayoutOrder = order, Parent = chips }, {
			UI.corner("full"),
			UI.stroke(color, 1.2, 0.3),
			UI.pad(0, 10, 0, 10),
		})
		return label({ Text = "", TextSize = 13, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Parent = frame }), frame
	end
	refs.chipPeople = chip(1, T.blue)
	refs.chipFree = chip(2, T.green)
	refs.chipDirty, refs.chipDirtyFrame = chip(3, T.cyan)
	refs.chipMoney, refs.chipMoneyFrame = chip(4, T.gold)
end

-- Relógio e avaliação -------------------------------------------------------------------------------

local function buildClock()
	local clock = UI.scaled(UI.panel({ Name = "Relogio", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(250, 84), Parent = screen }))
	refs.clockIcon = label({ Text = "☀️", TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(38, 36), Parent = clock })
	refs.clock = label({ Text = "16:30", Font = F.title, TextSize = 30, Position = UDim2.fromOffset(50, 4), Size = UDim2.fromOffset(100, 40), Parent = clock })
	refs.period = label({ Text = "", TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(14, 50), Size = UDim2.fromOffset(226, 24), TextWrapped = true, Parent = clock })
	refs.stars = label({ Text = "", Font = F.black, TextSize = 16, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Right, RichText = true, Position = UDim2.fromOffset(136, 8), Size = UDim2.fromOffset(102, 20), Parent = clock })
	refs.rating = label({ Text = "", Font = F.title, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.fromOffset(136, 28), Size = UDim2.fromOffset(102, 18), Parent = clock })
end

-- Pedidos -----------------------------------------------------------------------------------------

local function buildOrders()
	local panel = UI.scaled(UI.panel({ Name = "Pedidos", Position = UDim2.fromOffset(12, 190), Size = UDim2.fromOffset(310, 60), AutomaticSize = Enum.AutomaticSize.Y, Parent = screen }))
	UI.pad(10, 12, 12, 12).Parent = panel
	UI.list(Enum.FillDirection.Vertical, 6).Parent = panel
	label({ Text = "📋  PEDIDOS", Font = F.black, TextSize = 12, TextColor3 = T.muted, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 0, Parent = panel })
	refs.ordersEmpty = label({ Text = "Nenhum pedido agora. Os clientes chegam pela calçada.", Font = F.body, TextSize = 12, TextColor3 = T.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, Parent = panel })
	refs.orders = panel
	refs.tickets = {}
end

local function ticket(index)
	local existing = refs.tickets[index]
	if existing then
		return existing
	end
	local frame = create("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = T.card, LayoutOrder = index + 1, Parent = refs.orders }, { UI.corner(10) })
	local chip = create("Frame", { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(70, 22), BackgroundColor3 = T.blue, Parent = frame }, { UI.corner(8) })
	local place = label({ Text = "", Font = F.black, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = chip })
	local status = label({ Text = "", Font = F.body, TextSize = 11, TextColor3 = T.muted, Position = UDim2.fromOffset(6, 30), Size = UDim2.fromOffset(110, 14), Parent = frame })
	local icons = create("Frame", { Position = UDim2.fromOffset(122, 6), Size = UDim2.new(1, -128, 0, 30), BackgroundTransparency = 1, Parent = frame })
	UI.list(Enum.FillDirection.Horizontal, 4).Parent = icons
	local _, fill = UI.bar(frame, { Position = UDim2.new(0, 122, 1, -10), Size = UDim2.new(1, -128, 0, 5), ColorA = T.green, ColorB = T.green })
	local entry = { frame = frame, chip = chip, place = place, status = status, icons = icons, fill = fill, iconLabels = {} }
	refs.tickets[index] = entry
	return entry
end

local function updateOrders(state)
	local orders = state.orders
	refs.ordersEmpty.Visible = #orders == 0
	for index = 1, math.max(#orders, #refs.tickets) do
		local order = orders[index]
		if order == nil then
			if refs.tickets[index] then
				refs.tickets[index].frame.Visible = false
			end
			continue
		end
		local entry = ticket(index)
		entry.frame.Visible = true
		local style = STATE_STYLE[order.state] or STATE_STYLE.open
		entry.place.Text = order.label
		entry.chip.BackgroundColor3 = style.color
		entry.status.Text = style.text .. "  " .. order.wait .. "s"
		for i, icon in order.icons do
			local box = entry.iconLabels[i]
			if box == nil then
				box = create("Frame", { Size = UDim2.fromOffset(30, 30), BackgroundColor3 = T.locked, LayoutOrder = i, Parent = entry.icons }, { UI.corner(8) })
				label({ Name = "Icone", Text = "", TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box })
				entry.iconLabels[i] = box
			end
			box.Visible = true
			box.Icone.Text = icon[1]
			box.BackgroundColor3 = ITEM_COLORS[icon[2]] or T.locked
			box.Icone.TextTransparency = if icon[2] == "served" then 0.6 else 0
		end
		for i = #order.icons + 1, #entry.iconLabels do
			entry.iconLabels[i].Visible = false
		end
		local ratio = order.patience
		entry.fill.Size = UDim2.fromScale(ratio, 1)
		entry.fill.UIGradient.Color = ColorSequence.new(if ratio > 0.5 then T.green elseif ratio > 0.25 then T.gold else T.red)
	end
end

-- Bandeja e dica ---------------------------------------------------------------------------------------

local function buildCarry()
	local tray = UI.scaled(UI.panel({ Name = "Bandeja", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(330, 86), Visible = false, Parent = screen }))
	tray.UIStroke.Color = T.gold
	refs.trayTitle = label({ Text = "✋ BANDEJA", Font = F.black, TextSize = 11, TextColor3 = T.gold, Position = UDim2.fromOffset(14, 6), Size = UDim2.fromOffset(200, 14), Parent = tray })
	local slots = create("Frame", { Position = UDim2.fromOffset(12, 24), Size = UDim2.new(1, -24, 0, 54), BackgroundTransparency = 1, Parent = tray })
	UI.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center).Parent = slots
	refs.traySlots = {}
	for i = 1, 6 do
		local slot = create("Frame", { Size = UDim2.fromOffset(70, 54), BackgroundColor3 = T.card, LayoutOrder = i, Visible = i <= 4, Parent = slots }, { UI.corner(10) })
		local icon = label({ Text = "", TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 34), Parent = slot })
		local where = label({ Text = "", Font = F.bold, TextSize = 11, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 16), Parent = slot })
		refs.traySlots[i] = { frame = slot, icon = icon, where = where }
	end
	refs.tray = tray

	refs.hint = UI.scaled(create("Frame", {
		Name = "Dica",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -108),
		Size = UDim2.fromOffset(520, 34),
		BackgroundColor3 = T.panel,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = screen,
	}, { UI.corner("full"), UI.stroke(T.neon, 1.5, 0.2) }))
	refs.hintText = label({ Text = "", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = refs.hint })
end

local function updateCarry(state)
	local carry = state.carry
	refs.tray.Visible = #carry > 0 and not refs.buildMode
	refs.trayTitle.Text = "✋ BANDEJA  " .. #carry .. "/" .. state.carryLimit
	for i, slot in refs.traySlots do
		slot.frame.Visible = i <= state.carryLimit
		local entry = carry[i]
		slot.icon.Text = if entry then entry[1] else ""
		slot.where.Text = if entry then entry[2] else ""
		slot.frame.BackgroundColor3 = if entry then T.cardLight else T.card
	end
end

local function updateHint(state)
	local text = nil
	local waiting, pending, ready = nil, false, false
	for _, order in state.orders do
		if order.state == "waiting" and waiting == nil then
			waiting = order.label
		end
		for _, icon in order.icons do
			if icon[2] == "pending" then
				pending = true
			elseif icon[2] == "ready" then
				ready = true
			end
		end
	end
	local carrying = #state.carry > 0
	if carrying then
		text = "✋ Leve a bandeja até " .. state.carry[1][2] .. " e aperte E para entregar"
	elseif waiting then
		text = "❗ " .. waiting .. " está chamando: vá até lá e aperte E para anotar"
	elseif ready then
		text = "✅ Tem pedido pronto no balcão: aperte F para pegar"
	elseif pending then
		text = "🍺 Prepare os pedidos nas estações: chegue perto e segure E"
	elseif state.tableMoney > 0 then
		text = "💵 Tem dinheiro deixado nas mesas para você pegar"
	elseif state.dirtyTables > 0 then
		text = "🧽 Tem mesa suja: segure E perto dela para limpar"
	end
	local show = text ~= nil and state.level < 10 and not refs.buildMode
	refs.hint.Visible = show
	if show then
		refs.hintText.Text = text
	end
end

-- Menu lateral ---------------------------------------------------------------------------------

local function buildMenu()
	local menu = UI.scaled(create("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 30),
		Size = UDim2.fromOffset(78, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = screen,
	}))
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = menu
	refs.menu = menu
	refs.menuBadges = {}
	local entries = {
		{ id = "construir", icon = "🔨", text = "Construir", colors = { T.gold, T.orange } },
		{ id = "equipe", icon = "👥", text = "Equipe", colors = { T.blue, rgb(60, 70, 210) } },
		{ id = "cardapio", icon = "📋", text = "Cardápio", colors = { rgb(255, 92, 70), rgb(200, 30, 60) } },
		{ id = "avaliacoes", icon = "⭐", text = "Avaliações", colors = { rgb(255, 210, 60), rgb(230, 140, 20) } },
		{ id = "expandir", icon = "📐", text = "Expandir", colors = { T.green, T.greenDark } },
		{ id = "estilo", icon = "🎨", text = "Estilo", colors = { T.pink, T.neon } },
		{ id = "voltar", icon = "🏠", text = "Minha adega", colors = { T.cardLight, T.card } },
	}
	for index, entry in entries do
		local button = create("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(74, 70), BackgroundColor3 = T.panel, BackgroundTransparency = 0.05, LayoutOrder = index, Parent = menu }, {
			UI.corner(16),
			UI.stroke(entry.colors[1], 2, 0.35),
		})
		create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = rgb(255, 255, 255), Parent = button }, {
			UI.corner(12),
			UI.gradient(entry.colors[1], entry.colors[2], 135),
			label({ Text = entry.icon, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }),
		})
		label({ Text = entry.text, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 16), Parent = button })
		local badge = label({
			Text = "!",
			Font = F.black,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundColor3 = T.red,
			BackgroundTransparency = 0,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(20, 20),
			Visible = false,
			ZIndex = 3,
			Parent = button,
		})
		UI.corner("full").Parent = badge
		refs.menuBadges[entry.id] = badge
		local scale = create("UIScale", { Parent = button })
		button.MouseEnter:Connect(function()
			UI.tween(scale, 0.12, { Scale = 1.08 })
		end)
		button.MouseLeave:Connect(function()
			UI.tween(scale, 0.12, { Scale = 1 })
		end)
		button.Activated:Connect(function()
			UI.tween(scale, 0.08, { Scale = 0.92 })
			task.delay(0.08, function()
				UI.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
			end)
			App.openMenu(entry.id)
		end)
	end
end

-- Avisos, banner e resumo -----------------------------------------------------------------------------

local TOAST_STYLE = {
	compra = { icon = "✅", color = T.green },
	dinheiro = { icon = "💰", color = T.gold },
	nivel = { icon = "🎉", color = T.neon },
	erro = { icon = "⚠️", color = T.red },
	info = { icon = "💬", color = T.blue },
	missao = { icon = "🏅", color = T.gold },
}
local toastCount = 0

local function buildToasts()
	refs.toasts = UI.scaled(create("Frame", {
		Name = "Avisos",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 114),
		Size = UDim2.fromOffset(400, 300),
		BackgroundTransparency = 1,
		Parent = screen,
	}))
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = refs.toasts

	local overlay = UI.newScreen("AdegaDestaques", 20, true)
	refs.overlay = overlay
	local banner = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(640, 150), BackgroundTransparency = 1, Visible = false, Parent = overlay })
	refs.bannerScale = create("UIScale", { Parent = banner })
	refs.bannerTitle = label({ Text = "", Font = F.title, TextSize = 68, TextColor3 = rgb(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 84), Parent = banner })
	create("UIStroke", { Color = rgb(80, 20, 120), Thickness = 4, Parent = refs.bannerTitle })
	create("UIGradient", { Color = ColorSequence.new(T.gold, T.orange), Rotation = 90, Parent = refs.bannerTitle })
	refs.bannerSub = label({ Text = "", Font = F.bold, TextSize = 19, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 56), Parent = banner })
	create("UIStroke", { Color = rgb(30, 10, 50), Thickness = 2, Parent = refs.bannerSub })
	refs.banner = banner
end

function Hud.toast(text, kind)
	local style = TOAST_STYLE[kind] or TOAST_STYLE.info
	toastCount += 1
	local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(400, 54), LayoutOrder = toastCount, Parent = refs.toasts })
	local box = create("Frame", { Position = UDim2.fromOffset(0, -20), Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.panel, BackgroundTransparency = 1, Parent = holder }, {
		UI.corner(14),
		UI.stroke(style.color, 1.8, 0.15),
	})
	create("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(0, 5, 1, -16), BackgroundColor3 = style.color, BorderSizePixel = 0, Parent = box }, { UI.corner(3) })
	label({ Text = style.icon, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(34, 54), Parent = box })
	label({ Text = text, TextSize = 14, TextWrapped = true, Position = UDim2.fromOffset(54, 0), Size = UDim2.new(1, -64, 1, 0), Parent = box })
	UI.tween(box, 0.3, { Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 0.04 }, Enum.EasingStyle.Back)
	while #refs.toasts:GetChildren() > 6 do
		local oldest, oldestOrder = nil, math.huge
		for _, child in refs.toasts:GetChildren() do
			if child:IsA("Frame") and child.LayoutOrder < oldestOrder then
				oldest, oldestOrder = child, child.LayoutOrder
			end
		end
		if oldest == nil then
			break
		end
		oldest:Destroy()
	end
	task.delay(3.6, function()
		if holder.Parent then
			UI.tween(box, 0.25, { Position = UDim2.fromOffset(0, -12), BackgroundTransparency = 1 })
			for _, child in box:GetDescendants() do
				if child:IsA("TextLabel") then
					UI.tween(child, 0.25, { TextTransparency = 1 })
				elseif child:IsA("UIStroke") then
					UI.tween(child, 0.25, { Transparency = 1 })
				end
			end
			task.wait(0.27)
			holder:Destroy()
		end
	end)
end

function Hud.banner(title, subtitle)
	local banner = refs.banner
	refs.bannerTitle.Text = title
	refs.bannerSub.Text = subtitle or ""
	refs.bannerTitle.TextTransparency = 0
	refs.bannerSub.TextTransparency = 0
	banner.Visible = true
	refs.bannerScale.Scale = 0.3 * UI.currentScale()
	UI.tween(refs.bannerScale, 0.5, { Scale = UI.currentScale() }, Enum.EasingStyle.Back)
	local token = {}
	refs.bannerToken = token
	task.delay(3, function()
		if refs.bannerToken ~= token then
			return
		end
		UI.tween(refs.bannerTitle, 0.4, { TextTransparency = 1 })
		UI.tween(refs.bannerSub, 0.4, { TextTransparency = 1 })
		task.wait(0.4)
		if refs.bannerToken == token then
			banner.Visible = false
		end
	end)
end

function Hud.summary(data)
	local win = refs.summary
	if win == nil then
		win = UI.window("Fim de expediente", "Como foi o dia na sua adega", "🌅", UDim2.fromOffset(520, 360))
		local body = win.body
		UI.list(Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center).Parent = body
		local rows = {}
		for index, spec in { { "👥", "Clientes atendidos" }, { "💰", "Faturamento" }, { "⭐", "Nota média do dia" } } do
			local row = create("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.card, LayoutOrder = index, Parent = body }, { UI.corner(12) })
			label({ Text = spec[1], TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(56, 52), Parent = row })
			label({ Text = spec[2], Font = F.body, TextSize = 16, TextColor3 = T.muted, Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -200, 1, 0), Parent = row })
			rows[index] = label({ Text = "", Font = F.title, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -150, 0, 0), Size = UDim2.fromOffset(136, 52), Parent = row })
		end
		UI.button({ Style = "gold", Text = "Bora pra mais um dia!", Size = UDim2.fromOffset(260, 46), LayoutOrder = 5, Parent = body }, function()
			win.hide()
		end)
		win.rows = rows
		refs.summary = win
	end
	win.rows[1].Text = tostring(data.served or 0)
	win.rows[2].Text = App.Util.formatMoney(data.earned or 0)
	win.rows[3].Text = if data.rating then App.Util.formatDecimal(data.rating) .. " ★" else "—"
	win.show()
end

-- Atualização ------------------------------------------------------------------------------------

function Hud.update(state, previous)
	UI.tween(refs.shownCash, 0.45, { Value = state.cash })
	if previous and state.cash > previous.cash then
		refs.pendingGain = (refs.pendingGain or 0) + state.cash - previous.cash
	end
	refs.level.Text = tostring(state.level)
	local ratio = if state.level >= App.Config.MaxLevel then 1 else math.clamp(state.xp / state.xpNext, 0, 1)
	UI.tween(refs.xpFill, 0.3, { Size = UDim2.fromScale(ratio, 1) })
	refs.xpText.Text = if state.level >= App.Config.MaxLevel then "NÍVEL MÁXIMO" else App.Util.formatNumber(state.xp) .. " / " .. App.Util.formatNumber(state.xpNext) .. " XP"

	local quest = state.quest
	refs.quest.Visible = quest ~= nil
	if quest then
		refs.questTitle.Text = "MISSÃO " .. quest.index .. "/" .. quest.total
		refs.questText.Text = quest.text
		refs.questFill.Size = UDim2.fromScale(quest.progress / quest.target, 1)
		refs.questProgress.Text = quest.progress .. " / " .. quest.target
		refs.questReward.Text = "+" .. App.Util.formatMoney(quest.reward)
	end
	refs.orders.Position = UDim2.fromOffset(12, if quest then 190 else 96)

	refs.chipPeople.Text = "👥 " .. state.present .. " clientes"
	refs.chipFree.Text = "🍻 " .. state.freeTables .. " mesas livres"
	refs.chipDirty.Text = "🧽 " .. state.dirtyTables .. " sujas"
	refs.chipDirtyFrame.Visible = state.dirtyTables > 0
	refs.chipMoney.Text = "💵 " .. App.Util.formatMoney(state.tableMoney) .. " nas mesas"
	refs.chipMoneyFrame.Visible = state.tableMoney > 0

	refs.stars.Text = UI.stars(state.rating)
	refs.rating.Text = App.Util.formatDecimal(state.rating) .. " estrelas"

	updateOrders(state)
	updateCarry(state)
	updateHint(state)

	refs.menuBadges.equipe.Visible = #state.staff == 0 and state.cash >= 300
	local nextSize = App.Config.PlotSizes[state.sizeLevel + 1]
	refs.menuBadges.expandir.Visible = nextSize ~= nil and state.level >= nextSize.level and state.cash >= nextSize.price
end

function Hud.setBuildMode(on)
	refs.buildMode = on
	refs.menu.Visible = not on
	refs.orders.Visible = not on
	if App.state then
		updateCarry(App.state)
		updateHint(App.state)
	end
end

local function floatingGain(amount)
	local gain = label({
		Text = "+" .. App.Util.formatMoney(amount),
		Font = F.title,
		TextSize = 22,
		TextColor3 = T.green,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(200, 26),
		ZIndex = 5,
		Parent = refs.moneyCard,
	})
	local stroke = create("UIStroke", { Color = rgb(0, 60, 20), Thickness = 1.5, Parent = gain })
	UI.tween(gain, 1.1, { Position = UDim2.new(0.5, 0, 1, 34), TextTransparency = 1 })
	UI.tween(stroke, 1.1, { Transparency = 1 })
	task.delay(1.2, function()
		gain:Destroy()
	end)
end

function Hud.init(app)
	App = app
	screen = UI.newScreen("AdegaHUD", 1, false)
	buildProfile()
	buildMoney()
	buildClock()
	buildOrders()
	buildCarry()
	buildMenu()
	buildToasts()

	task.spawn(function()
		while true do
			task.wait(0.5)
			local hour = Lighting.ClockTime
			refs.clock.Text = App.Util.clockText(hour)
			if hour >= 18 or hour < 2 then
				refs.clockIcon.Text = "🌙"
				refs.period.Text = "Horário nobre • 50% mais clientes"
				refs.period.TextColor3 = T.gold
			elseif hour < 6 then
				refs.clockIcon.Text = "💤"
				refs.period.Text = "Madrugada • movimento fraco"
				refs.period.TextColor3 = T.muted
			else
				refs.clockIcon.Text = if hour < 17 then "☀️" else "🌅"
				refs.period.Text = "Movimento normal"
				refs.period.TextColor3 = T.muted
			end
			if refs.pendingGain and refs.pendingGain > 0 then
				floatingGain(refs.pendingGain)
				refs.pendingGain = 0
			end
		end
	end)
end

return Hud
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000010">
					<Properties>
						<string name="Name">Panels</string>
						<ProtectedString name="Source"><![CDATA[-- Panels: janelas de Equipe, Cardápio, Avaliações, Expandir e Estilo.

local UI = require(script.Parent.UI)

local Panels = {}

local T = UI.T
local F = UI.Fonts
local create = UI.create
local label = UI.label
local rgb = Color3.fromRGB

local App
local windows = {}

local function title(parent, text, order)
	return label({ Text = text, Font = F.black, TextSize = 13, TextColor3 = T.muted, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = order or 0, Parent = parent })
end

local function card(parent, height, order)
	return create("Frame", { Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = T.card, LayoutOrder = order or 0, Parent = parent }, {
		UI.corner(14),
		UI.stroke(T.line, 1.2, 0.5),
	})
end

local function iconCircle(parent, icon, colors, size, position)
	return create("Frame", { Position = position, Size = UDim2.fromOffset(size, size), BackgroundColor3 = rgb(255, 255, 255), Parent = parent }, {
		UI.corner(14),
		UI.gradient(colors[1], colors[2], 135),
		label({ Text = icon, TextSize = math.floor(size * 0.55), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }),
	})
end

local function clear(container)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Equipe ------------------------------------------------------------------------------------------

local ROLE_COLORS = {
	garcom = { rgb(245, 245, 245), rgb(160, 160, 170) },
	bartender = { rgb(255, 196, 40), rgb(220, 120, 20) },
	faxineiro = { rgb(60, 150, 220), rgb(40, 90, 170) },
	atendente = { rgb(255, 120, 80), rgb(210, 50, 60) },
	seguranca = { rgb(80, 80, 90), rgb(20, 20, 26) },
	dj = { rgb(190, 90, 255), rgb(120, 40, 200) },
}

local function buildStaff()
	local win = UI.window("Equipe", "Contrate gente para tocar a adega com você", "👥")
	local left = create("Frame", { Size = UDim2.new(0.48, -8, 1, 0), BackgroundTransparency = 1, Parent = win.body })
	local right = create("Frame", { Position = UDim2.new(0.48, 8, 0, 0), Size = UDim2.new(0.52, -8, 1, 0), BackgroundTransparency = 1, Parent = win.body })
	title(left, "CONTRATAR").Position = UDim2.new()
	win.teamTitle = title(right, "SUA EQUIPE")
	local hireList = UI.scroll(left, { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24) })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = hireList
	local teamList = UI.scroll(right, { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24) })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = teamList
	win.empty = label({ Text = "Ninguém contratado ainda. Comece por um garçom!", Font = F.body, TextSize = 14, TextColor3 = T.muted, TextWrapped = true, Size = UDim2.new(1, -8, 0, 40), Parent = teamList })

	win.hireButtons = {}
	for index, role in App.Config.Staff do
		local frame = card(hireList, 96, index)
		iconCircle(frame, role.icon, ROLE_COLORS[role.id], 56, UDim2.fromOffset(12, 20))
		label({ Text = role.name, TextSize = 17, Position = UDim2.fromOffset(80, 10), Size = UDim2.new(1, -230, 0, 22), Parent = frame })
		label({ Text = role.desc, Font = F.light, TextSize = 12, TextColor3 = T.muted, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.fromOffset(80, 34), Size = UDim2.new(1, -230, 0, 54), Parent = frame })
		local button = UI.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(136, 40), TextSize = 13, Parent = frame }, function()
			local status = win.hireStatus and win.hireStatus[role.id]
			if status == "ok" then
				App.invoke("contratar", { role = role.id })
			else
				UI.shake(frame)
			end
		end)
		win.hireButtons[role.id] = button
	end

	win.teamCards = {}
	function win.refresh(state)
		win.subtitle.Text = "Funcionários: " .. #state.staff .. " de " .. state.maxStaff .. " (o limite sobe com o nível)"
		win.teamTitle.Text = "SUA EQUIPE (" .. #state.staff .. "/" .. state.maxStaff .. ")"
		win.hireStatus = {}
		for _, role in App.Config.Staff do
			local button = win.hireButtons[role.id]
			local status
			if state.level < role.level then
				status = "level"
				button.Text = "🔒 Nível " .. role.level
				UI.setButtonStyle(button, "locked")
			elseif #state.staff >= state.maxStaff then
				status = "full"
				button.Text = "Limite atingido"
				UI.setButtonStyle(button, "locked")
			else
				status = if state.cash >= role.hire then "ok" else "money"
				button.Text = "Contratar " .. App.Util.formatMoney(role.hire)
				UI.setButtonStyle(button, if status == "ok" then "green" else "dark")
			end
			win.hireStatus[role.id] = status
		end

		win.empty.Visible = #state.staff == 0
		local seen = {}
		for index, member in state.staff do
			seen[member.id] = true
			local entry = win.teamCards[member.id]
			local role = App.Config.staffById(member.role)
			if entry == nil then
				local frame = card(teamList, 76, index)
				iconCircle(frame, role.icon, ROLE_COLORS[role.id], 48, UDim2.fromOffset(12, 14))
				local name = label({ Text = "", TextSize = 16, Position = UDim2.fromOffset(70, 12), Size = UDim2.new(1, -300, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
				local info = label({ Text = "", Font = F.body, TextSize = 12, TextColor3 = T.gold, RichText = true, Position = UDim2.fromOffset(70, 38), Size = UDim2.new(1, -300, 0, 20), Parent = frame })
				local train = UI.button({ Style = "blue", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -104, 0.5, 0), Size = UDim2.fromOffset(128, 38), TextSize = 12, Parent = frame })
				local fire = UI.button({ Style = "red", Text = "Demitir", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(84, 38), TextSize = 12, Parent = frame })
				entry = { frame = frame, name = name, info = info, train = train, fire = fire, confirm = false }
				train.Activated:Connect(function()
					if entry.canTrain then
						App.invoke("treinar", { id = member.id })
					else
						UI.shake(frame)
					end
				end)
				fire.Activated:Connect(function()
					if entry.confirm then
						App.invoke("demitir", { id = member.id })
					else
						entry.confirm = true
						fire.Text = "Certeza?"
						task.delay(2.5, function()
							entry.confirm = false
							if fire.Parent then
								fire.Text = "Demitir"
							end
						end)
					end
				end)
				win.teamCards[member.id] = entry
			end
			entry.frame.LayoutOrder = index
			entry.name.Text = member.name .. "  •  " .. role.name
			entry.info.Text = UI.stars(member.level) .. '  <font color="#B0A6CC">velocidade ' .. App.Util.formatDecimal(App.Config.staffSpeed(member.level)) .. "x</font>"
			if member.train then
				entry.train.Text = "Treinar " .. App.Util.formatMoney(member.train)
				entry.canTrain = state.cash >= member.train
				UI.setButtonStyle(entry.train, if entry.canTrain then "blue" else "dark")
			else
				entry.train.Text = "Nível máximo"
				entry.canTrain = false
				UI.setButtonStyle(entry.train, "locked")
			end
		end
		for id, entry in win.teamCards do
			if not seen[id] then
				entry.frame:Destroy()
				win.teamCards[id] = nil
			end
		end
	end
	return win
end

-- Cardápio ------------------------------------------------------------------------------------------

local function buildMenu()
	local win = UI.window("Cardápio", "Cada estação do modo construção libera produtos novos", "📋")
	local grid = UI.scroll(win.body, { Size = UDim2.fromScale(1, 1) })
	create("UIGridLayout", { CellSize = UDim2.fromOffset(198, 188), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	UI.pad(2, 2, 12, 2).Parent = grid
	win.cards = {}
	for index, product in App.Config.Products do
		local frame = create("Frame", { BackgroundColor3 = T.card, LayoutOrder = index, Parent = grid }, { UI.corner(16), UI.stroke(T.line, 1.2, 0.5) })
		local top = create("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 70), BackgroundColor3 = rgb(255, 255, 255), Parent = frame }, {
			UI.corner(12),
			UI.gradient(rgb(255, 120, 70), rgb(190, 30, 70), 135),
		})
		local icon = label({ Text = product.icon, TextSize = 40, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = top })
		label({ Text = product.name, TextSize = 14, TextWrapped = true, Position = UDim2.fromOffset(12, 82), Size = UDim2.new(1, -24, 0, 34), TextYAlignment = Enum.TextYAlignment.Top, Parent = frame })
		label({ Text = App.Util.formatMoney(product.price) .. "   ⏱ " .. App.Util.formatDecimal(product.prep) .. " s", Font = F.title, TextSize = 15, TextColor3 = T.gold, Position = UDim2.fromOffset(12, 116), Size = UDim2.new(1, -24, 0, 20), Parent = frame })
		local station = App.Catalog.ById[product.station]
		local status = label({ Text = "", Font = F.bold, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, BackgroundTransparency = 0, BackgroundColor3 = T.locked, Position = UDim2.fromOffset(10, 142), Size = UDim2.new(1, -20, 0, 36), Parent = frame })
		UI.corner(10).Parent = status
		win.cards[product.id] = { frame = frame, top = top, icon = icon, status = status, station = station, product = product }
	end
	function win.refresh(state)
		local onMenu = {}
		for _, id in state.menu do
			onMenu[id] = true
		end
		for _, entry in win.cards do
			local product = entry.product
			if onMenu[product.id] then
				entry.status.Text = "✅ No cardápio"
				entry.status.BackgroundColor3 = T.greenDark
				entry.status.TextColor3 = rgb(255, 255, 255)
				entry.icon.TextTransparency = 0
			elseif state.level < product.level then
				entry.status.Text = "🔒 Libera no nível " .. product.level
				entry.status.BackgroundColor3 = T.locked
				entry.status.TextColor3 = T.muted
				entry.icon.TextTransparency = 0.5
			else
				entry.status.Text = "🔨 Coloque: " .. entry.station.name
				entry.status.BackgroundColor3 = rgb(110, 70, 20)
				entry.status.TextColor3 = T.gold
				entry.icon.TextTransparency = 0.2
			end
		end
	end
	return win
end

-- Avaliações ---------------------------------------------------------------------------------------

local function buildReviews()
	local win = UI.window("Avaliações", "O que os clientes estão achando da sua adega", "⭐")
	local left = UI.panel({ Size = UDim2.new(0, 290, 1, 0), Parent = win.body })
	UI.pad(16).Parent = left
	UI.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = left
	win.big = label({ Text = "3,0", Font = F.title, TextSize = 64, TextColor3 = T.gold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 70), LayoutOrder = 1, Parent = left })
	win.stars = label({ Text = "", Font = F.black, TextSize = 26, TextColor3 = T.gold, RichText = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2, Parent = left })
	win.count = label({ Text = "", Font = F.body, TextSize = 12, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 3, Parent = left })
	win.rows = {}
	for index, spec in { { "👥", "Atendidos hoje" }, { "💰", "Faturado hoje" }, { "🏆", "Total atendidos" }, { "✨", "Ambiente" }, { "🚶", "Grupos por minuto" } } do
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.card, LayoutOrder = 10 + index, Parent = left }, { UI.corner(9) })
		label({ Text = spec[1], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(32, 32), Parent = row })
		label({ Text = spec[2], Font = F.body, TextSize = 13, TextColor3 = T.muted, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -40, 1, 0), Parent = row })
		win.rows[index] = label({ Text = "", Font = F.title, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(1, -10, 1, 0), Parent = row })
	end
	label({ Text = "Atendimento rápido, ambiente bonito (decoração) e seguranças deixam os clientes mais felizes. Mais estrelas trazem mais gente e mais gorjeta.", Font = F.light, TextSize = 11, TextColor3 = T.muted, TextWrapped = true, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 30, Parent = left })

	local list = UI.scroll(win.body, { Position = UDim2.fromOffset(306, 0), Size = UDim2.new(1, -306, 1, 0) })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = list
	win.list = list
	function win.refresh(state)
		win.big.Text = App.Util.formatDecimal(state.rating)
		win.stars.Text = UI.stars(state.rating)
		win.count.Text = "Média das últimas " .. state.ratingCount .. " avaliações"
		win.rows[1].Text = tostring(state.day.served)
		win.rows[2].Text = App.Util.formatMoney(state.day.earned)
		win.rows[3].Text = App.Util.formatNumber(state.totalServed)
		win.rows[4].Text = tostring(state.appeal)
		win.rows[5].Text = App.Util.formatDecimal(state.groupsPerMinute)
		local first = state.reviews[1]
		local signature = #state.reviews .. ":" .. (if first then first.name .. first.text .. state.ratingCount else "")
		if signature == win.signature then
			return
		end
		win.signature = signature
		clear(list)
		if #state.reviews == 0 then
			label({ Text = "Ainda sem avaliações. Atenda os primeiros clientes!", Font = F.body, TextSize = 14, TextColor3 = T.muted, Size = UDim2.new(1, -8, 0, 40), Parent = list })
		end
		for index, review in state.reviews do
			local frame = card(list, 74, index)
			label({ Text = review.name, TextSize = 15, Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -150, 0, 20), Parent = frame })
			label({ Text = UI.stars(review.stars), Font = F.black, TextSize = 16, TextColor3 = T.gold, RichText = true, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -134, 0, 10), Size = UDim2.fromOffset(120, 20), Parent = frame })
			label({ Text = "“" .. review.text .. "”", Font = F.body, TextSize = 13, TextColor3 = T.muted, TextWrapped = true, Position = UDim2.fromOffset(14, 34), Size = UDim2.new(1, -28, 0, 32), Parent = frame })
		end
	end
	return win
end

-- Expandir -------------------------------------------------------------------------------------------

local function buildExpand()
	local win = UI.window("Expandir terreno", "Mais espaço para mesas, estações e decoração", "📐", UDim2.fromOffset(760, 520))
	local preview = create("Frame", { Size = UDim2.fromOffset(300, 300), BackgroundColor3 = rgb(70, 110, 60), Parent = win.body }, { UI.corner(16) })
	win.squares = {}
	local maxSize = App.Config.PlotSizes[#App.Config.PlotSizes].size
	for index = #App.Config.PlotSizes, 1, -1 do
		local tier = App.Config.PlotSizes[index]
		local side = 280 * tier.size / maxSize
		local square = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.fromOffset(side, side),
			BackgroundColor3 = rgb(150, 150, 152),
			BackgroundTransparency = 0.7,
			ZIndex = 10 - index,
			Parent = preview,
		}, { UI.stroke(rgb(255, 255, 255), 2, 0.4), UI.corner(6) })
		win.squares[index] = square
	end
	label({ Text = "A frente fica na calçada; a adega cresce para os lados e para o fundo.", Font = F.light, TextSize = 12, TextColor3 = T.muted, TextWrapped = true, Position = UDim2.fromOffset(0, 310), Size = UDim2.fromOffset(300, 40), Parent = win.body })
	local list = create("Frame", { Position = UDim2.fromOffset(320, 0), Size = UDim2.new(1, -320, 1, 0), BackgroundTransparency = 1, Parent = win.body })
	UI.list(Enum.FillDirection.Vertical, 8).Parent = list
	win.rowsList = {}
	for index, tier in App.Config.PlotSizes do
		local frame = card(list, 62, index)
		label({ Text = tier.size .. " x " .. tier.size, Font = F.title, TextSize = 22, Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(120, 62), Parent = frame })
		local info = label({ Text = "", Font = F.body, TextSize = 12, TextColor3 = T.muted, Position = UDim2.fromOffset(130, 0), Size = UDim2.new(1, -290, 1, 0), Parent = frame })
		local button = UI.button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(150, 40), TextSize = 13, Parent = frame }, function()
			if win.canBuy == index then
				App.invoke("expandir", {})
			else
				UI.shake(frame)
			end
		end)
		win.rowsList[index] = { frame = frame, info = info, button = button }
	end
	function win.refresh(state)
		win.canBuy = nil
		for index, row in win.rowsList do
			local tier = App.Config.PlotSizes[index]
			win.squares[index].BackgroundTransparency = if index <= state.sizeLevel then 0.15 else 0.75
			win.squares[index].BackgroundColor3 = if index == state.sizeLevel then T.gold elseif index < state.sizeLevel then rgb(150, 150, 152) else rgb(110, 140, 100)
			if index <= state.sizeLevel then
				row.info.Text = if index == state.sizeLevel then "Seu tamanho atual" else "Já comprado"
				row.button.Text = "✓"
				UI.setButtonStyle(row.button, "dark")
			elseif index == state.sizeLevel + 1 then
				row.info.Text = "Libera no nível " .. tier.level
				if state.level < tier.level then
					row.button.Text = "🔒 Nível " .. tier.level
					UI.setButtonStyle(row.button, "locked")
				else
					row.button.Text = App.Util.formatMoney(tier.price)
					UI.setButtonStyle(row.button, if state.cash >= tier.price then "green" else "dark")
					if state.cash >= tier.price then
						win.canBuy = index
					end
				end
			else
				row.info.Text = "Nível " .. tier.level .. " • " .. App.Util.formatMoney(tier.price)
				row.button.Text = "🔒"
				UI.setButtonStyle(row.button, "locked")
			end
		end
	end
	return win
end

-- Estilo ------------------------------------------------------------------------------------------

local function buildStyle()
	local win = UI.window("Estilo", "Piso da adega e cor das paredes rebocadas", "🎨")
	local scroll = UI.scroll(win.body, { Size = UDim2.fromScale(1, 1) })
	UI.list(Enum.FillDirection.Vertical, 10).Parent = scroll
	win.entries = {}
	local function section(order, text, kind, list)
		title(scroll, text, order)
		local grid = create("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order + 1, Parent = scroll })
		create("UIGridLayout", { CellSize = UDim2.fromOffset(196, 128), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
		for index, option in list do
			local frame = create("Frame", { BackgroundColor3 = T.card, LayoutOrder = index, Parent = grid }, { UI.corner(14), UI.stroke(T.line, 1.5, 0.5) })
			create("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 50), BackgroundColor3 = option.color, Parent = frame }, { UI.corner(10), UI.stroke(rgb(0, 0, 0), 1, 0.7) })
			label({ Text = option.name, TextSize = 14, Position = UDim2.fromOffset(12, 64), Size = UDim2.new(1, -24, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
			local button = UI.button({ Position = UDim2.fromOffset(10, 86), Size = UDim2.new(1, -20, 0, 32), TextSize = 12, Parent = frame }, function()
				App.invoke("estilo", { kind = kind, id = option.id })
			end)
			table.insert(win.entries, { kind = kind, option = option, frame = frame, button = button })
		end
	end
	section(1, "PISO", "floor", App.Config.Floors)
	section(10, "PAREDES", "wall", App.Config.WallColors)
	function win.refresh(state)
		for _, entry in win.entries do
			local owned = if entry.kind == "floor" then state.ownedFloors else state.ownedWalls
			local active = if entry.kind == "floor" then state.style.floor else state.style.wall
			local id = entry.option.id
			if active == id then
				entry.button.Text = "✓ Em uso"
				UI.setButtonStyle(entry.button, "gold")
				entry.frame.UIStroke.Color = T.gold
				entry.frame.UIStroke.Transparency = 0
			else
				entry.frame.UIStroke.Color = T.line
				entry.frame.UIStroke.Transparency = 0.5
				if owned[id] then
					entry.button.Text = "Usar"
					UI.setButtonStyle(entry.button, "blue")
				else
					entry.button.Text = App.Util.formatMoney(entry.option.price)
					UI.setButtonStyle(entry.button, if state.cash >= entry.option.price then "green" else "dark")
				end
			end
		end
	end
	return win
end

local BUILDERS = {
	equipe = buildStaff,
	cardapio = buildMenu,
	avaliacoes = buildReviews,
	expandir = buildExpand,
	estilo = buildStyle,
}

function Panels.open(name)
	local win = windows[name]
	if win == nil then
		local builder = BUILDERS[name]
		if builder == nil then
			return
		end
		win = builder()
		windows[name] = win
	end
	if win.open then
		win.hide()
		return
	end
	if App.state then
		win.refresh(App.state)
	end
	win.show()
end

function Panels.update(state)
	for _, win in windows do
		if win.open then
			win.refresh(state)
		end
	end
end

function Panels.init(app)
	App = app
end

return Panels
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000011">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[-- UI: tema e componentes da interface (painéis, botões, janelas, barras e animações).

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local UI = {}

local rgb = Color3.fromRGB

UI.T = {
	bg = rgb(16, 12, 26),
	panel = rgb(28, 22, 44),
	card = rgb(40, 32, 62),
	cardLight = rgb(56, 46, 86),
	line = rgb(98, 76, 152),
	text = rgb(248, 244, 255),
	muted = rgb(176, 166, 204),
	gold = rgb(255, 196, 40),
	orange = rgb(255, 128, 40),
	neon = rgb(178, 84, 255),
	pink = rgb(255, 80, 170),
	green = rgb(56, 210, 116),
	greenDark = rgb(26, 140, 76),
	red = rgb(236, 72, 88),
	blue = rgb(70, 150, 255),
	cyan = rgb(60, 210, 230),
	locked = rgb(70, 64, 92),
}
local T = UI.T

UI.Fonts = {
	title = Enum.Font.FredokaOne,
	bold = Enum.Font.GothamBold,
	black = Enum.Font.GothamBlack,
	body = Enum.Font.GothamMedium,
	light = Enum.Font.Gotham,
}

function UI.create(className, props, children)
	local instance = Instance.new(className)
	local parent = props.Parent
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end
local create = UI.create

function UI.corner(radius)
	return create("UICorner", { CornerRadius = if radius == "full" then UDim.new(1, 0) else UDim.new(0, radius or 12) })
end

function UI.stroke(color, thickness, transparency)
	return create("UIStroke", {
		Color = color or T.line,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.gradient(a, b, rotation)
	return create("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rotation or 90 })
end

function UI.pad(top, right, bottom, left)
	right = right or top
	bottom = bottom or top
	left = left or right
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
	})
end

function UI.list(direction, padding, align)
	return create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function UI.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = UI.Fonts.bold,
		TextColor3 = T.text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	for key, value in props do
		defaults[key] = value
	end
	return create("TextLabel", defaults)
end

function UI.tween(instance, time, props, style, direction)
	local tween = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

function UI.panel(props)
	local frame = create("Frame", {
		BackgroundColor3 = T.panel,
		BackgroundTransparency = 0.06,
		BorderSizePixel = 0,
	})
	for key, value in props do
		frame[key] = value
	end
	UI.corner(16).Parent = frame
	UI.stroke(T.line, 1.5, 0.35).Parent = frame
	UI.gradient(rgb(255, 255, 255), rgb(208, 198, 232)).Parent = frame
	return frame
end

-- Botão com hover e clique animados. style: "green", "gold", "red", "dark", "neon", "blue"
local BUTTON_STYLES = {
	green = { T.green, T.greenDark, rgb(255, 255, 255) },
	gold = { T.gold, T.orange, rgb(60, 25, 0) },
	red = { T.red, rgb(170, 40, 60), rgb(255, 255, 255) },
	dark = { T.cardLight, T.card, T.text },
	neon = { T.neon, rgb(110, 40, 200), rgb(255, 255, 255) },
	blue = { T.blue, rgb(40, 90, 200), rgb(255, 255, 255) },
	locked = { T.locked, rgb(50, 46, 66), T.muted },
}

function UI.button(props, onClick)
	local style = props.Style or "green"
	props.Style = nil
	local colors = BUTTON_STYLES[style]
	local button = create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = rgb(255, 255, 255),
		Font = UI.Fonts.black,
		TextSize = 15,
		TextColor3 = colors[3],
		Text = "",
		BorderSizePixel = 0,
	})
	for key, value in props do
		button[key] = value
	end
	UI.corner(12).Parent = button
	local grad = UI.gradient(colors[1], colors[2])
	grad.Name = "Cor"
	grad.Parent = button
	local scale = create("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.08, { Scale = 0.93 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function UI.setButtonStyle(button, style)
	local colors = BUTTON_STYLES[style]
	local grad = button:FindFirstChild("Cor")
	if grad then
		grad.Color = ColorSequence.new(colors[1], colors[2])
	end
	button.TextColor3 = colors[3]
end

function UI.shake(frame)
	task.spawn(function()
		local origin = frame.Position
		for _, dx in { -8, 8, -5, 5, -2, 0 } do
			frame.Position = origin + UDim2.fromOffset(dx, 0)
			task.wait(0.035)
		end
		frame.Position = origin
	end)
end

function UI.bar(parent, props)
	local track = create("Frame", {
		BackgroundColor3 = T.bg,
		BorderSizePixel = 0,
		Parent = parent,
	}, { UI.corner("full") })
	for key, value in props do
		if key ~= "ColorA" and key ~= "ColorB" then
			track[key] = value
		end
	end
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = rgb(255, 255, 255), BorderSizePixel = 0, Parent = track }, {
		UI.corner("full"),
		UI.gradient(props.ColorA or T.neon, props.ColorB or T.pink, 0),
	})
	return track, fill
end

function UI.stars(rating)
	local full = math.floor(rating)
	local half = rating - full >= 0.5
	local text = string.rep("★", full)
	local shown = full
	if half and full < 5 then
		text ..= '<font transparency="0.35">★</font>'
		shown += 1
	end
	if shown < 5 then
		text ..= '<font transparency="0.8">' .. string.rep("★", 5 - shown) .. "</font>"
	end
	return text
end

-- Escala ------------------------------------------------------------------------------------------

local scalers = {}

function UI.currentScale()
	local camera = workspace.CurrentCamera
	if camera == nil then
		return 1
	end
	local viewport = camera.ViewportSize
	return math.clamp(math.min(viewport.X / 1366, viewport.Y / 768), 0.48, 1.2)
end

function UI.scaled(frame)
	local scaler = create("UIScale", { Scale = UI.currentScale(), Parent = frame })
	table.insert(scalers, scaler)
	return frame, scaler
end

function UI.applyScale()
	local value = UI.currentScale()
	for _, scaler in scalers do
		if scaler.Parent and not scaler:GetAttribute("Animating") then
			scaler.Scale = value
		end
	end
end

function UI.isTouch()
	local input = game:GetService("UserInputService")
	return input.TouchEnabled and not input.KeyboardEnabled
end

-- Janelas modais ----------------------------------------------------------------------------------

function UI.newScreen(name, order, ignoreInset)
	return create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = ignoreInset == true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 0,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
end

local modalScreen = nil
local openWindow = nil

function UI.window(title, subtitle, icon, size)
	if modalScreen == nil then
		modalScreen = UI.newScreen("AdegaJanelas", 10, true)
	end
	local dim = create("TextButton", {
		Name = title,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = rgb(5, 2, 12),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = modalScreen,
	})
	local frame = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size or UDim2.fromOffset(880, 560),
		BackgroundColor3 = T.bg,
		Active = true,
		Parent = dim,
	}, { UI.corner(22), UI.stroke(T.neon, 2, 0.2) })
	local scale = create("UIScale", { Parent = frame })
	local header = create("Frame", { Size = UDim2.new(1, 0, 0, 76), BackgroundColor3 = rgb(255, 255, 255), BorderSizePixel = 0, Parent = frame }, {
		UI.corner(22),
		UI.gradient(rgb(140, 30, 70), rgb(90, 40, 180), 0),
	})
	create("Frame", { Position = UDim2.new(0, 0, 1, -22), Size = UDim2.new(1, 0, 0, 22), BackgroundColor3 = rgb(255, 255, 255), BorderSizePixel = 0, Parent = header }, {
		UI.gradient(rgb(140, 30, 70), rgb(90, 40, 180), 0),
	})
	UI.label({ Text = icon .. "  " .. title, Font = UI.Fonts.title, TextSize = 30, Position = UDim2.fromOffset(24, 8), Size = UDim2.new(1, -140, 0, 38), Parent = header })
	local sub = UI.label({ Text = subtitle or "", Font = UI.Fonts.body, TextSize = 14, TextColor3 = rgb(235, 220, 255), Position = UDim2.fromOffset(26, 44), Size = UDim2.new(1, -140, 0, 20), Parent = header })
	local close = UI.button({
		Style = "red",
		Text = "✕",
		TextSize = 20,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 17),
		Size = UDim2.fromOffset(42, 42),
		Parent = header,
	})
	close.UICorner.CornerRadius = UDim.new(1, 0)
	local body = create("Frame", { Position = UDim2.fromOffset(18, 92), Size = UDim2.new(1, -36, 1, -108), BackgroundTransparency = 1, Parent = frame })

	local win: { [string]: any } = { dim = dim, frame = frame, body = body, subtitle = sub, open = false }
	function win.show()
		if openWindow and openWindow ~= win then
			openWindow.hide()
		end
		openWindow = win
		win.open = true
		dim.Visible = true
		scale.Scale = UI.currentScale() * 0.85
		UI.tween(dim, 0.2, { BackgroundTransparency = 0.45 })
		UI.tween(scale, 0.32, { Scale = UI.currentScale() }, Enum.EasingStyle.Back)
		if win.onShow then
			win.onShow()
		end
	end
	function win.hide()
		if not win.open then
			return
		end
		win.open = false
		if openWindow == win then
			openWindow = nil
		end
		UI.tween(dim, 0.18, { BackgroundTransparency = 1 })
		UI.tween(scale, 0.18, { Scale = UI.currentScale() * 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.18, function()
			if not win.open then
				dim.Visible = false
			end
		end)
	end
	function win.toggle()
		if win.open then
			win.hide()
		else
			win.show()
		end
	end
	close.Activated:Connect(win.hide)
	dim.Activated:Connect(win.hide)
	return win
end

function UI.closeWindows()
	if openWindow then
		openWindow.hide()
	end
end

function UI.scroll(parent, props)
	local frame = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.neon,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	for key, value in props do
		frame[key] = value
	end
	return frame
end

return UI
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
